}
/* 面板默认贴在桌宠左侧；放不下就换到右侧，并夹在工作区内。 */
function bankPanelBounds(pet, panelWidth, panelHeight, gap) {
  var left = pet.x - panelWidth - gap;
  var top = pet.y + pet.height - panelHeight;
  if (left < pet.workLeft) {
    var right = pet.x + pet.width + gap;
    left = right + panelWidth <= pet.workRight ? right : pet.workLeft;
  }
  if (left + panelWidth > pet.workRight) left = pet.workRight - panelWidth;
  if (left < pet.workLeft) left = pet.workLeft;
  if (top + panelHeight > pet.workBottom) top = pet.workBottom - panelHeight;
  if (top < pet.workTop) top = pet.workTop;
