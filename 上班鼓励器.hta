<script type="text/javascript">
/* 本地数据与输入状态；不会记录具体按键、鼠标位置或操作内容。 */
var DATA_FILE = "workbank.json", BACKUP_FILE = "workbank.json.bak", TEMP_FILE = "workbank.json.tmp";
var IDLE_LIMIT = 120000, MAX_TICK_GAP = 2500, SAMPLE_MAX_AGE = 3500;
var FIGHT_OVERTIME_SECONDS = 2 * 3600;
var bank = { version: 1, settings: null, days: {} };
var masked = true, tracking = false, signedOff = false, fatalStorage = false;
var mainValid = false, storageProblem = "", recovered = false, dirty = false;
var lastTick = 0, previousInput = null, lastHeartbeat = 0, lastSave = 0;
var monitorStarted = 0, monitorReady = false, monitorIdle = false;
var alivePath = "", samplePath = "", lastHour = "", toastTimer = null, autoMaskTimer = null;
var restReminderActiveSeconds = 0, restReminderPending = false, restReminderSnoozeSeconds = 0;
var sessionLocked = false, sessionMonitorReady = false, sessionMonitorFailed = false;
var lockPausedTracking = false, startWhenSessionReady = false;
var exportDialogPath = "", exportDialogKind = "", exportDialogStarted = 0, exportDialogTimer = null, exportDialogProcess = null;
var pinned = false, pinPending = false, pinDesired = false, pinRemember = false;
var pinStarted = 0, pinResultPath = "", pinPreviousTitle = "", pinTimer = null;
var petStarting = false, petRunning = false, petStarted = 0, petLastHeartbeat = 0, petLastState = "";
var petAlivePath = "", petStatePath = "", petBeatPath = "", petReadyPath = "", petControlPath = "", petNoticePath = "", petEventsPath = "", petPosPath = "";
var petPreviousTitle = "", petTargetTitle = "", petPanelVisible = true, petParentHandle = "";
var petTopMost = true, petPositionX = null, petPositionY = null, petBounds = null, panelAnchor = null;
var celebrateUntil = 0, milestoneDay = "", milestoneStage = 0;
var receiptDayAmount = 0, receiptMonthAmount = 0;
var theme = "deep", pendingTheme = "deep", historySelectedMonth = "";
var draftDayOverrides = {}, settingsMonthKey = "", settingsNextMonthKey = "";
/* 三款主题分别记忆窗口透明度（60–100%）；玻璃默认 82%，其余默认不透明。 */
var THEME_DEFAULT_ALPHA = { deep: 100, cream: 100, glass: 82 };
var savedThemeAlpha = { deep: 100, cream: 100, glass: 82 };
var draftThemeAlpha = { deep: 100, cream: 100, glass: 82 };
var activeAlpha = 100, pendingAlpha = 100, settingsEditing = false;
var PANEL_WIDTH = 530, PANEL_HEIGHT = 720, PANEL_GAP = 12;

function $id(id) { return document.getElementById(id); }
function text(id, value) { $id(id).innerText = value; }
function pad(n) { return (n < 10 ? "0" : "") + n; }
function money(n, precision) { return masked ? "¥ ****" : "¥ " + Math.max(0, n).toFixed(precision === 4 ? 4 : 2); }
function duration(seconds) {
  seconds = Math.floor(Math.max(0, seconds));
  return pad(Math.floor(seconds / 3600)) + ":" + pad(Math.floor(seconds % 3600 / 60)) + ":" + pad(seconds % 60);
}
function applyTheme() {
  var classes = "theme-" + theme;
  if (bank.settings && bank.settings.motion === false) classes += " motion-off";
  document.body.className = classes;
}
function normalizeTheme(value) {
  return value === "cream" || value === "glass" ? value : "deep";
}
function clampAlpha(value, fallback) {
  if (value === null || typeof value === "undefined" || value === "") return fallback;
  var n = Number(value);
  if (!isFinite(n)) return fallback;
  n = Math.round(n);
  return n < 60 ? 60 : (n > 100 ? 100 : n);
}
function bankThemeAlpha(settings) {
  var stored = settings && settings.themeAlpha && typeof settings.themeAlpha === "object" ? settings.themeAlpha : {};
  return {
    deep: clampAlpha(stored.deep, THEME_DEFAULT_ALPHA.deep),
    cream: clampAlpha(stored.cream, THEME_DEFAULT_ALPHA.cream),
    glass: clampAlpha(stored.glass, THEME_DEFAULT_ALPHA.glass)
  };
}
function copyThemeAlpha(source) {
  return {
    deep: clampAlpha(source.deep, THEME_DEFAULT_ALPHA.deep),
    cream: clampAlpha(source.cream, THEME_DEFAULT_ALPHA.cream),
    glass: clampAlpha(source.glass, THEME_DEFAULT_ALPHA.glass)
  };
}
/* 分层窗口使用 0–255 的 alpha；100% 时完全移除透明层。 */
function alphaByte(pct) {
  pct = clampAlpha(pct, 100);
  return pct >= 100 ? 255 : Math.round(pct * 255 / 100);
}
function syncOpacityControl() {
  var input = $id("inOpacity");
  if (!input) return;
  pendingAlpha = clampAlpha(pendingAlpha, THEME_DEFAULT_ALPHA[pendingTheme]);
  input.value = String(pendingAlpha);
  text("opacityValue", pendingAlpha + "%");
}
function setTheme(value, remember) {
  theme = normalizeTheme(value);
  pendingTheme = theme;
  activeAlpha = (settingsEditing ? draftThemeAlpha : savedThemeAlpha)[theme];
  pendingAlpha = activeAlpha;
  syncThemeMenu();
  applyTheme();
  applyWindowChrome();
  if (settingsEditing) syncOpacityControl();
  if (remember && bank.settings) {
    bank.settings.theme = theme;
    dirty = true;
    if (!saveBank()) showToast("主题已切换，但偏好保存失败；请检查目录权限。");
  }
}
/* 顶栏「换肤」改为弹出菜单，三款主题都能一次点击直达。 */
function syncThemeMenu() {
  var items = { deep: "themePickDeep", cream: "themePickCream", glass: "themePickGlass" };
  for (var key in items) {
    if (!Object.prototype.hasOwnProperty.call(items, key)) continue;
    var item = $id(items[key]);
    item.className = "theme-item" + (theme === key ? " on" : "");
    item.setAttribute("aria-checked", theme === key ? "true" : "false");
  }
}
function showThemeMenu(show) {
  $id("themeMenu").className = "theme-menu" + (show ? "" : " hidden");
  $id("btnTheme").setAttribute("aria-expanded", show ? "true" : "false");
  if (show) syncThemeMenu();
}
function pickTheme(value) {
  setTheme(value, true);
  showThemeMenu(false);
}
function previewOpacity(value) {
  if (!settingsEditing) return;
  pendingAlpha = clampAlpha(value, THEME_DEFAULT_ALPHA[pendingTheme]);
  draftThemeAlpha[pendingTheme] = pendingAlpha;
  theme = pendingTheme;
  activeAlpha = pendingAlpha;
  syncOpacityControl();
  applyWindowChrome();
}
/* 标题栏着色和玻璃主题由独立辅助进程设置到当前 HTA 窗口。 */
var chromeTimer = null, chromeGatePath = "", chromeBasePath = "", chromeRevision = 0;
var CHROME_COLORS = {
  deep: { caption: "#0a1424", text: "#e7f1ff", border: "#2b4a6e", dark: 1 },
  cream: { caption: "#f2ebdd", text: "#3b3a33", border: "#d9c9a8", dark: 0 },
  glass: { caption: "#18303b", text: "#eaf9ff", border: "#85b5bb", dark: 1 }
};
function chromeColor(hex) {
  var r = parseInt(hex.substr(1, 2), 16), g = parseInt(hex.substr(3, 2), 16), b = parseInt(hex.substr(5, 2), 16);
  return r | (g << 8) | (b << 16);
}
function chromeCommand(title, handle, colors, alphaPct, gatePath, resultPath, revision) {
  var nativeCode = "using System;using System.IO;using System.Runtime.InteropServices;" +
    "public static class WorkBankChrome {const int L=0x80000;const string P=@WorkBankGlassLayer@;" +
    "[DllImport(@dwmapi.dll@)]static extern int DwmSetWindowAttribute(IntPtr h,int a,ref int v,int s);" +
    "[DllImport(@user32.dll@,CharSet=CharSet.Unicode)]static extern IntPtr FindWindow(string c,string t);" +
    "[DllImport(@user32.dll@)]static extern bool IsWindow(IntPtr h);" +
    "[DllImport(@user32.dll@,EntryPoint=@GetWindowLongW@)]static extern int GetWindowLong(IntPtr h,int i);" +
    "[DllImport(@user32.dll@,EntryPoint=@SetWindowLongW@)]static extern int SetWindowLong(IntPtr h,int i,int v);" +
    "[DllImport(@user32.dll@)]static extern bool SetLayeredWindowAttributes(IntPtr h,int key,byte alpha,uint flags);" +
    "[DllImport(@user32.dll@,CharSet=CharSet.Unicode)]static extern IntPtr GetProp(IntPtr h,string p);" +
    "[DllImport(@user32.dll@,CharSet=CharSet.Unicode)]static extern bool SetProp(IntPtr h,string p,IntPtr v);" +
    "[DllImport(@user32.dll@,CharSet=CharSet.Unicode)]static extern IntPtr RemoveProp(IntPtr h,string p);" +
    "[DllImport(@user32.dll@)]static extern bool RedrawWindow(IntPtr h,IntPtr r,IntPtr g,uint flags);" +
    "public static int Apply(string title,string handle,int caption,int text,int border,int dark,int alpha,string gate,string rev){" +
    "if(!File.Exists(gate)||File.ReadAllText(gate).Trim()!=rev)return 2;" +
    "long n;IntPtr h=Int64.TryParse(handle,out n)?new IntPtr(n):IntPtr.Zero;" +
    "if(h==IntPtr.Zero||!IsWindow(h))h=FindWindow(null,title);" +
    "for(int i=0;i<30&&(h==IntPtr.Zero||!IsWindow(h));i++){System.Threading.Thread.Sleep(100);h=FindWindow(null,title);}" +
    "if(h==IntPtr.Zero)return -1;" +
    "int style=GetWindowLong(h,-20);bool owned=GetProp(h,P)!=IntPtr.Zero;" +
    "if(alpha<255){" +
    "if((style&L)!=0&&!owned)return -2;" +
    "if((style&L)==0){SetWindowLong(h,-20,style|L);" +
    "if((GetWindowLong(h,-20)&L)==0)return -3;" +
    "if(!SetProp(h,P,new IntPtr(1))){SetWindowLong(h,-20,GetWindowLong(h,-20)&~L);return -4;}}" +
    "if(!SetLayeredWindowAttributes(h,0,(byte)alpha,2)){" +
    "SetWindowLong(h,-20,GetWindowLong(h,-20)&~L);RemoveProp(h,P);RedrawWindow(h,IntPtr.Zero,IntPtr.Zero,0x485);return -5;}" +
    "}else if(owned){SetWindowLong(h,-20,style&~L);if((GetWindowLong(h,-20)&L)!=0)return -6;" +
    "RemoveProp(h,P);RedrawWindow(h,IntPtr.Zero,IntPtr.Zero,0x485);}" +
    "try{DwmSetWindowAttribute(h,20,ref dark,4);DwmSetWindowAttribute(h,35,ref caption,4);" +
    "DwmSetWindowAttribute(h,36,ref text,4);DwmSetWindowAttribute(h,34,ref border,4);}catch(Exception){}return 1;}}";
  var script = "$ErrorActionPreference='Stop';try {$src=" + psQuote(nativeCode) + ".Replace('@',[string][char]34);" +
    "Add-Type -TypeDefinition $src;$result=[WorkBankChrome]::Apply(" + psQuote(title) + "," + psQuote(handle) + "," +
    chromeColor(colors.caption) + "," + chromeColor(colors.text) + "," + chromeColor(colors.border) + "," + colors.dark + "," +
    alphaByte(alphaPct) + "," + psQuote(gatePath) + "," + psQuote(String(revision)) + ")}" +
    "catch {$result=-9};if($result -ne 2){try{[IO.File]::WriteAllText(" + psQuote(resultPath) + ",[string]$result,[Text.Encoding]::ASCII)}catch{}}";
  var shell = new ActiveXObject("WScript.Shell");
  var exe = shell.ExpandEnvironmentStrings("%SystemRoot%\\System32\\WindowsPowerShell\\v1.0\\powershell.exe");
  shell.Run('"' + exe + '" -NoLogo -NoProfile -NonInteractive -WindowStyle Hidden -Command "' + script + '"', 0, false);
}
function checkChromeResult(path, revision, started) {
  var result = readPath(path, false);
  if (result) {
    deletePath(path);
    if (revision === chromeRevision && result !== "1") showToast("窗口透明效果未能切换，请检查 PowerShell 和系统策略。");
    return;
  }
  if (new Date().getTime() - started < 12000) {
    setTimeout(function () { checkChromeResult(path, revision, started); }, 300);
  } else if (revision === chromeRevision) {
    showToast("窗口外观未能确认，窗口可能保持原样；请检查 PowerShell。");
  }
}
function applyWindowChrome() {
  if (chromeTimer) clearTimeout(chromeTimer);
  try {
    if (!chromeBasePath) {
      var fso = new ActiveXObject("Scripting.FileSystemObject");
      chromeBasePath = fso.GetSpecialFolder(2).Path + "\\WorkBankChrome-" + new Date().getTime() + "-" + Math.floor(Math.random() * 1000000);
      chromeGatePath = chromeBasePath + ".current";
    }
    var revision = ++chromeRevision, requestedTheme = theme, requestedAlpha = activeAlpha;
    if (!writePath(chromeGatePath, String(revision), false)) throw new Error("window theme gate unavailable");
    chromeTimer = setTimeout(function () {
      chromeTimer = null;
      var resultPath = chromeBasePath + "." + revision + ".result";
      try {
        chromeCommand(document.title, petRunning ? petParentHandle : "", CHROME_COLORS[requestedTheme] || CHROME_COLORS.deep,
          requestedAlpha, chromeGatePath, resultPath, revision);
        setTimeout(function () { checkChromeResult(resultPath, revision, new Date().getTime()); }, 300);
      } catch (e) { if (revision === chromeRevision) showToast("窗口透明效果未能切换，请检查 PowerShell 和系统策略。"); }
    }, 300);
  } catch (e) {
    if (theme === "glass") showToast("透明效果暂不可用，请检查临时目录和系统策略。");
  }
}
function appPath(name) {
  var p;
  try { p = decodeURIComponent(location.pathname); } catch (e) { p = unescape(location.pathname); }
  if (p.charAt(0) === "/") p = p.substring(1);
  p = p.replace(/\//g, "\\");
  return p.substring(0, p.lastIndexOf("\\") + 1) + name;
}
function readPath(path, unicode) {
  try {
    var fso = new ActiveXObject("Scripting.FileSystemObject");
    if (!fso.FileExists(path)) return "";
    var file = fso.OpenTextFile(path, 1, false, unicode ? -1 : 0);
    var value = file.AtEndOfStream ? "" : file.ReadAll();
    file.Close();
    return value.replace(/^﻿/, "");
  } catch (e) { return ""; }
}
function writePath(path, value, unicode) {
  try {
    var fso = new ActiveXObject("Scripting.FileSystemObject");
    var file = fso.OpenTextFile(path, 2, true, unicode ? -1 : 0);
    file.Write(value);
    file.Close();
    return true;
  } catch (e) { return false; }
}
function deletePath(path) {
  if (!path) return;
  try {
    var fso = new ActiveXObject("Scripting.FileSystemObject");
    if (fso.FileExists(path)) fso.DeleteFile(path, true);
  } catch (e) {}
}
var STARTUP_LINK_NAME = "WorkEncourager-WorkBank.lnk";
var STARTUP_LINK_MARKER = "WorkEncourager WorkBank startup v1";
function sameWindowsPath(left, right) {
  return String(left || "").replace(/\\/g, "/").toLowerCase() === String(right || "").replace(/\\/g, "/").toLowerCase();
}
/* Only create or remove the shortcut this app can positively identify as its own. */
function setWindowsAutostart(enabled) {
  try {
    var fso = new ActiveXObject("Scripting.FileSystemObject");
    var shell = new ActiveXObject("WScript.Shell");
    var startup = String(shell.SpecialFolders("Startup") || "");
    if (!startup) return false;
    var link = startup + "\\" + STARTUP_LINK_NAME;
    var executable = shell.ExpandEnvironmentStrings("%SystemRoot%\\System32\\mshta.exe");
    var target = appPath("上班鼓励器.hta");
    var argumentsText = '"' + target + '"';
    var shortcut = shell.CreateShortcut(link);
    var exists = fso.FileExists(link);
    if (exists && (shortcut.Description !== STARTUP_LINK_MARKER || !sameWindowsPath(shortcut.TargetPath, executable) ||
        String(shortcut.Arguments || "").replace(/^\"|\"$/g, "") !== target)) return false;
    if (!enabled) {
      if (exists) fso.DeleteFile(link, true);
      return true;
    }
    shortcut.TargetPath = executable;
    shortcut.Arguments = argumentsText;
    shortcut.WorkingDirectory = target.substring(0, target.lastIndexOf("\\"));
    shortcut.Description = STARTUP_LINK_MARKER;
    shortcut.WindowStyle = 1;
    shortcut.IconLocation = executable + ",0";
    shortcut.Save();
    return fso.FileExists(link);
  } catch (e) { return false; }
}
function parseBank(raw) {
  try {
    var data = JSON.parse(raw);
    if (!data || data.version !== 1 || !data.days || typeof data.days !== "object" ||
        (data.settings !== null && !bankValidSettings(data.settings))) return null;
    for (var key in data.days) {
      if (!Object.prototype.hasOwnProperty.call(data.days, key)) continue;
      var d = data.days[key];
      if (!/^\d{4}-\d{2}-\d{2}$/.test(key) || !d ||
          typeof d.activeSeconds !== "number" || !isFinite(d.activeSeconds) || d.activeSeconds < 0 ||
          typeof d.hourlyRate !== "number" || !isFinite(d.hourlyRate) || d.hourlyRate < 0 ||
          typeof d.dayHours !== "number" || !isFinite(d.dayHours) || d.dayHours < 0 || d.dayHours > 24 ||
          (d.dayHours === 0 ? d.calculationMode !== "days" || d.hourlyRate !== 0 : d.hourlyRate <= 0) ||
          (typeof d.calculationMode !== "undefined" && d.calculationMode !== "days" && d.calculationMode !== "hours") ||
          (typeof d.paidDays !== "undefined" && !bankValidPaidDays(d.paidDays)) ||
          (typeof d.dailyAmount !== "undefined" && (typeof d.dailyAmount !== "number" || !isFinite(d.dailyAmount) || d.dailyAmount <= 0))) return null;
      if (typeof d.manualEntries !== "undefined") {
        if (Object.prototype.toString.call(d.manualEntries) !== "[object Array]" || d.manualEntries.length > 1440) return null;
        var manualTotal = 0;
        for (var i = 0; i < d.manualEntries.length; i++) {
          var entry = d.manualEntries[i];
          if (!entry || typeof entry.minutes !== "number" || entry.minutes < 1 || entry.minutes > 1440 || Math.floor(entry.minutes) !== entry.minutes ||
              (entry.kind !== "会议" && entry.kind !== "阅读资料" && entry.kind !== "其他")) return null;
          manualTotal += entry.minutes;
        }
        if (manualTotal > 1440) return null;
      }
    }
    return data;
  } catch (e) { return null; }
}
function loadBank() {
  try {
    var fso = new ActiveXObject("Scripting.FileSystemObject");
    var mainExists = fso.FileExists(appPath(DATA_FILE));
    var backupExists = fso.FileExists(appPath(BACKUP_FILE));
    if (!mainExists && !backupExists) return;
    var data = mainExists ? parseBank(readPath(appPath(DATA_FILE), true)) : null;
    mainValid = !!data;
    if (!data && backupExists) {
      data = parseBank(readPath(appPath(BACKUP_FILE), true));
      if (data) recovered = true;
    }
    if (!data) {
      fatalStorage = true;
      storageProblem = "本机记录无法读取，已暂停保存。请先备份并检查 workbank.json 和备份文件。";
      return;
    }
    bank = data;
    masked = !bank.settings || bank.settings.maskByDefault !== false;
    theme = normalizeTheme(bank.settings && bank.settings.theme);
    pendingTheme = theme;
    savedThemeAlpha = bankThemeAlpha(bank.settings);
    draftThemeAlpha = copyThemeAlpha(savedThemeAlpha);
    activeAlpha = savedThemeAlpha[theme];
    pendingAlpha = activeAlpha;
    if (bank.settings) {
      petTopMost = bank.settings.petOnTop !== false;
      petPositionX = typeof bank.settings.petX === "number" && isFinite(bank.settings.petX) && Math.abs(bank.settings.petX) <= 100000 ? Math.round(bank.settings.petX) : null;
      petPositionY = typeof bank.settings.petY === "number" && isFinite(bank.settings.petY) && Math.abs(bank.settings.petY) <= 100000 ? Math.round(bank.settings.petY) : null;
    }
  } catch (e) {
    fatalStorage = true;
    storageProblem = "无法访问本机文件，已暂停保存。请检查目录权限。";
  }
}
function saveBank() {
  if (fatalStorage) return false;
  try {
    var fso = new ActiveXObject("Scripting.FileSystemObject");
    var main = appPath(DATA_FILE), backup = appPath(BACKUP_FILE), temp = appPath(TEMP_FILE);
    if (!writePath(temp, JSON.stringify(bank), true)) throw new Error("write failed");
    if (mainValid && fso.FileExists(main)) fso.CopyFile(main, backup, true);
    fso.CopyFile(temp, main, true);
    mainValid = true;
    deletePath(temp);
    dirty = false;
    storageProblem = "";
    return true;
  } catch (e) {
    storageProblem = "本机记录保存失败，数据暂留内存；请检查程序目录的写入权限。";
    return false;
  }
}

/* PowerShell 命令中的路径和窗口标题使用单引号转义。 */
function psQuote(value) { return "'" + value.replace(/'/g, "''") + "'"; }

/* 临时唯一标题用于只定位当前 HTA 窗口；确认系统置顶成功后才更新按钮。 */
function pinCommand(title, desired, resultPath) {
  var nativeCode = "using System;using System.Runtime.InteropServices;" +
    "public static class WorkBankWindow {" +
    "[DllImport(@user32.dll@,CharSet=CharSet.Unicode,SetLastError=true)] private static extern IntPtr FindWindow(string cls,string name);" +
    "[DllImport(@user32.dll@,SetLastError=true)] private static extern bool SetWindowPos(IntPtr window,IntPtr after,int x,int y,int width,int height,uint flags);" +
    "[DllImport(@user32.dll@,EntryPoint=@GetWindowLongW@)] private static extern int GetWindowLong(IntPtr window,int index);" +
    "public static int Set(string title,bool topmost) { IntPtr window=FindWindow(null,title);" +
    "if(window==IntPtr.Zero)return -1;" +
    "if(!SetWindowPos(window,new IntPtr(topmost ? -1 : -2),0,0,0,0,0x13))return -2;" +
    "bool actual=(GetWindowLong(window,-20)&8)!=0;return actual==topmost ? 1 : -3; }}";
  return "$ErrorActionPreference='Stop';$src=" + psQuote(nativeCode) + ".Replace('@',[string][char]34);" +
    "try { Add-Type -TypeDefinition $src; $result=[WorkBankWindow]::Set(" + psQuote(title) + "," + (desired ? "$true" : "$false") + ") }" +
    "catch { $result=-9 };[IO.File]::WriteAllText(" + psQuote(resultPath) + ",[string]$result,[Text.Encoding]::ASCII)";
}
function renderPin() {
  var button = $id("btnPin");
  text("btnPin", pinPending ? "设置中…" : (pinned ? "取消置顶" : "置顶窗口"));
  button.className = "pin" + (pinned ? " on" : "");
  button.disabled = pinPending || petStarting;
  button.setAttribute("aria-pressed", pinned ? "true" : "false");
  button.title = pinned ? "取消窗口置顶" : "将窗口固定在其他普通窗口前面";
}
function finishPin(success) {
  if (pinTimer) clearTimeout(pinTimer);
  pinTimer = null;
  deletePath(pinResultPath);
  pinResultPath = "";
  document.title = pinPreviousTitle;
  pinPending = false;
  if (success) {
    pinned = pinDesired;
    if (pinRemember && bank.settings) {
      bank.settings.alwaysOnTop = pinned;
      dirty = true;
      if (!saveBank()) showToast("置顶已切换，但偏好保存失败；请检查目录权限。");
    }
  } else if (pinRemember) {
    alert("无法切换窗口置顶。请检查 PowerShell 和系统策略，然后重试。");
  } else {
    showToast("无法恢复窗口置顶，可检查 PowerShell 后手动重试。");
  }
  renderPin();
  applyWindowChrome();
  if (petStarted === -1) { petStarted = 0; startPet(); }
}
function checkPin() {
  if (!pinPending) return;
  var result = readPath(pinResultPath, false);
  if (result === "1") { finishPin(true); return; }
  if (/^-?\d+$/.test(result) || new Date().getTime() - pinStarted >= 12000) { finishPin(false); return; }
  pinTimer = setTimeout(checkPin, 250);
}
function requestPin(desired, remember) {
  if (pinPending || petStarting) return;
  try {
    var shell = new ActiveXObject("WScript.Shell");
    var fso = new ActiveXObject("Scripting.FileSystemObject");
    var token = "WorkBankPin-" + new Date().getTime() + "-" + Math.floor(Math.random() * 1000000);
    pinResultPath = fso.GetSpecialFolder(2).Path + "\\" + token + ".result";
    pinPreviousTitle = document.title;
    document.title = pinPreviousTitle + " [" + token + "]";
    pinDesired = desired;
    pinRemember = remember;
    pinStarted = new Date().getTime();
    pinPending = true;
    renderPin();
    var exe = shell.ExpandEnvironmentStrings("%SystemRoot%\\System32\\WindowsPowerShell\\v1.0\\powershell.exe");
    shell.Run('"' + exe + '" -NoLogo -NoProfile -NonInteractive -WindowStyle Hidden -Command "' + pinCommand(document.title, desired, pinResultPath) + '"', 0, false);
    pinTimer = setTimeout(checkPin, 250);
  } catch (e) {
    if (pinPending) finishPin(false);
    else alert("无法切换窗口置顶。请检查 PowerShell 和系统策略，然后重试。");
  }
}

/* 桌宠与主窗口仅通过临时文件交换展示状态、位置和操作。 */
function petLaunchCommand(title, x, y) {
  var args = [psQuote(title), psQuote(appPath("assets")), psQuote(petAlivePath), psQuote(petStatePath),
    psQuote(petBeatPath), psQuote(petReadyPath), psQuote(petControlPath), psQuote(petNoticePath),
    psQuote(petEventsPath), psQuote(petPosPath)];
  return "$ErrorActionPreference='Stop';try { Add-Type -Path " + psQuote(appPath("DesktopPet.cs")) +
    " -ReferencedAssemblies @('System.Windows.Forms','System.Drawing');[WorkBankPet]::Run(" + args.join(",") +
    "," + (petTopMost ? "$true" : "$false") + "," + x + "," + y + ") }" +
    " catch { try { [IO.File]::WriteAllText(" + psQuote(petReadyPath) + ",'error',[Text.Encoding]::ASCII) } catch {} }";
}
function recoverPetPanel(handle) {
  if (!/^\d{1,20}$/.test(handle)) return;
  try {
    var shell = new ActiveXObject("WScript.Shell");
    var exe = shell.ExpandEnvironmentStrings("%SystemRoot%\\System32\\WindowsPowerShell\\v1.0\\powershell.exe");
    var nativeCode = "using System;using System.Runtime.InteropServices;public static class WorkBankRecovery {" +
      "[DllImport(@user32.dll@)]static extern bool IsWindow(IntPtr h);" +
      "[DllImport(@user32.dll@)]static extern bool IsIconic(IntPtr h);" +
      "[DllImport(@user32.dll@)]static extern bool ShowWindowAsync(IntPtr h,int command);" +
      "[DllImport(@user32.dll@,EntryPoint=@GetWindowLongW@)]static extern int GetWindowLong(IntPtr h,int index);" +
      "[DllImport(@user32.dll@,EntryPoint=@SetWindowLongW@)]static extern int SetWindowLong(IntPtr h,int index,int value);" +
      "[DllImport(@user32.dll@)]static extern bool SetWindowPos(IntPtr h,IntPtr after,int x,int y,int w,int height,uint flags);" +
      "public static void Restore(long value){IntPtr h=new IntPtr(value);if(!IsWindow(h))return;" +
      "SetWindowLong(h,-16,GetWindowLong(h,-16)|0xA0000);SetWindowPos(h,IntPtr.Zero,0,0,0,0,0x37);" +
      "if(IsIconic(h))ShowWindowAsync(h,9);}}";
    var script = "$ErrorActionPreference='Stop';try {$src=" + psQuote(nativeCode) + ".Replace('@',[string][char]34);" +
      "Add-Type -TypeDefinition $src;[WorkBankRecovery]::Restore(" + handle + ")} catch {}";
    shell.Run('"' + exe + '" -NoLogo -NoProfile -NonInteractive -WindowStyle Hidden -Command "' + script + '"', 0, false);
  } catch (e) {}
}
function petStatusLabel() {
  if (fatalStorage || storageProblem) return "请查看提示";
  if (!bank.settings) return "未设置";
  if (!tracking) return signedOff ? "已收工" : "未开工";
  if (!monitorReady) return "采样未就绪";
  if (monitorIdle) return "键鼠空闲";
  var d = new Date(), time = pad(d.getHours()) + ":" + pad(d.getMinutes());
  var day = currentDay(d.getTime());
  if (day.unconfigured) return "需设置计薪天数";
  if (bankIsRestDay(day) && day.activeSeconds === 0) return "休息日";
  if (time >= bank.settings.endTime || bankOvertime(day) > 0) return "加班中";
  return day.activeSeconds >= day.dayHours * 3600 * 0.9 ? "接近计划工时" : "上班中";
}
function petState() {
  if (fatalStorage || storageProblem) return "error";
  if (!bank.settings) return "unconfigured";
  if (new Date().getTime() < celebrateUntil) return "celebrate";
  if (!tracking) return "paused";
  if (!monitorReady) return "waiting";
  if (monitorIdle) return "idle";
  var d = new Date(), time = pad(d.getHours()) + ":" + pad(d.getMinutes());
  var day = currentDay(d.getTime()), overtime = bankOvertime(day);
  if (day.unconfigured) return "unconfigured";
  if (bankIsRestDay(day) && day.activeSeconds === 0) return "rest";
  if (time >= bank.settings.endTime || overtime > 0) return overtime >= FIGHT_OVERTIME_SECONDS ? "overtime-steady" : "overtime";
  return day.activeSeconds >= day.dayHours * 3600 * 0.9 ? "urgent" : "active";
}
function petTip() {
  if (!bank.settings) return "小鲸 · 还没设置班表";
  var day = currentDay(new Date().getTime());
  return "小鲸 · " + petStatusLabel() + "\n活跃 " + duration(day.activeSeconds) + " · 今日投入 " + money(bankDayAmount(day), 4);
}
function bankMiniMode(settings) {
  if (!settings) return "off";
  if (settings.miniMode === "always" || settings.miniMode === "hover" || settings.miniMode === "off") return settings.miniMode;
  return settings.miniInfo === false ? "off" : "always";
}
function miniVisible() {
  return !!(bank.settings && bankMiniMode(bank.settings) !== "off" && !petPanelVisible && !modalVisible());
}
function writePetState() {
  if (!petStatePath || (!petStarting && !petRunning)) return;
  var now = new Date().getTime(), day = currentDay(now);
  var percent = bank.settings ? Math.floor(bankProgressPercent(day)) : 0;
  if (bankIsRestDay(day) && day.activeSeconds > 0) percent = 100;
  percent = Math.max(0, Math.min(100, percent));
  var amount = bank.settings ? money(bankDayAmount(day), 4) : "¥ ****";
  var detail = day.unconfigured ? "请先设置本月计薪天数" : (bankIsRestDay(day) ? "活跃 " + (day.activeSeconds / 3600).toFixed(2) + " 小时" :
    (bank.settings ? (day.activeSeconds / 3600).toFixed(2) + " / " + day.dayHours.toFixed(2) + " 小时" : ""));
  var selectedMiniMode = bankMiniMode(bank.settings || {});
  var state = petState() + "|" + (bank.settings && bank.settings.motion === false ? "0" : "1") + "|" +
    (tracking ? "1" : "0") + "|" + (petPanelVisible ? "1" : "0") + "|" + (miniVisible() ? (selectedMiniMode === "hover" ? "2" : "1") : "0") + "|" +
    theme + "|" + percent + "|" + amount + "|" + detail + "|" + selectedMiniMode + "|" + bankLockMode(bank.settings) + "|" +
    (restReminderPending ? "1" : "0") + "|" + petTip();
  if (state !== petLastState && writePath(petStatePath, state, true)) petLastState = state;
}
function readPetBounds() {
  if (!petPosPath) return null;
  var parts = readPath(petPosPath, false).split("|");
  if (parts.length !== 8) return null;
  var values = [];
  for (var i = 0; i < 8; i++) {
    var n = Number(parts[i]);
    if (!isFinite(n) || Math.abs(n) > 100000) return null;
    values.push(Math.round(n));
  }
  return { x: values[0], y: values[1], width: values[2], height: values[3],
    workLeft: values[4], workTop: values[5], workRight: values[6], workBottom: values[7] };
}
function showPanelNearPet() {
  petBounds = readPetBounds() || petBounds;
  if (!petBounds) { writePath(petControlPath, "show", false); return; }
  var target = bankPanelBounds(petBounds, PANEL_WIDTH, PANEL_HEIGHT, PANEL_GAP);
  panelAnchor = target;
  writePath(petControlPath, "show|" + target.x + "|" + target.y, false);
}
function followPet() {
  if (!petRunning || !petPanelVisible) return;
  var bounds = readPetBounds();
  if (bounds) petBounds = bounds;
  if (!petBounds) return;
  var target = bankPanelBounds(petBounds, PANEL_WIDTH, PANEL_HEIGHT, PANEL_GAP);
  if (panelAnchor && panelAnchor.x === target.x && panelAnchor.y === target.y) return;
  panelAnchor = target;
  try { window.moveTo(target.x, target.y); } catch (e) {}
}
function showPetStatus(message) {
  text("petStatusText", message);
  $id("petStatus").className = message ? "pet-status error" : "pet-status hidden";
}
function cleanupPetFiles() {
  deletePath(petAlivePath);
  deletePath(petStatePath);
  deletePath(petBeatPath);
  deletePath(petReadyPath);
  deletePath(petControlPath);
  deletePath(petNoticePath);
  deletePath(petPosPath);
  if (petEventsPath) {
    try {
      var fso = new ActiveXObject("Scripting.FileSystemObject");
      if (fso.FolderExists(petEventsPath)) fso.DeleteFolder(petEventsPath, true);
    } catch (e) {}
  }
}
function stopPet() {
  petStarting = false;
  petRunning = false;
  petStarted = 0;
  petBounds = null;
  panelAnchor = null;
  cleanupPetFiles();
}
function failPet(message) {
  var restoreHandle = petRunning ? petParentHandle : "";
  var needsLockFailSafe = bankLockMode(bank.settings) !== "off";
  if (petStarting && document.title === petTargetTitle) document.title = petPreviousTitle;
  if (needsLockFailSafe) {
    if (tracking) pauseTracking();
    sessionMonitorReady = false;
    sessionMonitorFailed = true;
    lockPausedTracking = false;
    startWhenSessionReady = false;
    message += " 锁屏监测不可用，记录已暂停。";
  }
  stopPet();
  recoverPetPanel(restoreHandle);
  renderPin();
  applyWindowChrome();
  showPetStatus(message);
  showToast(message);
}
function applyMiniMode(value) {
  if (value !== "always" && value !== "hover" && value !== "off") return;
  if (!bank.settings) { showToast("请先设置班表，再调整简要信息卡。"); return; }
  bank.settings.miniMode = value;
  bank.settings.miniInfo = value !== "off";
  if ($id("inMiniMode")) $id("inMiniMode").value = value;
  dirty = true;
  petLastState = "";
  if (!tracking && !saveBank()) showToast("简要信息卡模式未能保存，请检查目录权限。");
  writePetState();
}
function handleSessionEvent(value) {
  var mode = bankLockMode(bank.settings);
  if (value === "session-ready|1") {
    sessionMonitorReady = true;
    sessionMonitorFailed = false;
    if (startWhenSessionReady && !sessionLocked) startTracking();
    return;
  }
  if (value === "session-ready|0") {
    failPet("Windows 锁屏监测不可用；锁屏保护已停止。");
    return;
  }
  if (mode === "off") return;
  if (value === "session|locked") {
    if (sessionLocked) return;
    sessionLocked = true;
    lockPausedTracking = tracking || startWhenSessionReady;
    startWhenSessionReady = false;
    if (tracking) pauseTracking();
    return;
  }
  if (value === "session|unlocked") {
    if (!sessionLocked) return;
    sessionLocked = false;
    var resume = lockPausedTracking;
    lockPausedTracking = false;
    if (!resume) return;
    if (mode === "auto" && sessionMonitorReady && !sessionMonitorFailed) {
      startTracking();
      showToast("已解锁，小鲸继续记录；锁屏期间不补算。");
    } else {
      showToast("已解锁，记录仍暂停；确认后可手动开始。");
    }
  }
}
function startPet() {
  if (petStarting || petRunning) return true;
  if (bankLockMode(bank.settings) !== "off") {
    sessionMonitorReady = false;
    sessionMonitorFailed = false;
  }
  if (pinPending) { petStarted = -1; return false; }
  try {
    var shell = new ActiveXObject("WScript.Shell");
    var fso = new ActiveXObject("Scripting.FileSystemObject");
    var temp = fso.GetSpecialFolder(2).Path;
    var token = "WorkBankPet-" + new Date().getTime() + "-" + Math.floor(Math.random() * 1000000);
    var base = temp + "\\" + token;
    petAlivePath = base + ".alive";
    petStatePath = base + ".state";
    petBeatPath = base + ".beat";
    petReadyPath = base + ".ready";
    petControlPath = base + ".control";
    petNoticePath = base + ".notice";
    petEventsPath = base + ".events";
    petPosPath = base + ".pos";
    fso.CreateFolder(petEventsPath);
    if (!writePath(petAlivePath, "alive", false)) throw new Error("heartbeat failed");
    petPreviousTitle = document.title;
    petTargetTitle = petPreviousTitle + " [" + token + "]";
    document.title = petTargetTitle;
    petStarting = true;
    petRunning = false;
    petPanelVisible = true;
    petParentHandle = "";
    petBounds = null;
    panelAnchor = null;
    petStarted = new Date().getTime();
    petLastHeartbeat = petStarted;
    petLastState = "";
    renderPin();
    writePetState();
    var petX = petPositionX !== null ? petPositionX : -2147483648;
    var petY = petPositionY !== null ? petPositionY : -2147483648;
    var exe = shell.ExpandEnvironmentStrings("%SystemRoot%\\System32\\WindowsPowerShell\\v1.0\\powershell.exe");
    var command = petLaunchCommand(petTargetTitle, petX, petY);
    shell.Run('"' + exe + '" -NoLogo -NoProfile -NonInteractive -Sta -WindowStyle Hidden -Command "' + command + '"', 0, false);
    showPetStatus("");
    return true;
  } catch (e) {
    failPet("小鲸桌宠启动失败，工时卡片仍可正常使用。");
    return false;
  }
}
function handlePetEvent(value) {
  if (value === "hide") {
    petPanelVisible = false;
    /* 桌宠点击后已先自行最小化；再回写一次，避免迟到的展开指令把窗口重新拉起。 */
    writePath(petControlPath, "hide", false);
    $id("toast").className = "toast hidden";
  } else if (value === "show") {
    petPanelVisible = true;
    showPanelNearPet();
    render(new Date().getTime());
  } else if (value === "toggle") {
    if (tracking) pauseTracking(); else startTracking();
  } else if (value === "privacy") {
    togglePrivacy();
  } else if (value === "mini-mode|always" || value === "mini-mode|hover" || value === "mini-mode|off") {
    applyMiniMode(value.substring("mini-mode|".length));
  } else if (value === "rest-snooze") {
    snoozeRestReminder();
  } else if (value === "session-ready|1" || value === "session-ready|0" || value === "session|locked" || value === "session|unlocked") {
    handleSessionEvent(value);
  } else if (value === "pin|1" || value === "pin|0") {
    petTopMost = value === "pin|1";
    if (bank.settings) { bank.settings.petOnTop = petTopMost; dirty = true; }
  } else {
    var match = /^position\|(-?\d{1,6})\|(-?\d{1,6})$/.exec(value);
    if (match && Math.abs(Number(match[1])) <= 100000 && Math.abs(Number(match[2])) <= 100000) {
      petPositionX = Number(match[1]);
      petPositionY = Number(match[2]);
      if (bank.settings) { bank.settings.petX = petPositionX; bank.settings.petY = petPositionY; dirty = true; }
    }
  }
  if (dirty && !tracking && !saveBank()) showToast("桌宠设置未能保存，请检查目录权限。");
}
function readPetEvents() {
  if (!petEventsPath) return;
  try {
    var fso = new ActiveXObject("Scripting.FileSystemObject");
    if (!fso.FolderExists(petEventsPath)) return;
    var paths = [], files = new Enumerator(fso.GetFolder(petEventsPath).Files);
    for (; !files.atEnd(); files.moveNext()) {
      var path = String(files.item().Path);
      if (/\.evt$/i.test(path)) paths.push(path);
    }
    paths.sort();
    for (var i = 0; i < paths.length; i++) {
      var value = readPath(paths[i], false);
      deletePath(paths[i]);
      handlePetEvent(value);
    }
  } catch (e) {}
}
function petTick() {
  if (!petStarting && !petRunning) return;
  var now = new Date().getTime();
  if (now - petLastHeartbeat >= 5000) {
    if (!writePath(petAlivePath, "alive", false)) { failPet("桌宠连接中断，工时卡片仍可正常使用。"); return; }
    petLastHeartbeat = now;
  }
  if (petStarting) {
    var ready = readPath(petReadyPath, false);
    var readyMatch = /^ready\|(\d{1,20})$/.exec(ready);
    if (readyMatch) {
      petParentHandle = readyMatch[1];
      deletePath(petReadyPath);
      if (document.title === petTargetTitle) document.title = petPreviousTitle;
      petStarting = false;
      petRunning = true;
      petStarted = now;
      renderPin();
      applyWindowChrome();
      showPetStatus("");
      var keepVisible = !!fatalStorage || !bank.settings;
      petPanelVisible = keepVisible;
      if (keepVisible) showPanelNearPet();
      else writePath(petControlPath, "hide", false);
    } else if (ready === "error" || now - petStarted > 20000) {
      failPet("小鲸桌宠未能启动，请检查 PowerShell 或组件文件。");
      return;
    }
  } else {
    var beat = Number(readPath(petBeatPath, false));
    if (now - petStarted > 8000 && (!(beat > 0) || now - beat > 12000 || beat - now > 3000)) {
      failPet("小鲸桌宠已退出或连接中断，工时卡片仍可使用。");
      return;
    }
    readPetEvents();
    followPet();
  }
  writePetState();
}

/* 采样进程只查询 GetLastInputInfo，临时文件仅传递时间戳。 */
function workerCommand(alive, sample) {
  var nativeCode = "using System;using System.Runtime.InteropServices;" +
    "public static class WorkBankIdle {" +
    "[StructLayout(LayoutKind.Sequential)] private struct LASTINPUTINFO { public uint cbSize; public uint dwTime; }" +
    "[DllImport(@user32.dll@)] private static extern bool GetLastInputInfo(ref LASTINPUTINFO value);" +
    "[DllImport(@kernel32.dll@)] private static extern uint GetTickCount();" +
    "public static uint Milliseconds() { LASTINPUTINFO value = new LASTINPUTINFO();" +
    "value.cbSize = (uint)Marshal.SizeOf(typeof(LASTINPUTINFO));" +
    "return GetLastInputInfo(ref value) ? unchecked(GetTickCount() - value.dwTime) : UInt32.MaxValue; }}";
  var script = "$ErrorActionPreference='Stop';$alive=" + psQuote(alive) + ";$sample=" + psQuote(sample) + ";" +
    "$src=" + psQuote(nativeCode) + ".Replace('@',[string][char]34);" +
    "try { Add-Type -TypeDefinition $src; while ([IO.File]::Exists($alive)) {" +
    "if (([DateTime]::UtcNow-[IO.File]::GetLastWriteTimeUtc($alive)).TotalSeconds -gt 30) { break };" +
    "$t=[long](([DateTime]::UtcNow.Ticks-621355968000000000)/10000);" +
    "$idle=[WorkBankIdle]::Milliseconds();" +
    "[IO.File]::WriteAllText($sample,([string]$t+'|'+[string]$idle),[Text.Encoding]::ASCII);" +
    "Start-Sleep -Milliseconds 1000 } } finally {" +
    "try { [IO.File]::Delete($sample) } catch {}; try { [IO.File]::Delete($alive) } catch {} }";
  return script;
}
function startMonitor() {
  try {
    var shell = new ActiveXObject("WScript.Shell");
    var fso = new ActiveXObject("Scripting.FileSystemObject");
    var temp = fso.GetSpecialFolder(2).Path;
    var token = "workbank-" + new Date().getTime() + "-" + Math.floor(Math.random() * 1000000);
    alivePath = temp + "\\" + token + ".alive";
    samplePath = temp + "\\" + token + ".sample";
    if (!writePath(alivePath, "alive", false)) throw new Error("heartbeat failed");
    var exe = shell.ExpandEnvironmentStrings("%SystemRoot%\\System32\\WindowsPowerShell\\v1.0\\powershell.exe");
    var script = workerCommand(alivePath, samplePath);
    shell.Run('"' + exe + '" -NoLogo -NoProfile -NonInteractive -WindowStyle Hidden -Command "' + script + '"', 0, false);
    monitorStarted = new Date().getTime();
    lastHeartbeat = monitorStarted;
    monitorReady = false;
    previousInput = null;
    return true;
  } catch (e) {
    stopMonitor();
    monitorStarted = 1;
    return false;
  }
}
function stopMonitor() {
  deletePath(alivePath);
  deletePath(samplePath);
  alivePath = "";
  samplePath = "";
  monitorReady = false;
  monitorIdle = false;
  previousInput = null;
}
function readSample(now) {
  if (!samplePath) return null;
  var raw = readPath(samplePath, false);
  var match = /^(\d{12,16})\|(\d{1,10})$/.exec(raw);
  if (!match) return null;
  var stamp = Number(match[1]), idle = Number(match[2]), age = now - stamp;
  if (age < -1000 || age > SAMPLE_MAX_AGE || idle >= 4294967295) return null;
  return { input: stamp - idle, idle: idle + Math.max(0, age) };
}
function applyDaySnapshot(day, snapshot) {
  day.calculationMode = snapshot.calculationMode;
  day.hourlyRate = snapshot.hourlyRate;
  day.dayHours = snapshot.dayHours;
  if (snapshot.calculationMode === "days") {
    if (typeof snapshot.paidDays === "number") day.paidDays = snapshot.paidDays; else delete day.paidDays;
    if (typeof snapshot.dailyAmount === "number") day.dailyAmount = snapshot.dailyAmount; else delete day.dailyAmount;
  } else {
    delete day.paidDays;
    delete day.dailyAmount;
  }
}
function addActivity(start, end) {
  var parts = bankSplitByDay(start, end), addedSeconds = 0;
  for (var i = 0; i < parts.length; i++) {
    var part = parts[i], day = bank.days[part.date];
    if (!day || day.manualOnly === true) {
      var snapshot = bankSnapshotForDate(bank.settings, part.date);
      if (!snapshot) continue;
      if (!day) day = { activeSeconds: 0 };
      applyDaySnapshot(day, snapshot);
      bank.days[part.date] = day;
    }
    var seconds = (part.end - part.start) / 1000;
    day.activeSeconds += seconds;
    addedSeconds += seconds;
    if (day.manualOnly) delete day.manualOnly;
    dirty = true;
  }
  return addedSeconds;
}
function currentDay(now) {
  var date = bankDate(now), day = bank.days[date];
  if (day) {
    if (day.manualOnly === true && bankCalcMode(bank.settings) === "days" && bankPaidDays(bank.settings, date.substring(0, 7)) === null) {
      var pending = JSON.parse(JSON.stringify(day));
      pending.unconfigured = true;
      return pending;
    }
    return day;
  }
  if (!bank.settings) return { activeSeconds: 0, hourlyRate: 0, dayHours: 8 };
  var snapshot = bankSnapshotForDate(bank.settings, date);
  if (!snapshot) return { activeSeconds: 0, hourlyRate: 0, dayHours: 0, calculationMode: "days", unconfigured: true };
  snapshot.activeSeconds = 0;
  return snapshot;
}
function bankParseGoals(text) {
  var lines = String(text || "").split(/\r\n|\r|\n/), goals = [], used = {}, ignored = 0, count = 0;
  for (var i = 0; i < lines.length; i++) {
    var line = lines[i].replace(/^\s+|\s+$/g, "");
    if (!line) continue;
    count++;
    var match = /^(.{1,12}?)[=＝]\s*([0-9]+(?:\.[0-9]+)?)$/.exec(line);
    var name = match ? match[1].replace(/^\s+|\s+$/g, "") : "", value = match ? Number(match[2]) : 0;
    var key = String(Math.round(value * 100));
    if (!match || !name || !isFinite(value) || value <= 0 || value > 100000000 || used[key] || goals.length >= 20) {
      ignored++;
      continue;
    }
    used[key] = true;
    goals.push({ name: name, value: value });
  }
  return { goals: goals, ignored: ignored, count: count };
}
function bankGoalCustom(text) {
  var result = bankParseGoals(text);
  return result.goals.length >= 3 ? result.goals : null;
}
function showGoalValidation() {
  var result = bankParseGoals($id("inGoals").value);
  if (!result.count) { text("goalValidation", "留空时使用内置目标。"); return; }
  var merged = result.goals.length - bankMergeGoals(result.goals.slice(0)).length;
  text("goalValidation", "已识别 " + result.goals.length + " 项，忽略 " + result.ignored + " 行" +
    (merged ? "，金额接近的 " + merged + " 项会合并" : "") + (result.goals.length < 3 ? "；不足 3 项，使用内置目标。" : "。"));
}
function bankMergeGoals(goals) {
  goals.sort(function (a, b) { return a.value - b.value; });
  var merged = [];
  for (var i = 0; i < goals.length; i++) {
    if (!merged.length || goals[i].value - merged[merged.length - 1].value >= 2) merged.push(goals[i]);
  }
  return merged;
}
function bankGoalList() {
  var goals = [
    { name: "一支好写的签字笔", value: 6 }, { name: "今天的地铁", value: 8 },
    { name: "早餐豆浆和包子", value: 12 }, { name: "一杯冰美式", value: 19 },
    { name: "一份小零食", value: 25 }, { name: "一顿加班外卖", value: 32 },
    { name: "一份正经午饭", value: 45 }, { name: "奶茶和小食", value: 58 },
    { name: "一场电影", value: 72 }, { name: "一本小书", value: 88 },
    { name: "一顿小火锅", value: 108 },
    { name: "半天房租", value: bank.settings.salary / 60 },
    { name: "四分之三天房租", value: bank.settings.salary / 40 },
    { name: "一天房租", value: bank.settings.salary / 30 }
  ];
  return bankMergeGoals(bankGoalCustom(bank.settings.customGoals) || goals);
}
function goalText(day) {
  if (!bank.settings) return "每一次认真投入，都值得被看见。";
  if (day.unconfigured) return "先设置本月计薪天数，再开始记录。";
  if (bankIsRestDay(day)) return "今天是休息日；记录的活跃时间只计加班，不增加金额。";
  var earned = bankDayAmount(day), rate = day.hourlyRate, salary = bank.settings.salary;
  var maxValue = day.dayHours * rate, goals = bankGoalList(), next = null, capped = null;
  for (var i = 0; i < goals.length; i++) {
    if (goals[i].value > earned + 0.000001) {
      if (goals[i].value <= maxValue + 0.000001) next = goals[i];
      else capped = goals[i];
      break;
    }
  }
  if (!next) {
    var atCap = day.activeSeconds >= day.dayHours * 3600 - 0.5;
    if (capped) return atCap ? "今天的计额已到上限；再往后的时间记在加班里。" : "今天的计额快到头了；再往后的时间记在加班里。";
    if (salary > 0 && earned >= salary / 30 - 0.000001) return "今天投进去的，已折合 " + (earned / (salary / 30)).toFixed(1) + " 天房租。";
    return "今天的投入已经超过了当前设定的目标。";
  }
  var minutes = Math.max(1, Math.ceil((next.value - earned) / rate * 60));
  var time = minutes >= 60 ? Math.floor(minutes / 60) + " 小时 " + (minutes % 60) + " 分钟" : minutes + " 分钟";
  return tracking ? "再记录 " + time + "，相当于" + next.name + "。" : "开始记录后，约 " + time + " 相当于" + next.name + "。";
}
function endDescription(now) {
  if (!bank.settings) return "计划下班 --:--";
  var d = new Date(now), hm = bank.settings.endTime.split(":"), end = new Date(d.getFullYear(), d.getMonth(), d.getDate(), Number(hm[0]), Number(hm[1]), 0, 0).getTime();
  if (!tracking) return "计划下班 " + bank.settings.endTime;
  if (now < end) return "距计划下班 " + duration((end - now) / 1000);
  return "已过计划下班时间 " + duration((now - end) / 1000);
}
function petSayText(day) {
  if (!bank.settings) return "小鲸陪着你。设置好月薪和班表，我们就开始。";
  if (fatalStorage || storageProblem) return "账本有点问题，先看看下面的提示。";
  if (!tracking) return signedOff ? "今天收工啦。剩下的时间，留给自己。" : "小鲸在旁边等你。点开始记录，我们就出发。";
  if (!monitorReady) return "小鲸正在准备计时的东西，等一下下。";
  if (monitorIdle) return "好像两分钟没动了。小鲸先不记账，等你回来。";
  var mins = Math.floor(day.activeSeconds / 60);
  var time = mins >= 60 ? Math.floor(mins / 60) + " 小时" + (mins % 60 ? " " + (mins % 60) + " 分" : "") : mins + " 分钟";
  return "小鲸陪着你，今天已经投入 " + time + "。";
}
function checkMilestone(now, pct) {
  if (!tracking || !bank.settings) { milestoneStage = 0; milestoneDay = ""; return; }
  var key = bankDate(now);
  if (key !== milestoneDay) { milestoneDay = key; milestoneStage = 0; }
  var stage = pct >= 100 ? 3 : (pct >= 90 ? 2 : (pct >= 50 ? 1 : 0));
  if (stage <= milestoneStage) return;
  milestoneStage = stage;
  showToast(stage === 3 ? "计划工时已满；超出的时间记在加班。" :
    (stage === 2 ? "接近计划工时了，再坚持一下。" : "今天已经走过一半，稳。"));
}
function render(now) {
  var day = currentDay(now), month = bankMonth(bank.days, bankDate(now).substring(0, 7));
  var restDay = bankIsRestDay(day), pct = bankProgressPercent(day);
  var barPct = restDay && day.activeSeconds > 0 ? 100 : pct;
  var status = $id("status"), stateText = "未设置", statusClass = "status off";
  if (bank.settings) {
    if (sessionLocked && bankLockMode(bank.settings) !== "off") stateText = "锁屏暂停";
    else if (!tracking) stateText = signedOff ? "已收工" : "未开工";
    else if (!monitorReady) stateText = "采样未就绪";
    else if (monitorIdle) stateText = "键鼠空闲";
    else {
      var d = new Date(now), time = pad(d.getHours()) + ":" + pad(d.getMinutes());
      if (restDay && day.activeSeconds === 0) { stateText = "休息日"; statusClass = "status off"; }
      else if (time >= bank.settings.endTime || (restDay ? day.activeSeconds > 0 : pct >= 100)) { stateText = "加班中"; statusClass = "status overtime"; }
      else { stateText = "上班中"; statusClass = "status"; }
    }
  }
  status.className = statusClass;
  text("status", stateText);
  text("dateText", bankDate(now));
  text("todayAmount", money(bankDayAmount(day), 4));
  $id("todayAmount").title = masked ? "点击显示金额" : "点击隐藏金额";
  $id("todayAmount").setAttribute("aria-label", "今日投入 " + money(bankDayAmount(day), 4) + "，" + $id("todayAmount").title);
  $id("todayAmount").setAttribute("aria-pressed", masked ? "true" : "false");
  text("todayCaption", !bank.settings ? "先设置到手月薪和计划工时" : (day.unconfigured ? "先设置本月计薪天数" :
    (restDay ? "按天核算 · 休息日只记录加班，不增加金额" :
      (day.calculationMode === "days" ? "按天核算" : "按时核算") + " · 时薪 " + money(day.hourlyRate) + " · " + (day.activeSeconds / 28800).toFixed(2) + " 个标准日")));
  text("progressText", day.unconfigured ? "待设置本月计薪天数" : (restDay ? "休息日 · 活跃 " + (day.activeSeconds / 3600).toFixed(2) + " 小时" :
    (day.activeSeconds / 3600).toFixed(2) + " / " + day.dayHours.toFixed(2) + " 小时 · " + Math.floor(pct) + "%"));
  $id("progressFill").style.width = Math.min(100, Math.max(0, barPct)) + "%";
  var stage = (restDay && day.activeSeconds > 0) || pct >= 100 ? "overtime" : (pct >= 90 ? "hot" : (pct >= 60 ? "warm" : "cool"));
  $id("energyMeter").className = "energy " + stage + ((!tracking || !monitorReady || monitorIdle) ? " paused" : "");
  applyTheme();
  text("petSay", petSayText(day));
  if (!restDay && !day.unconfigured) checkMilestone(now, pct);
  text("activeText", "已记录 " + duration(day.activeSeconds) + (bankManualMinutes(day) ? " · 补记 " + bankManualMinutes(day) + " 分" : ""));
  text("endText", day.unconfigured ? "待设置当月天数" : (restDay ? "计划休息日" : endDescription(now)));
  text("monthAmount", money(month.amount));
  $id("monthAmount").title = masked ? "点击显示金额" : "点击隐藏金额";
  $id("monthAmount").setAttribute("aria-label", "本月累计投入 " + money(month.amount) + "，" + $id("monthAmount").title);
  $id("monthAmount").setAttribute("aria-pressed", masked ? "true" : "false");
  text("monthDetail", "已记录 " + month.days + " 天 · 活跃 " + duration(month.activeSeconds));
  text("monthOvertime", duration(month.overtimeSeconds));
  text("leaveDetail", "折合 " + (month.overtimeSeconds / 28800).toFixed(1) + " 个标准日（仅供参考）");
  text("anchorText", goalText(day));
  text("btnPrivacy", masked ? "显示金额" : "隐藏金额");
  text("btnTrack", tracking ? "暂停记录" : "开始记录");
  $id("bankCard").title = stateText + " · 活跃 " + duration(day.activeSeconds) + " · 今日投入 " + money(bankDayAmount(day), 4);
  var monitor = $id("monitorText");
  monitor.className = "monitor" + (storageProblem || (tracking && !monitorReady && now - monitorStarted > 8000) ? " error" : "");
  if (storageProblem) text("monitorText", storageProblem);
  else if (bank.settings && bankCalcMode(bank.settings) === "days" && bankPaidDays(bank.settings, bankDate(now).substring(0, 7)) === null)
    text("monitorText", "本月计薪天数未设置，记录已暂停。请在设置中填写并保存。");
  else if (sessionLocked && bankLockMode(bank.settings) !== "off") text("monitorText", "Windows 已锁屏，记录已暂停；解锁后按设置决定是否自动继续。");
  else if (sessionMonitorFailed && bankLockMode(bank.settings) !== "off") text("monitorText", "锁屏监测不可用，记录已暂停。重试小鲸，或关闭锁屏暂停设置后再开始。");
  else if (bankLockMode(bank.settings) !== "off" && !sessionMonitorReady) text("monitorText", "正在连接锁屏监测；连接成功前不会开始计时。");
  else if (tracking && !monitorReady && now - monitorStarted > 8000) {
    monitor.innerText = "无法读取系统活跃状态，未计入工时。请检查 PowerShell 和系统策略，然后暂停并重新开始记录。";
  } else if (tracking && !monitorReady) text("monitorText", "正在启动本机活跃状态采样；采样就绪前不计时。");
  else if (tracking && monitorIdle) text("monitorText", "已超过 2 分钟没有键鼠操作，暂不累计；再次操作后恢复。");
  else if (recovered) text("monitorText", "主记录无法读取，已使用本机备份；请检查并备份数据文件。");
  else text("monitorText", "仅在开启记录且程序运行时统计；2 分钟内有键鼠操作视为活跃。");
}
function hourKey(d) { return bankDate(d.getTime()) + "-" + pad(d.getHours()); }
function showToast(message) {
  if (petRunning && !petPanelVisible) {
    var notice = message.indexOf("整点") >= 0 || message.indexOf("时薪参考") === 0 ? "hour" :
      (message.indexOf("Alt+R") >= 0 ? "rest" : "attention");
    writePath(petNoticePath, notice, false);
    return;
  }
  text("toast", message);
  $id("toast").className = "toast";
  if (toastTimer) clearTimeout(toastTimer);
  toastTimer = setTimeout(function () { $id("toast").className = "toast hidden"; }, 6000);
}
function snoozeRestReminder() {
  if (!restReminderPending) { showToast("当前没有待处理的休息提醒。"); return false; }
  restReminderSnoozeSeconds = 15 * 60;
  showToast("已稍后提醒；再记录 15 分钟活跃时间后提醒。暂停和键鼠空闲时不计时。");
  return true;
}
function pauseForMissingPaidMonth(now) {
  if (!tracking || !bank.settings || bankCalcMode(bank.settings) !== "days" ||
      bankPaidDays(bank.settings, bankDate(now).substring(0, 7)) !== null) return false;
  /* Preserve the valid part just before midnight; never guess the new month's rate. */
  var date = new Date(now), boundary = new Date(date.getFullYear(), date.getMonth(), 1).getTime();
  var elapsed = now - lastTick, sample = readSample(now);
  if (!sessionLocked && lastTick < boundary && previousInput !== null && sample && elapsed > 0 && elapsed <= MAX_TICK_GAP) {
    var ranges = bankActiveRanges(lastTick, boundary, previousInput, sample.input, IDLE_LIMIT);
    for (var i = 0; i < ranges.length; i++) addActivity(ranges[i].start, ranges[i].end);
  }
  tracking = false;
  stopMonitor();
  if (dirty) saveBank();
  showToast("本月计薪天数尚未设置，记录已暂停；请打开设置填写后继续。");
  return true;
}
function tick(skipPet) {
  var now = new Date().getTime();
  pauseForMissingPaidMonth(now);
  if (tracking && bank.settings) {
    if (alivePath && now - lastHeartbeat >= 5000) {
      if (!writePath(alivePath, "alive", false)) stopMonitor();
      lastHeartbeat = now;
    }
    var sample = readSample(now), elapsed = now - lastTick;
    monitorReady = !!sample;
    monitorIdle = !!sample && sample.idle >= IDLE_LIMIT;
    if (sample && previousInput !== null && elapsed > 0 && elapsed <= MAX_TICK_GAP && !sessionLocked) {
      var ranges = bankActiveRanges(lastTick, now, previousInput, sample.input, IDLE_LIMIT), addedSeconds = 0;
      for (var i = 0; i < ranges.length; i++) {
        addedSeconds += addActivity(ranges[i].start, ranges[i].end);
      }
      var reminderMinutes = bankRestReminder(bank.settings);
      var reminder = bankReminderProgress(restReminderActiveSeconds, addedSeconds, reminderMinutes);
      restReminderActiveSeconds = reminder.seconds;
      if (reminder.notify) restReminderPending = true;
      if (restReminderPending && reminderMinutes > 0) {
        if (restReminderSnoozeSeconds > 0) restReminderSnoozeSeconds = bankReminderSnoozeProgress(restReminderSnoozeSeconds, addedSeconds);
        if (restReminderSnoozeSeconds === 0) {
          restReminderPending = false;
          showToast("已累计记录约 " + reminderMinutes + " 分钟，喝口水、活动一下也很好。Alt+R 或小鲸右键菜单可稍后 15 分钟提醒。");
        }
      }
    }
    previousInput = sample ? sample.input : null;
    lastTick = now;
    if (dirty && now - lastSave >= 5000) { saveBank(); lastSave = now; }
    var d = new Date(now), key = hourKey(d);
    if (key !== lastHour) {
      if (d.getMinutes() === 0 && monitorReady && bank.settings.announce) {
        showToast(masked ? "又走过一个整点，活跃工时已记账。" :
          (bankIsRestDay(currentDay(now)) ? "今天是休息日，活跃时间仅记录加班。" : "时薪参考 " + money(currentDay(now).hourlyRate) + "；仅活跃时间计入。"));
      }
      lastHour = key;
    }
  }
  render(now);
  if (skipPet !== true) petTick();
}
function startTracking() {
  if (fatalStorage) { alert(storageProblem); return; }
  if (!bank.settings) { openSettings(); return; }
  if (bankCalcMode(bank.settings) === "days" && bankPaidDays(bank.settings, bankDate(new Date().getTime()).substring(0, 7)) === null) {
    openSettings();
    showToast("请先填写本月计薪天数，保存后再开始记录。");
    return;
  }
  if (sessionLocked && bankLockMode(bank.settings) !== "off") { showToast("Windows 仍处于锁屏状态，解锁后再开始记录。"); return; }
  if (bankLockMode(bank.settings) !== "off" && (!sessionMonitorReady || sessionMonitorFailed)) {
    if (sessionMonitorFailed) { showToast("锁屏监测不可用；请重试小鲸，或在设置里关闭锁屏暂停后再记录。"); return; }
    startWhenSessionReady = true;
    if (!petStarting && !petRunning) startPet();
    showToast("正在连接锁屏监测；连接成功前不会开始计时。");
    return;
  }
  startWhenSessionReady = false;
  tracking = true;
  signedOff = false;
  lastTick = new Date().getTime();
  lastSave = lastTick;
  lastHour = hourKey(new Date(lastTick));
  startMonitor();
  render(lastTick);
}
function pauseTracking() {
  if (!tracking) return;
  tick(true);
  tracking = false;
  stopMonitor();
  if (dirty) saveBank();
  render(new Date().getTime());
}
function copyPlanMap(source) {
  var result = {};
  if (!source) return result;
  for (var key in source) if (Object.prototype.hasOwnProperty.call(source, key)) result[key] = source[key];
  return result;
}
function bankNextMonthKey(month) {
  var parts = month.split("-"), date = new Date(Number(parts[0]), Number(parts[1]), 1);
  return date.getFullYear() + "-" + pad(date.getMonth() + 1);
}
function planInputNumber(value) {
  var raw = String(value).replace(/^\s+|\s+$/g, "");
  return /^\d+(?:\.\d{1,2})?$/.test(raw) ? Number(raw) : NaN;
}
function syncCalculationFields() {
  var dayMode = $id("inCalculationMode").value === "days";
  $id("monthHoursField").className = "field" + (dayMode ? " hidden" : "");
  $id("dayHoursField").className = "field" + (dayMode ? " hidden" : "");
  $id("dayModeFields").className = "field goal-field" + (dayMode ? "" : " hidden");
}
function renderDayOverrides() {
  var today = bankDate(new Date().getTime()), dates = [], labels = [];
  for (var key in draftDayOverrides) {
    if (Object.prototype.hasOwnProperty.call(draftDayOverrides, key) && key >= today) dates.push(key);
  }
  dates.sort();
  for (var i = 0; i < dates.length && i < 10; i++) {
    var hours = draftDayOverrides[dates[i]];
    labels.push((dates[i] === today ? "今天" : dates[i]) + "：" + (hours === 0 ? "休息日" : hours + " 小时"));
  }
  if (dates.length > 10) labels.push("另有 " + (dates.length - 10) + " 项未列出");
  text("overrideSummary", labels.length ? "已设置：" + labels.join("；") : "暂无今天或未来的单日例外。");
}
function changeDayOverride(remove) {
  var date = String($id("inOverrideDate").value).replace(/^\s+|\s+$/g, "");
  var today = bankDate(new Date().getTime());
  if (!bankValidDate(date) || date < today) { alert("请选择今天或之后的有效日期（YYYY-MM-DD）；历史日期保持原口径。"); return; }
  if (remove) delete draftDayOverrides[date];
  else {
    var hours = planInputNumber($id("inOverrideHours").value);
    if (!bankValidPlanHours(hours)) { alert("请输入 0–24 小时，最多两位小数；0 表示休息日。"); return; }
    draftDayOverrides[date] = hours;
  }
  renderDayOverrides();
}
function openSettings() {
  if (fatalStorage) { alert(storageProblem); return; }
  showThemeMenu(false);
  if (petRunning && !petPanelVisible) {
    petPanelVisible = true;
    showPanelNearPet();
  }
  var s = bank.settings;
  $id("inSalary").value = s ? s.salary : "";
  $id("inMonthHours").value = s ? s.monthHours : "174";
  $id("inDayHours").value = s ? s.dayHours : "8";
  $id("inCalculationMode").value = bankCalcMode(s);
  settingsMonthKey = bankDate(new Date().getTime()).substring(0, 7);
  settingsNextMonthKey = bankNextMonthKey(settingsMonthKey);
  text("paidMonthLabel", settingsMonthKey + " ");
  text("nextPaidMonthLabel", settingsNextMonthKey + " ");
  var paid = bankPaidDays(s, settingsMonthKey), nextPaid = bankPaidDays(s, settingsNextMonthKey);
  $id("inPaidDays").value = paid === null ? "" : String(paid);
  $id("inNextPaidDays").value = nextPaid === null ? "" : String(nextPaid);
  var week = bankWeekHours(s);
  for (var i = 0; i < 7; i++) $id("week" + i).value = String(week[i]);
  draftDayOverrides = copyPlanMap(s && s.dayOverrides);
  $id("inOverrideDate").value = bankDate(new Date().getTime());
  var todayPlan = draftDayOverrides[$id("inOverrideDate").value];
  $id("inOverrideHours").value = typeof todayPlan === "number" ? String(todayPlan) : "";
  syncCalculationFields();
  renderDayOverrides();
  $id("inEndTime").value = s ? s.endTime : "18:00";
  $id("inMask").checked = !s || s.maskByDefault !== false;
  $id("inAnnounce").checked = !s || s.announce !== false;
  $id("inMotion").checked = !s || s.motion !== false;
  $id("inMiniMode").value = bankMiniMode(s || {});
  $id("inAutoLaunch").checked = !!(s && s.autoLaunch === true);
  $id("inLockMode").value = bankLockMode(s || {});
  $id("inMaskTimeout").value = String(bankMaskTimeout(s || {}));
  $id("inRestReminder").value = String(bankRestReminder(s || {}));
  $id("inAutoStart").checked = !!(s && s.autoStart === true);
  $id("inGoals").value = s && typeof s.customGoals === "string" ? s.customGoals : "";
  showGoalValidation();
  savedThemeAlpha = bankThemeAlpha(s);
  draftThemeAlpha = copyThemeAlpha(savedThemeAlpha);
  settingsEditing = true;
  setTheme(normalizeTheme(s && s.theme), false);
  syncOpacityControl();
  $id("showSalary").checked = false;
  $id("inSalary").type = "password";
  $id("settingsModal").className = "modal";
}
function saveSettings() {
  var chosenTheme = pendingTheme || "deep";
  var alphaDraft = copyThemeAlpha(draftThemeAlpha);
  alphaDraft[chosenTheme] = pendingAlpha;
  var priorPlan = bank.settings, chosenMode = $id("inCalculationMode").value === "days" ? "days" : "hours";
  var settings = {
    salary: Number($id("inSalary").value), monthHours: chosenMode === "days" ? (priorPlan ? priorPlan.monthHours : 174) : Number($id("inMonthHours").value),
    dayHours: chosenMode === "days" ? (priorPlan ? priorPlan.dayHours : 8) : Number($id("inDayHours").value),
    calculationMode: chosenMode, endTime: $id("inEndTime").value.replace(/^\s+|\s+$/g, ""),
    maskByDefault: $id("inMask").checked, announce: $id("inAnnounce").checked, motion: $id("inMotion").checked,
    miniMode: /^(always|hover|off)$/.test($id("inMiniMode").value) ? $id("inMiniMode").value : "always",
    miniInfo: $id("inMiniMode").value !== "off",
    autoStart: $id("inAutoStart").checked,
    autoLaunch: $id("inAutoLaunch").checked,
    lockMode: $id("inLockMode").value,
    maskTimeoutSeconds: Number($id("inMaskTimeout").value),
    restReminderMinutes: Number($id("inRestReminder").value),
    customGoals: $id("inGoals").value.replace(/^\s+|\s+$/g, ""),
    theme: chosenTheme,
    themeAlpha: alphaDraft,
    alwaysOnTop: pinPending ? !!(bank.settings && bank.settings.alwaysOnTop) : pinned,
    petOnTop: petTopMost,
    petX: petPositionX,
    petY: petPositionY
  };
  if (priorPlan && priorPlan.weekHours) settings.weekHours = priorPlan.weekHours.slice(0);
  if (priorPlan && priorPlan.paidDaysByMonth) settings.paidDaysByMonth = copyPlanMap(priorPlan.paidDaysByMonth);
  if (priorPlan && priorPlan.dayOverrides) settings.dayOverrides = copyPlanMap(priorPlan.dayOverrides);
  if (chosenMode === "days") {
    var currentMonth = bankDate(new Date().getTime()).substring(0, 7);
    if (currentMonth !== settingsMonthKey) { alert("月份已变化，请关闭设置并重新打开后填写本月计薪天数。"); return; }
    var currentPaid = planInputNumber($id("inPaidDays").value);
    var nextText = String($id("inNextPaidDays").value).replace(/^\s+|\s+$/g, "");
    var nextPaid = nextText ? planInputNumber(nextText) : null;
    if (!bankValidPaidDays(currentPaid) || (nextText && !bankValidPaidDays(nextPaid))) {
      alert("请填写有效的本月计薪天数（0.01–31，最多两位小数）；下月可以留空。"); return;
    }
    settings.paidDaysByMonth = copyPlanMap(priorPlan && priorPlan.paidDaysByMonth);
    settings.paidDaysByMonth[settingsMonthKey] = currentPaid;
    if (nextText) settings.paidDaysByMonth[settingsNextMonthKey] = nextPaid;
    else delete settings.paidDaysByMonth[settingsNextMonthKey];
    settings.weekHours = [];
    for (var i = 0; i < 7; i++) {
      var hours = planInputNumber($id("week" + i).value);
      if (!bankValidPlanHours(hours)) { alert("请逐一填写周一至周日的计划工时（0–24，最多两位小数）；0 为休息日。"); return; }
      settings.weekHours.push(hours);
    }
    settings.dayOverrides = copyPlanMap(draftDayOverrides);
  }
  if (!bankValidSettings(settings)) {
    alert("请填写有效的到手月薪、月计划工时（不超过 744）、日计划工时（不超过 24）、班次、锁屏策略和提醒间隔。");
    return;
  }
  if (tracking) tick();
  var previousSettings = bank.settings, previousMask = masked, previousDirty = dirty;
  var todayKey = bankDate(new Date().getTime()), day = bank.days[todayKey];
  var snapshot = bankSnapshotForDate(settings, todayKey);
  if (!snapshot) { alert("本月计薪天数未设置；请填写后再保存。"); return; }
  var revaluesToday = !!day && (day.dayHours !== snapshot.dayHours || Math.abs(day.hourlyRate - snapshot.hourlyRate) > 0.00000001);
  if (previousSettings && (bankCalcMode(previousSettings) !== chosenMode || revaluesToday) &&
      !confirm("更改核算方式或今日计划会按新口径重新计算今天的金额和加班；此前日期保持原口径。确定继续吗？")) return;
  var previousAutoLaunch = !!(previousSettings && previousSettings.autoLaunch === true);
  var autoLaunchChanged = settings.autoLaunch !== previousAutoLaunch;
  if (autoLaunchChanged && !setWindowsAutostart(settings.autoLaunch)) {
    alert("登录启动项无法安全创建或删除。已有同名但不属于本程序的快捷方式不会被覆盖；设置没有保存。");
    return;
  }
  var oldLockMode = bankLockMode(previousSettings);
  var resumeAfterLockRegistration = !!(tracking && oldLockMode === "off" && bankLockMode(settings) !== "off");
  var previousDay = day ? JSON.parse(JSON.stringify(day)) : null;
  bank.settings = settings;
  if (day) applyDaySnapshot(day, snapshot);
  masked = settings.maskByDefault;
  dirty = true;
  if (!saveBank()) {
    bank.settings = previousSettings;
    if (day) bank.days[todayKey] = previousDay;
    masked = previousMask;
    dirty = previousDirty;
    if (autoLaunchChanged && !setWindowsAutostart(previousAutoLaunch)) showToast("记录保存失败，登录启动快捷方式也未能恢复；请检查 Windows 启动文件夹。");
    settingsEditing = true;
    draftThemeAlpha = copyThemeAlpha(savedThemeAlpha);
    setTheme(normalizeTheme(previousSettings && previousSettings.theme), false);
    alert(storageProblem);
    render(new Date().getTime());
    return;
  }
  savedThemeAlpha = copyThemeAlpha(alphaDraft);
  theme = chosenTheme;
  pendingTheme = chosenTheme;
  activeAlpha = savedThemeAlpha[chosenTheme];
  pendingAlpha = activeAlpha;
  settingsEditing = false;
  $id("settingsModal").className = "modal hidden";
  var nextLockMode = bankLockMode(settings);
  if (nextLockMode === "off") {
    sessionMonitorReady = true;
    sessionMonitorFailed = false;
    sessionLocked = false;
    lockPausedTracking = false;
    startWhenSessionReady = false;
  } else if (nextLockMode !== oldLockMode) {
    sessionMonitorReady = false;
    sessionMonitorFailed = false;
  }
  scheduleAutomaticMask();
  if (settings.restReminderMinutes === 0) {
    restReminderActiveSeconds = 0;
    restReminderPending = false;
    restReminderSnoozeSeconds = 0;
  }
  if (settings.autoLaunch && !autoLaunchChanged && !setWindowsAutostart(true)) showToast("已保存设置，但 Windows 登录启动快捷方式缺失或与其他快捷方式冲突。");
  if (settings.customGoals && !bankGoalCustom(settings.customGoals)) showToast("自定义目标至少需要 3 个有效项，暂用内置目标。");
  if (!previousSettings) startTracking();
  else if (resumeAfterLockRegistration) {
    pauseTracking();
    startWhenSessionReady = true;
    if (!petStarting && !petRunning) startPet();
    showToast("正在启用锁屏保护；监测就绪前不会继续计时。");
  } else render(new Date().getTime());
  applyTheme();
  applyWindowChrome();
}
function cancelSettings() {
  settingsEditing = false;
  draftThemeAlpha = copyThemeAlpha(savedThemeAlpha);
  setTheme(normalizeTheme(bank.settings && bank.settings.theme), false);
  syncOpacityControl();
  $id("settingsModal").className = "modal hidden";
}
function signOff() {
  if (!bank.settings) { openSettings(); return; }
  if (tracking) pauseTracking();
  signedOff = true;
  celebrateUntil = new Date().getTime() + 6000;
  var now = new Date().getTime(), day = currentDay(now), month = bankMonth(bank.days, bankDate(now).substring(0, 7));
  text("receiptDate", bankDate(now));
  text("receiptActive", duration(day.activeSeconds));
  text("receiptOvertime", duration(bankOvertime(day)));
  receiptDayAmount = bankDayAmount(day);
  receiptMonthAmount = month.amount;
  text("receiptAmount", money(receiptDayAmount));
  text("receiptMonth", money(receiptMonthAmount));
  text("receiptNote", storageProblem ? "注意：本机保存失败，记录暂留内存。请先检查写入权限。" : "人已下班，未完的事明天再说。记录只保存在本机。");
  $id("receiptModal").className = "modal";
  render(now);
}
function renderHistory() {
  var keys = [], rows = "", bars = "", month = historySelectedMonth;
  var year = Number(month.substring(0, 4)), monthNumber = Number(month.substring(5, 7));
  var daysInMonth = new Date(year, monthNumber, 0).getDate(), maxSeconds = 0;
  for (var key in bank.days) {
    if (Object.prototype.hasOwnProperty.call(bank.days, key) && /^\d{4}-\d{2}-\d{2}$/.test(key) && key.substring(0, 7) === month) {
      keys.push(key);
      maxSeconds = Math.max(maxSeconds, bank.days[key].activeSeconds);
    }
  }
  for (var dayNumber = 1; dayNumber <= daysInMonth; dayNumber++) {
    var date = month + "-" + pad(dayNumber), record = bank.days[date];
    var seconds = record ? record.activeSeconds : 0;
    var height = maxSeconds > 0 ? Math.round(seconds / maxSeconds * 100) : 0;
    var label = date + (record ? " 活跃 " + duration(seconds) : " 暂无记录");
    bars += "<button type='button' class='month-bar' title='" + label + "' aria-label='" + label + "'>" +
      "<span class='month-bar-fill' style='height:" + height + "%'></span>" +
      "<span class='month-bar-day'>" + (dayNumber === 1 || dayNumber % 5 === 0 || dayNumber === daysInMonth ? dayNumber : "") + "</span></button>";
  }
  keys.sort(); keys.reverse();
  for (var i = 0; i < keys.length; i++) {
    var day = bank.days[keys[i]];
    var modeLabel = day.calculationMode === "days" ?
      (day.manualOnly && typeof day.paidDays === "undefined" ? "按天 · 未设班次" : (bankIsRestDay(day) ? "按天 · 休息日" : "按天")) : "按时";
    rows += "<tr><td>" + keys[i] + "<span class='history-mode'>" + modeLabel + "</span></td><td>" + duration(day.activeSeconds) + "</td><td>" + duration(bankManualMinutes(day) * 60) +
      "</td><td>" + duration(bankOvertime(day)) + "</td><td>" + money(bankDayAmount(day)) + "</td></tr>";
  }
  text("historyMonth", month);
  text("historyScale", "每日活跃工时 · 峰值 " + (maxSeconds / 3600).toFixed(2) + " 小时；悬停或聚焦查看详情");
  $id("monthChart").innerHTML = bars;
  $id("historyBody").innerHTML = rows || "<tr><td colspan='5' style='text-align:center'>本月暂无记录</td></tr>";
}
function csvCell(value) {
  var textValue = String(value === null || typeof value === "undefined" ? "" : value);
  return '"' + textValue.replace(/"/g, '""') + '"';
}
function bankCsvText(data) {
  var rows = [["日期", "活跃秒数", "活跃工时", "补记分钟", "补记明细", "加班秒数", "当日投入（元）", "时薪", "计划日工时", "核算方式", "本月计薪天数", "计薪日参考金额（元）"]];
  var keys = [];
  for (var key in data.days) if (Object.prototype.hasOwnProperty.call(data.days, key)) keys.push(key);
  keys.sort();
  for (var i = 0; i < keys.length; i++) {
    var day = data.days[keys[i]], entries = day.manualEntries || [], details = [];
    for (var j = 0; j < entries.length; j++) details.push(entries[j].kind + ":" + entries[j].minutes + "分钟");
    rows.push([keys[i], day.activeSeconds.toFixed(2), (day.activeSeconds / 3600).toFixed(4), bankManualMinutes(day),
      details.join("；"), bankOvertime(day).toFixed(2), bankDayAmount(day).toFixed(2), day.hourlyRate.toFixed(6), day.dayHours,
      day.calculationMode === "days" ? "按天" : "按时", typeof day.paidDays === "number" ? day.paidDays : "",
      typeof day.dailyAmount === "number" ? day.dailyAmount.toFixed(2) : ""]);
  }
  var output = [];
  for (var r = 0; r < rows.length; r++) {
    var cells = [];
    for (var c = 0; c < rows[r].length; c++) cells.push(csvCell(rows[r][c]));
    output.push(cells.join(","));
  }
  return output.join("\r\n");
}
function writeDataExport(path, kind) {
  if (kind !== "json" && kind !== "csv") return false;
  var extension = kind === "json" ? /\.json$/i : /\.csv$/i;
  if (!extension.test(path)) { alert("请选择 ." + kind + " 文件名。"); return false; }
  try {
    var fso = new ActiveXObject("Scripting.FileSystemObject");
    if (sameWindowsPath(path, appPath(DATA_FILE)) || sameWindowsPath(path, appPath(BACKUP_FILE)) || sameWindowsPath(path, appPath(TEMP_FILE))) {
      alert("导出文件不能指向程序正在使用的账本文件。"); return false;
    }
    if (fso.FileExists(path)) { alert("该文件已存在，为保护已有文件，本次没有覆盖；请另选文件名。"); return false; }
    var content = kind === "json" ? JSON.stringify(bank, null, 2) : bankCsvText(bank);
    var file = fso.CreateTextFile(path, false, true);
    try { file.Write(content); file.Close(); }
    catch (writeError) { try { file.Close(); } catch (closeError) {} deletePath(path); throw writeError; }
    showToast(kind === "json" ? "完整 JSON 备份已写入所选位置。" : "CSV 已导出；内容含每日金额等敏感信息。");
    return true;
  } catch (e) {
    alert("导出未完成；原账本未修改。请检查目标目录权限并重试。");
    return false;
  }
}
function clearExportChoice() {
  if (exportDialogTimer) clearTimeout(exportDialogTimer);
  exportDialogTimer = null;
  try { if (exportDialogProcess && exportDialogProcess.Status === 0) exportDialogProcess.Terminate(); } catch (e) {}
  exportDialogProcess = null;
  deletePath(exportDialogPath);
  exportDialogPath = "";
  exportDialogKind = "";
  exportDialogStarted = 0;
}
function checkExportChoice(path, kind, started) {
  var result = readPath(path, true);
  if (result) {
    if (result !== "CANCEL") writeDataExport(result, kind);
    clearExportChoice();
    return;
  }
  if (new Date().getTime() - started >= 120000) {
    showToast("文件选择窗口未返回结果；没有导出文件。");
    clearExportChoice();
    return;
  }
  exportDialogTimer = setTimeout(function () { checkExportChoice(path, kind, started); }, 300);
}
function chooseDataExport(kind) {
  if (exportDialogPath) { showToast("已有文件选择窗口打开。"); return; }
  if (kind !== "json" && kind !== "csv") return;
  var warning = kind === "json" ?
    "完整 JSON 备份包含月薪设置和每日记录，只保存到你选定的本机文件；请妥善保管。继续选择位置吗？" :
    "CSV 包含每日投入、加班和计算用时薪等敏感信息，但不含原始键鼠内容。文件只写入你选定的位置，且不会覆盖已有文件。继续吗？";
  if (!confirm(warning)) return;
  try {
    var fso = new ActiveXObject("Scripting.FileSystemObject"), shell = new ActiveXObject("WScript.Shell");
    var temp = fso.GetSpecialFolder(2).Path;
    exportDialogPath = temp + "\\WorkBankExportChoice-" + new Date().getTime() + "-" + Math.floor(Math.random() * 1000000) + ".result";
    exportDialogKind = kind;
    exportDialogStarted = new Date().getTime();
    var title = kind === "json" ? "选择完整工时账本备份位置" : "选择工时记录 CSV 导出位置";
    var filter = kind === "json" ? "JSON 备份 (*.json)|*.json" : "CSV 表格 (*.csv)|*.csv";
    var stamp = new Date(), fileStamp = bankDate(stamp.getTime()).replace(/-/g, "") + "-" + pad(stamp.getHours()) + pad(stamp.getMinutes()) + pad(stamp.getSeconds());
    var fileName = (kind === "json" ? "workbank-backup-" : "workbank-records-") + fileStamp + "." + kind;
    var script = "$ErrorActionPreference='Stop';Add-Type -AssemblyName System.Windows.Forms;" +
      "$d=New-Object System.Windows.Forms.SaveFileDialog;$d.Title=" + psQuote(title) + ";$d.Filter=" + psQuote(filter) + ";" +
      "$d.DefaultExt=" + psQuote(kind) + ";$d.AddExtension=$true;$d.OverwritePrompt=$false;$d.CheckPathExists=$true;" +
      "$d.RestoreDirectory=$true;$d.FileName=" + psQuote(fileName) + ";" +
      "if($d.ShowDialog() -eq [System.Windows.Forms.DialogResult]::OK){[IO.File]::WriteAllText(" + psQuote(exportDialogPath) + ",$d.FileName,[Text.Encoding]::Unicode)}" +
      "else{[IO.File]::WriteAllText(" + psQuote(exportDialogPath) + ",'CANCEL',[Text.Encoding]::Unicode)}";
    var exe = shell.ExpandEnvironmentStrings("%SystemRoot%\\System32\\WindowsPowerShell\\v1.0\\powershell.exe");
    exportDialogProcess = shell.Exec('"' + exe + '" -NoLogo -NoProfile -NonInteractive -Sta -WindowStyle Hidden -Command "' + script + '"');
    checkExportChoice(exportDialogPath, kind, exportDialogStarted);
  } catch (e) {
    clearExportChoice();
    alert("无法打开系统文件选择窗口。原账本没有变化。");
  }
}
function showHistory() {
  historySelectedMonth = bankDate(new Date().getTime()).substring(0, 7);
  renderHistory();
  $id("historyModal").className = "modal";
}
function moveHistoryMonth(delta) {
  var year = Number(historySelectedMonth.substring(0, 4)), month = Number(historySelectedMonth.substring(5, 7));
  var date = new Date(year, month - 1 + delta, 1);
  historySelectedMonth = date.getFullYear() + "-" + pad(date.getMonth() + 1);
  renderHistory();
}
function renderManual() {
  var date = $id("manualDate").value.replace(/^\s+|\s+$/g, ""), day = bank.days[date], html = "";
  var entries = day && day.manualEntries ? day.manualEntries : [];
  for (var i = 0; i < entries.length; i++) {
    html += "<div class='manual-item'>" + entries[i].kind + " · " + entries[i].minutes +
      " 分钟<button type='button' class='btn btn-quiet' data-manual-index='" + i + "'>删除</button></div>";
  }
  text("manualSummary", bankValidDate(date) ? "该日补记 " + bankManualMinutes(day) + " 分钟；不计入活跃、投入或加班。" : "请输入有效日期，例如 2026-01-31。");
  $id("manualList").innerHTML = html || "<div>该日暂无补记。</div>";
}
function openManual() {
  if (fatalStorage) { alert(storageProblem); return; }
  if (!bank.settings) { openSettings(); return; }
  $id("manualDate").value = bankDate(new Date().getTime());
  $id("manualMinutes").value = "";
  $id("manualKind").value = "会议";
  renderManual();
  $id("manualModal").className = "modal";
}
function saveManual() {
  var date = $id("manualDate").value.replace(/^\s+|\s+$/g, ""), raw = $id("manualMinutes").value.replace(/^\s+|\s+$/g, "");
  var minutes = Number(raw), kind = $id("manualKind").value, today = bankDate(new Date().getTime());
  if (!bank.settings || fatalStorage) { alert(storageProblem || "请先设置班表。"); return false; }
  if (!bankValidDate(date) || date > today || !/^\d+$/.test(raw) || minutes < 1 || minutes > 1440 ||
      (kind !== "会议" && kind !== "阅读资料" && kind !== "其他")) {
    alert("请填写有效的过去或今天日期、1–1440 分钟整数及时长类型。"); return false;
  }
  var previous = bank.days[date], previousDirty = dirty;
  if (bankManualMinutes(previous) + minutes > 1440) { alert("同一天的补记不能超过 1440 分钟。"); return false; }
  var day = previous || { activeSeconds: 0, manualOnly: true };
  if (!previous) {
    var snapshot = bankSnapshotForDate(bank.settings, date);
    if (!snapshot) snapshot = { calculationMode: "days", hourlyRate: 0, dayHours: 0 };
    applyDaySnapshot(day, snapshot);
  }
  var oldEntries = day.manualEntries;
  day.manualEntries = oldEntries ? oldEntries.slice(0) : [];
  day.manualEntries.push({ minutes: minutes, kind: kind });
  bank.days[date] = day;
  dirty = true;
  if (!saveBank()) {
    if (!previous) delete bank.days[date]; else if (oldEntries) day.manualEntries = oldEntries; else delete day.manualEntries;
    dirty = previousDirty;
    alert(storageProblem); return false;
  }
  $id("manualMinutes").value = "";
  renderManual();
  render(new Date().getTime());
  return true;
}
function deleteManual(date, index) {
  var day = bank.days[date];
  if (!bankValidDate(date) || !day || !day.manualEntries || index < 0 || index >= day.manualEntries.length || Math.floor(index) !== index) return false;
  var previous = day.manualEntries, previousDirty = dirty;
  day.manualEntries = previous.slice(0);
  day.manualEntries.splice(index, 1);
  var removeDay = day.manualOnly === true && day.activeSeconds === 0 && day.manualEntries.length === 0;
  if (removeDay) delete bank.days[date];
  dirty = true;
  if (!saveBank()) {
    bank.days[date] = day; day.manualEntries = previous; dirty = previousDirty;
    alert(storageProblem); return false;
  }
  renderManual();
  render(new Date().getTime());
  return true;
}

$id("btnPetRetry").onclick = function () { startPet(); };
$id("btnTheme").onclick = function (event) {
  event = event || window.event;
  showThemeMenu($id("themeMenu").className !== "theme-menu");
  if (event) {
    event.cancelBubble = true;
    if (event.stopPropagation) event.stopPropagation();
  }
};
$id("themePickDeep").onclick = function () { pickTheme("deep"); };
$id("themePickCream").onclick = function () { pickTheme("cream"); };
$id("themePickGlass").onclick = function () { pickTheme("glass"); };
document.onclick = function (event) {
  event = event || window.event;
  var target = event && (event.target || event.srcElement), menu = $id("themeMenu");
  if (target === $id("btnTheme") || target === menu || (target && target.parentNode === menu)) return;
  showThemeMenu(false);
};
$id("btnPin").onclick = function () { requestPin(!pinned, true); };
function refreshPrivacyViews() {
  var now = new Date().getTime();
  render(now);
  if ($id("historyModal").className === "modal" && historySelectedMonth) renderHistory();
  if ($id("receiptModal").className === "modal") {
    text("receiptAmount", money(receiptDayAmount));
    text("receiptMonth", money(receiptMonthAmount));
  }
  writePetState();
}
function scheduleAutomaticMask() {
  if (autoMaskTimer) clearTimeout(autoMaskTimer);
  autoMaskTimer = null;
  var seconds = bankMaskTimeout(bank.settings);
  if (masked || !seconds) return;
  autoMaskTimer = setTimeout(function () {
    autoMaskTimer = null;
    if (!masked) applyPrivacyState(true);
  }, seconds * 1000);
}
function applyPrivacyState(value) {
  masked = !!value;
  if (masked) $id("toast").className = "toast hidden";
  refreshPrivacyViews();
  scheduleAutomaticMask();
}
function togglePrivacy() {
  applyPrivacyState(!masked);
}
$id("btnPrivacy").onclick = togglePrivacy;
$id("todayAmount").onclick = togglePrivacy;
$id("monthAmount").onclick = togglePrivacy;
$id("btnTrack").onclick = function () { if (tracking) pauseTracking(); else startTracking(); };
$id("btnSettings").onclick = openSettings;
$id("btnSaveSettings").onclick = saveSettings;
$id("btnCancelSettings").onclick = cancelSettings;
$id("inCalculationMode").onchange = syncCalculationFields;
$id("btnSetOverride").onclick = function () { changeDayOverride(false); };
$id("btnClearOverride").onclick = function () { changeDayOverride(true); };
$id("inOverrideDate").onchange = function () {
  var date = String(this.value).replace(/^\s+|\s+$/g, "");
  $id("inOverrideHours").value = Object.prototype.hasOwnProperty.call(draftDayOverrides, date) ? String(draftDayOverrides[date]) : "";
};
$id("inOpacity").oninput = function () { previewOpacity(this.value); };
$id("inOpacity").onchange = function () { previewOpacity(this.value); };
function modalVisible() {
  var ids = ["settingsModal", "receiptModal", "historyModal", "manualModal"];
  for (var i = 0; i < ids.length; i++) if ($id(ids[i]).className === "modal") return true;
  return false;
}
function closeTopModal() {
  var ids = ["settingsModal", "receiptModal", "historyModal", "manualModal"];
  for (var i = 0; i < ids.length; i++) {
    if ($id(ids[i]).className !== "modal") continue;
    if (ids[i] === "settingsModal") cancelSettings();
    else $id(ids[i]).className = "modal hidden";
    return true;
  }
  return false;
}
function hideViaPet() {
  if (!petRunning) { showToast("小鲸桌宠未在运行，暂时无法快捷收起卡片。"); return; }
  handlePetEvent("hide");
}
function shortcutFieldTarget(target) {
  var tag = target && target.tagName ? String(target.tagName).toUpperCase() : "";
  return tag === "INPUT" || tag === "TEXTAREA" || tag === "SELECT";
}
/* Esc 关闭当前弹窗；Alt+M 打码、Alt+T 计时、Alt+S 设置、Alt+H 经桌宠收起卡片。 */
function handleShortcut(event) {
  event = event || window.event;
  var keyCode = event.keyCode || event.which || 0, target = event.target || event.srcElement;
  if (keyCode === 27) {
    if ($id("themeMenu").className === "theme-menu") {
      showThemeMenu(false);
      if (event.preventDefault) event.preventDefault();
      event.returnValue = false;
      return false;
    }
    if (!modalVisible()) return true;
    closeTopModal();
    if (event.preventDefault) event.preventDefault();
    event.returnValue = false;
    return false;
  }
  if (!event.altKey || shortcutFieldTarget(target)) return true;
  if (keyCode === 77) togglePrivacy();
  else if (keyCode === 84) {
    if (tracking) pauseTracking(); else startTracking();
  } else if (keyCode === 83) {
    if (!modalVisible()) openSettings();
  } else if (keyCode === 72) {
    if (!modalVisible()) hideViaPet();
  } else if (keyCode === 82) {
    snoozeRestReminder();
  } else return true;
  if (event.preventDefault) event.preventDefault();
  event.returnValue = false;
  return false;
}
document.onkeydown = handleShortcut;
$id("showSalary").onclick = function () { $id("inSalary").type = this.checked ? "text" : "password"; };
$id("btnSign").onclick = signOff;
$id("btnCloseReceipt").onclick = function () { $id("receiptModal").className = "modal hidden"; };
$id("btnHistory").onclick = showHistory;
$id("btnBackup").onclick = function () { chooseDataExport("json"); };
$id("btnExportCsv").onclick = function () { chooseDataExport("csv"); };
$id("btnPrevMonth").onclick = function () { moveHistoryMonth(-1); };
$id("btnNextMonth").onclick = function () { moveHistoryMonth(1); };
$id("btnCloseHistory").onclick = function () { $id("historyModal").className = "modal hidden"; };
$id("btnManual").onclick = openManual;
$id("btnSaveManual").onclick = saveManual;
$id("btnCloseManual").onclick = function () { $id("manualModal").className = "modal hidden"; };
$id("manualDate").oninput = renderManual;
$id("manualDate").onkeyup = renderManual;
$id("manualList").onclick = function (event) {
  event = event || window.event;
  var target = event.target || event.srcElement, value = target && target.getAttribute("data-manual-index");
  if (value !== null && /^\d+$/.test(String(value)) && confirm("确定删除这条手动补记吗？")) deleteManual($id("manualDate").value.replace(/^\s+|\s+$/g, ""), Number(value));
};
$id("inGoals").oninput = showGoalValidation;
$id("inGoals").onkeyup = showGoalValidation;
window.onload = function () {
  try {
    var width = Math.min(530, screen.availWidth), height = Math.min(720, screen.availHeight);
    window.resizeTo(width, height);
    window.moveTo(Math.max(0, screen.availWidth - width - 16), Math.max(0, Math.min(40, screen.availHeight - height)));
  } catch (e) {}
  loadBank();
  sessionMonitorReady = bankLockMode(bank.settings) === "off";
  sessionMonitorFailed = false;
  sessionLocked = false;
  lockPausedTracking = false;
  startWhenSessionReady = false;
  restReminderActiveSeconds = 0;
  restReminderPending = false;
  restReminderSnoozeSeconds = 0;
  setTheme(theme, false);
  syncOpacityControl();
  render(new Date().getTime());
  scheduleAutomaticMask();
  renderPin();
  setInterval(tick, 250);
  if (bank.settings && bank.settings.autoLaunch === true && !setWindowsAutostart(true)) showToast("无法确认登录启动快捷方式；请检查 Windows 启动文件夹。");
  if (bank.settings && bank.settings.alwaysOnTop === true) requestPin(true, false);
  if (!bank.settings && !fatalStorage) openSettings();
  if (bank.settings && bank.settings.autoStart === true && !fatalStorage) startTracking();
  startPet();
};
window.onunload = function () {
  if (tracking) pauseTracking();
  else if (dirty) saveBank();
  stopMonitor();
  stopPet();
  if (pinTimer) clearTimeout(pinTimer);
  if (chromeTimer) clearTimeout(chromeTimer);
  if (autoMaskTimer) clearTimeout(autoMaskTimer);
  if (exportDialogPath) clearExportChoice();
  else if (exportDialogTimer) clearTimeout(exportDialogTimer);
  deletePath(pinResultPath);
  deletePath(chromeGatePath);
};
</script>
</body>
</html>
