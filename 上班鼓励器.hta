<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta http-equiv="x-ua-compatible" content="ie=edge">
<title>上班鼓励器 · 工时银行</title>
<hta:application
  id="app"
  applicationname="WorkEncourager"
  border="thin"
  caption="yes"
  showintaskbar="yes"
  singleinstance="yes"
  sysmenu="yes"
  windowstate="normal"
  maximizebutton="no"
  navigable="no"
  contextmenu="no" />
<style>
  * { box-sizing: border-box; }
  html, body { margin: 0; min-height: 100%; }
  body {
    font-family: "Microsoft YaHei", sans-serif;
    color: #e9e7df;
    background: #10151a;
    background-image: radial-gradient(ellipse at 86% 0%, #293233 0%, transparent 48%),
      repeating-linear-gradient(0deg, rgba(255,255,255,.012) 0, rgba(255,255,255,.012) 1px, transparent 1px, transparent 5px);
    cursor: default;
  }
  button, input { font-family: "Microsoft YaHei", sans-serif; }
  button { cursor: pointer; }
  button:focus, input:focus { outline: 2px solid #d5b879; outline-offset: 2px; }
  .hidden { display: none !important; }
  .shell { width: auto; max-width: 510px; margin: 0 auto; padding: 18px 16px 22px; }
  .top { height: 57px; position: relative; }
  .eyebrow { color: #b99d69; font: bold 9px Consolas, monospace; letter-spacing: 2px; }
  h1 { margin: 5px 0 0; font-family: SimSun, serif; font-size: 25px; letter-spacing: 4px; }
  .pin { position: absolute; right: 0; top: 8px; padding: 7px 10px; border: 1px solid #5b6a60; background: #202b27; color: #d6dfd3; font-size: 12px; }
  .pin:hover, .pin.on { border-color: #d4b77c; color: #f1d9ac; }
  .pin.on { background: #403a29; }
  .pin[disabled] { color: #9ba69d; cursor: wait; }
  .card { position: relative; padding: 19px 20px 16px; background: #1b2226; border: 1px solid #43504c; box-shadow: 0 14px 32px rgba(0,0,0,.3); }
  .card:before { content: ""; position: absolute; top: -1px; left: 20px; width: 52px; height: 3px; background: #d4b77c; }
  .card-top { height: 29px; }
  .status { display: inline-block; padding: 5px 10px; color: #c7d7ca; background: #2b3d37; border: 1px solid #405a4f; font-size: 12px; letter-spacing: 1px; }
  .status.off { color: #a4adaa; background: #2a3032; border-color: #414849; }
  .status.overtime { color: #f1c38b; background: #503a27; border-color: #795a39; }
  .date { margin-left: 8px; color: #9da6a2; font-size: 12px; }
  .privacy { float: right; padding: 5px 10px; border: 1px solid #68746d; background: transparent; color: #d3d8d1; font-size: 12px; }
  .privacy:hover, .btn-quiet:hover { border-color: #d4b77c; color: #ead5ab; }
  .label { margin-top: 16px; color: #a8b2ab; font-size: 12px; letter-spacing: 3px; }
  .amount { margin: 5px 0 2px; color: #f1debb; font: bold 48px Consolas, monospace; letter-spacing: -2px; line-height: 1.1; }
  .caption { min-height: 20px; color: #aab4ac; font-size: 12px; }
  .progress-head { margin-top: 16px; color: #cdd3c9; font-size: 12px; }
  .progress-head .right { float: right; color: #d4b77c; font-family: Consolas, monospace; font-size: 13px; }
  .energy { position: relative; height: 22px; margin-top: 7px; padding-right: 29px; }
  .track { position: relative; top: 7px; height: 10px; background: #0d161b; border: 1px solid #334b50; border-radius: 8px; overflow: hidden; }
  .fill { position: relative; height: 100%; width: 0; border-radius: 8px; transition: width .3s; }
  .fill:after { content: ""; position: absolute; top: 0; right: 0; bottom: 0; left: 0; background: repeating-linear-gradient(115deg, rgba(255,255,255,.25) 0, rgba(255,255,255,.25) 4px, transparent 4px, transparent 15px); animation: energyFlow 1.1s linear infinite; }
  .energy.cool .fill { background: linear-gradient(90deg, #247d90, #7addd0); }
  .energy.warm .fill { background: linear-gradient(90deg, #c57a35, #ffd16c); }
  .energy.hot .fill, .energy.overtime .fill { background: linear-gradient(90deg, #d64930, #ffad3e); }
  .flame-icon { position: absolute; right: 2px; top: 0; width: 18px; height: 22px; transform-origin: 50% 95%; animation: flamePulse 1s ease-in-out infinite alternate; }
  .flame-outer { fill: #6dcbd1; }
  .energy.warm .flame-outer { fill: #f4b050; }
  .energy.hot .flame-outer, .energy.overtime .flame-outer { fill: #ff7037; }
  .flame-inner { fill: #ffe2a0; }
  .energy.paused .fill, .energy.paused .flame-icon { opacity: .45; }
  .energy.paused .fill:after, .energy.paused .flame-icon, .motion-off .fill:after, .motion-off .flame-icon { animation: none; }
  .motion-off .fill { transition: none; }
  @keyframes energyFlow { from { background-position: 0 0; } to { background-position: 32px 0; } }
  @keyframes flamePulse { from { transform: scale(.92,.92); } to { transform: scale(1.06,1.08); } }
  .progress-foot { margin-top: 8px; color: #8f9c94; font-size: 11px; }
  .progress-foot .right { float: right; }
  .rule { height: 1px; margin: 17px 0 15px; background: #414a45; }
  .stat { display: inline-block; vertical-align: top; width: 49%; }
  .stat + .stat { padding-left: 15px; border-left: 1px solid #414a45; }
  .stat-label { color: #9ca99f; font-size: 12px; letter-spacing: 1px; }
  .stat-value { margin-top: 7px; color: #f0ebe0; font: 22px Consolas, monospace; }
  .stat-detail { margin-top: 5px; color: #98a59a; font-size: 11px; }
  .anchor { margin: 17px -20px -16px; padding: 12px 20px; color: #d8c49e; background: #222a29; border-top: 1px solid #39443d; font-family: SimSun, serif; font-size: 13px; line-height: 1.6; }
  .anchor-mark { color: #b99d69; margin-right: 8px; }
  .monitor { margin: 10px 1px 0; color: #a5b1a9; font-size: 11px; line-height: 1.7; }
  .monitor.error { color: #edb080; }
  .monitor button { margin-left: 8px; padding: 2px 7px; border: 1px solid #92764d; color: #edc99b; background: transparent; font-size: 11px; }
  .pet-status { margin: 7px 1px 0; color: #9ccbd3; font-size: 11px; line-height: 1.6; }
  .pet-status.error { color: #edb080; }
  .pet-status button { padding: 2px 7px; margin-left: 5px; border: 1px solid #527c87; color: #d2edf0; background: #1b3038; font-size: 11px; }
  .actions { margin-top: 13px; }
  .btn { display: inline-block; padding: 9px 12px; border: 1px solid transparent; font-size: 12px; letter-spacing: 1px; }
  .btn-primary { color: #19221c; background: #c7d5b8; border-color: #c7d5b8; font-weight: bold; }
  .btn-primary:hover { background: #dce8ce; }
  .btn-stamp { color: #f4e1cb; background: #753b32; border-color: #a76051; }
  .btn-stamp:hover { background: #8c493e; }
  .btn-quiet { color: #c7d0c9; background: transparent; border-color: #52605a; }
  .actions .btn { margin: 0 5px 7px 0; }
  .footnote { margin: 8px 0 0; color: #97a69c; font-size: 11px; line-height: 1.7; }
  .modal { position: fixed; z-index: 10; top: 0; right: 0; bottom: 0; left: 0; overflow-y: auto; background: rgba(5,9,10,.86); }
  .modal-box { width: calc(100% - 36px); max-width: 600px; margin: 35px auto; padding: 28px 32px; color: #e8e8de; background: #1c2526; border: 1px solid #58665a; box-shadow: 0 20px 65px rgba(0,0,0,.55); }
  .modal-kicker { color: #bda372; font: bold 10px Consolas, monospace; letter-spacing: 3px; }
  .modal h2 { margin: 7px 0 7px; font: bold 25px SimSun, serif; letter-spacing: 2px; }
  .modal-intro { color: #aab5ad; font-size: 12px; line-height: 1.7; }
  .fields { margin-top: 20px; }
  .field { display: inline-block; width: 48%; vertical-align: top; margin: 0 1% 16px 0; }
  .field label { display: block; margin-bottom: 7px; color: #bec9bf; font-size: 12px; }
  .field input { width: 100%; padding: 9px 10px; color: #f0eee5; background: #111a1b; border: 1px solid #536259; font-size: 16px; }
  .field .hint { display: block; margin-top: 5px; color: #8e9d92; font-size: 11px; }
  .check { display: block; margin: 10px 0; color: #d2dad0; font-size: 12px; }
  .check input { margin: 0 7px 0 0; vertical-align: middle; }
  .modal-actions { margin-top: 20px; }
  .modal-actions .btn { margin-right: 8px; }
  .receipt { position: relative; margin-top: 18px; padding: 22px 24px; color: #333b32; background: #ede8d9; }
  .receipt-title { color: #6f7668; font: bold 10px Consolas, monospace; letter-spacing: 3px; }
  .receipt h3 { margin: 8px 0 13px; font: bold 23px SimSun, serif; }
  .receipt table { width: 100%; border-collapse: collapse; }
  .receipt td { padding: 8px 0; border-bottom: 1px solid #c9cabb; font-size: 13px; }
  .receipt td:last-child { text-align: right; font-family: Consolas, "Microsoft YaHei", monospace; }
  .seal { width: 175px; margin: 22px 0 4px auto; padding: 8px 4px; border: 3px double #a94c3c; color: #a94c3c; font: bold 14px SimSun, serif; letter-spacing: 2px; text-align: center; transform: rotate(-7deg); }
  .receipt-note { margin: 19px 0 0; color: #6c7669; font-size: 11px; line-height: 1.7; }
  .history-wrap { max-height: 360px; margin-top: 18px; overflow-y: auto; border: 1px solid #44534b; }
  .history { width: 100%; border-collapse: collapse; }
  .history th, .history td { padding: 9px 10px; border-bottom: 1px solid #39473f; text-align: right; font-size: 12px; }
  .history th { color: #abb9ad; font-weight: normal; background: #26312d; }
  .history td { color: #e1e6db; font-family: Consolas, monospace; }
  .history th:first-child, .history td:first-child { text-align: left; }
  .toast { position: fixed; z-index: 20; right: 22px; bottom: 22px; max-width: 300px; padding: 14px 17px; color: #eee8d8; background: #34443b; border-left: 3px solid #d4b77c; box-shadow: 0 8px 24px rgba(0,0,0,.4); font-size: 12px; }
</style>
</head>
<body>
<div class="shell">
  <div class="top">
    <div class="eyebrow">WORK ENCOURAGER / TIME BANK</div>
    <h1>工时银行</h1>
    <button class="pin" id="btnPin" type="button" aria-pressed="false" title="将窗口固定在其他普通窗口前面">置顶窗口</button>
  </div>

  <div class="card" id="bankCard">
    <div class="card-top">
      <span class="status off" id="status">未设置</span><span class="date" id="dateText"></span>
      <button class="privacy" id="btnPrivacy" type="button">显示金额</button>
    </div>
    <div class="label">今 日 投 入</div>
    <div class="amount" id="todayAmount">¥ ****</div>
    <div class="caption" id="todayCaption">先设置到手月薪和计划工时</div>

    <div class="progress-head"><span>今日活跃工时</span><span class="right" id="progressText">0.00 / 8.00 小时 · 0%</span></div>
    <div class="energy cool paused" id="energyMeter">
      <div class="track"><div class="fill" id="progressFill"></div></div>
      <svg class="flame-icon" viewBox="0 0 24 30" aria-hidden="true"><path class="flame-outer" d="M13 1 C14 7 18 9 19 14 C21 21 18 28 12 29 C6 28 3 24 4 18 C4 14 7 11 9 9 C9 13 11 14 12 14 C13 10 12 6 13 1 Z"/><path class="flame-inner" d="M13 15 C16 18 17 21 16 24 C15 27 10 28 8 25 C6 22 8 19 10 17 C10 20 12 20 13 15 Z"/></svg>
    </div>
    <div class="progress-foot"><span id="activeText">已记录 00:00:00</span><span class="right" id="endText">计划下班 --:--</span></div>

    <div class="rule"></div>
    <div class="stat">
      <div class="stat-label">本月累计投入</div>
      <div class="stat-value" id="monthAmount">¥ ****</div>
      <div class="stat-detail" id="monthDetail">仅计算实际记录的日期</div>
    </div>
    <div class="stat">
      <div class="stat-label">本月加班累计</div>
      <div class="stat-value" id="monthOvertime">00:00:00</div>
      <div class="stat-detail" id="leaveDetail">折合 0.0 个标准日</div>
    </div>
    <div class="anchor"><span class="anchor-mark">/</span><span id="anchorText">每一次认真投入，都值得被看见。</span></div>
  </div>

  <div class="monitor" id="monitorText">仅在开启记录且程序运行时统计；2 分钟内有键鼠操作视为活跃。</div>
  <div class="pet-status hidden" id="petStatus"><span id="petStatusText"></span><button id="btnPetRetry" type="button">重试桌宠</button></div>
  <div class="actions">
    <button class="btn btn-primary" id="btnTrack" type="button">开始记录</button>
    <button class="btn btn-stamp" id="btnSign" type="button">今日收工 · 签章</button>
    <button class="btn btn-quiet" id="btnSettings" type="button">设置班表</button>
    <button class="btn btn-quiet" id="btnHistory" type="button">查看记录</button>
  </div>
  <p class="footnote">活跃时长不等于在岗时长；开会、看纸质资料等无键鼠操作的时间可能不计入。<br>加班只记录时长，不增加金额；调休天数仅为折算，实际安排以单位制度为准。</p>
</div>

<div class="modal hidden" id="settingsModal">
  <div class="modal-box">
    <div class="modal-kicker">SETTINGS / 工时账本</div>
    <h2>设置月薪与班表</h2>
    <div class="modal-intro">按到手月薪计算。修改设置会重新计算今天的投入；此前日期保留各自的计算口径。</div>
    <div class="fields">
      <div class="field"><label for="inSalary">到手月薪（元）</label><input id="inSalary" type="password" autocomplete="off"><span class="hint">扣除五险一金和个税后的金额</span></div>
      <div class="field"><label for="inMonthHours">月计划工时（小时）</label><input id="inMonthHours" type="text" value="174"><span class="hint">默认 174，可按实际班表调整</span></div>
      <div class="field"><label for="inDayHours">日计划工时（小时）</label><input id="inDayHours" type="text" value="8"><span class="hint">超过这一时长才记为加班</span></div>
      <div class="field"><label for="inEndTime">计划下班时间</label><input id="inEndTime" type="text" value="18:00"><span class="hint">例如 18:00；只影响状态和倒计时</span></div>
    </div>
    <label class="check"><input id="showSalary" type="checkbox">在此处显示输入的月薪</label>
    <label class="check"><input id="inMask" type="checkbox" checked>每次打开时默认隐藏金额</label>
    <label class="check"><input id="inAnnounce" type="checkbox" checked>记录时在整点显示提醒</label>
    <label class="check"><input id="inMotion" type="checkbox" checked>启用火焰与小鲸动画</label>
    <div class="modal-actions"><button class="btn btn-primary" id="btnSaveSettings" type="button">保存设置</button><button class="btn btn-quiet" id="btnCancelSettings" type="button">取消</button></div>
  </div>
</div>

<div class="modal hidden" id="receiptModal">
  <div class="modal-box">
    <div class="modal-kicker">DAILY RECORD / 今日工单</div>
    <h2>今天，辛苦了。</h2>
    <div class="modal-intro">已暂停记录。需要继续工作时，可随时再次开始。</div>
    <div class="receipt">
      <div class="receipt-title">TIME BANK / DAILY SLIP</div>
      <h3>今日投入记录</h3>
      <table>
        <tr><td>日期</td><td id="receiptDate">--</td></tr>
        <tr><td>活跃工时</td><td id="receiptActive">--</td></tr>
        <tr><td>其中加班</td><td id="receiptOvertime">--</td></tr>
        <tr><td>折合投入</td><td id="receiptAmount">--</td></tr>
        <tr><td>本月累计</td><td id="receiptMonth">--</td></tr>
      </table>
      <div class="seal">已复核 · 准予下班</div>
      <p class="receipt-note" id="receiptNote">人已下班，未完的事明天再说。记录只保存在本机。</p>
    </div>
    <div class="modal-actions"><button class="btn btn-primary" id="btnCloseReceipt" type="button">收好工单</button></div>
  </div>
</div>

<div class="modal hidden" id="historyModal">
  <div class="modal-box">
    <div class="modal-kicker">LOCAL RECORDS / 本机记录</div>
    <h2>每天都算数</h2>
    <div class="modal-intro">按自然日展示实际记录，金额按该日保存的口径计算；没有记录的日期不会补算。</div>
    <div class="history-wrap"><table class="history"><thead><tr><th>日期</th><th>活跃工时</th><th>加班</th><th>投入</th></tr></thead><tbody id="historyBody"></tbody></table></div>
    <div class="modal-actions"><button class="btn btn-primary" id="btnCloseHistory" type="button">关闭</button></div>
  </div>
</div>
<div class="toast hidden" id="toast"></div>

<script id="bank-core" type="text/javascript">
/* 纯计算逻辑：时间以毫秒或秒为单位，金额不提前四舍五入。 */
function bankDayAmount(day) {
  return Math.min(day.activeSeconds / 3600, day.dayHours) * day.hourlyRate;
}
function bankOvertime(day) {
  return Math.max(0, day.activeSeconds - day.dayHours * 3600);
}
function bankMonth(days, month) {
  var result = { amount: 0, activeSeconds: 0, overtimeSeconds: 0, days: 0 };
  for (var key in days) {
    if (Object.prototype.hasOwnProperty.call(days, key) && key.substring(0, 7) === month) {
      result.amount += bankDayAmount(days[key]);
      result.activeSeconds += days[key].activeSeconds;
      result.overtimeSeconds += bankOvertime(days[key]);
      result.days++;
    }
  }
  return result;
}
function bankActiveRanges(start, end, previousInput, latestInput, limit) {
  var candidates = [], result = [], inputs = [previousInput, latestInput];
  if (!(end > start)) return result;
  for (var i = 0; i < inputs.length; i++) {
    if (typeof inputs[i] !== "number" || !isFinite(inputs[i])) continue;
    var a = Math.max(start, inputs[i]);
    var b = Math.min(end, inputs[i] + limit);
    if (b > a) candidates.push({ start: a, end: b });
  }
  candidates.sort(function (a, b) { return a.start - b.start; });
  for (var j = 0; j < candidates.length; j++) {
    var last = result.length ? result[result.length - 1] : null;
    if (last && candidates[j].start <= last.end) last.end = Math.max(last.end, candidates[j].end);
    else result.push(candidates[j]);
  }
  return result;
}
function bankDate(ms) {
  var d = new Date(ms);
  var m = d.getMonth() + 1, day = d.getDate();
  return d.getFullYear() + "-" + (m < 10 ? "0" : "") + m + "-" + (day < 10 ? "0" : "") + day;
}
function bankSplitByDay(start, end) {
  var parts = [];
  while (start < end) {
    var d = new Date(start);
    var next = new Date(d.getFullYear(), d.getMonth(), d.getDate() + 1).getTime();
    if (!(next > start)) break;
    var until = Math.min(end, next);
    parts.push({ date: bankDate(start), start: start, end: until });
    start = until;
  }
  return parts;
}
function bankValidSettings(s) {
  return !!s && typeof s.salary === "number" && isFinite(s.salary) && s.salary > 0 && s.salary <= 1000000000 &&
    typeof s.monthHours === "number" && isFinite(s.monthHours) && s.monthHours > 0 && s.monthHours <= 744 &&
    typeof s.dayHours === "number" && isFinite(s.dayHours) && s.dayHours > 0 && s.dayHours <= 24 &&
    typeof s.endTime === "string" && /^([01]\d|2[0-3]):[0-5]\d$/.test(s.endTime);
}
</script>

<script type="text/javascript">
/* 本地数据与输入状态；不会记录具体按键、鼠标位置或操作内容。 */
var DATA_FILE = "workbank.json", BACKUP_FILE = "workbank.json.bak", TEMP_FILE = "workbank.json.tmp";
var IDLE_LIMIT = 120000, MAX_TICK_GAP = 2500, SAMPLE_MAX_AGE = 3500;
var bank = { version: 1, settings: null, days: {} };
var masked = true, tracking = false, signedOff = false, fatalStorage = false;
var mainValid = false, storageProblem = "", recovered = false, dirty = false;
var lastTick = 0, previousInput = null, lastHeartbeat = 0, lastSave = 0;
var monitorStarted = 0, monitorReady = false, monitorIdle = false;
var alivePath = "", samplePath = "", lastHour = "", toastTimer = null;
var pinned = false, pinPending = false, pinDesired = false, pinRemember = false;
var pinStarted = 0, pinResultPath = "", pinPreviousTitle = "", pinTimer = null;
var petStarting = false, petRunning = false, petStarted = 0, petLastHeartbeat = 0, petLastState = "";
var petAlivePath = "", petStatePath = "", petBeatPath = "", petReadyPath = "", petControlPath = "", petNoticePath = "", petEventsPath = "";
var petPreviousTitle = "", petTargetTitle = "", petPanelVisible = true, petParentHandle = "";
var petTopMost = true, petPositionX = null, petPositionY = null;

function $id(id) { return document.getElementById(id); }
function text(id, value) { $id(id).innerText = value; }
function pad(n) { return (n < 10 ? "0" : "") + n; }
function money(n, precision) { return masked ? "¥ ****" : "¥ " + Math.max(0, n).toFixed(precision === 4 ? 4 : 2); }
function duration(seconds) {
  seconds = Math.floor(Math.max(0, seconds));
  return pad(Math.floor(seconds / 3600)) + ":" + pad(Math.floor(seconds % 3600 / 60)) + ":" + pad(seconds % 60);
}
function appPath(name) {
  var p;
  try { p = decodeURIComponent(location.pathname); } catch (e) { p = unescape(location.pathname); }
  if (p.charAt(0) === "/") p = p.substring(1);
  p = p.replace(/\//g, "\\");
  return p.substring(0, p.lastIndexOf("\\") + 1) + name;
}
function readPath(path, unicode) {
  try {
    var fso = new ActiveXObject("Scripting.FileSystemObject");
    if (!fso.FileExists(path)) return "";
    var file = fso.OpenTextFile(path, 1, false, unicode ? -1 : 0);
    var value = file.AtEndOfStream ? "" : file.ReadAll();
    file.Close();
    return value.replace(/^﻿/, "");
  } catch (e) { return ""; }
}
function writePath(path, value, unicode) {
  try {
    var fso = new ActiveXObject("Scripting.FileSystemObject");
    var file = fso.OpenTextFile(path, 2, true, unicode ? -1 : 0);
    file.Write(value);
    file.Close();
    return true;
  } catch (e) { return false; }
}
function deletePath(path) {
  if (!path) return;
  try {
    var fso = new ActiveXObject("Scripting.FileSystemObject");
    if (fso.FileExists(path)) fso.DeleteFile(path, true);
  } catch (e) {}
}
function parseBank(raw) {
  try {
    var data = JSON.parse(raw);
    if (!data || data.version !== 1 || !data.days || typeof data.days !== "object" ||
        (data.settings !== null && !bankValidSettings(data.settings))) return null;
    for (var key in data.days) {
      if (!Object.prototype.hasOwnProperty.call(data.days, key)) continue;
      var d = data.days[key];
      if (!/^\d{4}-\d{2}-\d{2}$/.test(key) || !d ||
          typeof d.activeSeconds !== "number" || !isFinite(d.activeSeconds) || d.activeSeconds < 0 ||
          typeof d.hourlyRate !== "number" || !isFinite(d.hourlyRate) || d.hourlyRate <= 0 ||
          typeof d.dayHours !== "number" || !isFinite(d.dayHours) || d.dayHours <= 0 || d.dayHours > 24) return null;
    }
    return data;
  } catch (e) { return null; }
}
function loadBank() {
  try {
    var fso = new ActiveXObject("Scripting.FileSystemObject");
    var mainExists = fso.FileExists(appPath(DATA_FILE));
    var backupExists = fso.FileExists(appPath(BACKUP_FILE));
    if (!mainExists && !backupExists) return;
    var data = mainExists ? parseBank(readPath(appPath(DATA_FILE), true)) : null;
    mainValid = !!data;
    if (!data && backupExists) {
      data = parseBank(readPath(appPath(BACKUP_FILE), true));
      if (data) recovered = true;
    }
    if (!data) {
      fatalStorage = true;
      storageProblem = "本机记录无法读取，已暂停保存。请先备份并检查 workbank.json 和备份文件。";
      return;
    }
    bank = data;
    masked = !bank.settings || bank.settings.maskByDefault !== false;
    if (bank.settings) {
      petTopMost = bank.settings.petOnTop !== false;
      petPositionX = typeof bank.settings.petX === "number" && isFinite(bank.settings.petX) && Math.abs(bank.settings.petX) <= 100000 ? Math.round(bank.settings.petX) : null;
      petPositionY = typeof bank.settings.petY === "number" && isFinite(bank.settings.petY) && Math.abs(bank.settings.petY) <= 100000 ? Math.round(bank.settings.petY) : null;
    }
  } catch (e) {
    fatalStorage = true;
    storageProblem = "无法访问本机文件，已暂停保存。请检查目录权限。";
  }
}
function saveBank() {
  if (fatalStorage) return false;
  try {
    var fso = new ActiveXObject("Scripting.FileSystemObject");
    var main = appPath(DATA_FILE), backup = appPath(BACKUP_FILE), temp = appPath(TEMP_FILE);
    if (!writePath(temp, JSON.stringify(bank), true)) throw new Error("write failed");
    if (mainValid && fso.FileExists(main)) fso.CopyFile(main, backup, true);
    fso.CopyFile(temp, main, true);
    mainValid = true;
    deletePath(temp);
    dirty = false;
    storageProblem = "";
    return true;
  } catch (e) {
    storageProblem = "本机记录保存失败，数据暂留内存；请检查程序目录的写入权限。";
    return false;
  }
}

/* PowerShell 命令中的路径和窗口标题使用单引号转义。 */
function psQuote(value) { return "'" + value.replace(/'/g, "''") + "'"; }

/* 临时唯一标题用于只定位当前 HTA 窗口；确认系统置顶成功后才更新按钮。 */
function pinCommand(title, desired, resultPath) {
  var nativeCode = "using System;using System.Runtime.InteropServices;" +
    "public static class WorkBankWindow {" +
    "[DllImport(@user32.dll@,CharSet=CharSet.Unicode,SetLastError=true)] private static extern IntPtr FindWindow(string cls,string name);" +
    "[DllImport(@user32.dll@,SetLastError=true)] private static extern bool SetWindowPos(IntPtr window,IntPtr after,int x,int y,int width,int height,uint flags);" +
    "[DllImport(@user32.dll@,EntryPoint=@GetWindowLongW@)] private static extern int GetWindowLong(IntPtr window,int index);" +
    "public static int Set(string title,bool topmost) { IntPtr window=FindWindow(null,title);" +
    "if(window==IntPtr.Zero)return -1;" +
    "if(!SetWindowPos(window,new IntPtr(topmost ? -1 : -2),0,0,0,0,0x13))return -2;" +
    "bool actual=(GetWindowLong(window,-20)&8)!=0;return actual==topmost ? 1 : -3; }}";
  return "$ErrorActionPreference='Stop';$src=" + psQuote(nativeCode) + ".Replace('@',[string][char]34);" +
    "try { Add-Type -TypeDefinition $src; $result=[WorkBankWindow]::Set(" + psQuote(title) + "," + (desired ? "$true" : "$false") + ") }" +
    "catch { $result=-9 };[IO.File]::WriteAllText(" + psQuote(resultPath) + ",[string]$result,[Text.Encoding]::ASCII)";
}
function renderPin() {
  var button = $id("btnPin");
  text("btnPin", pinPending ? "设置中…" : (pinned ? "取消置顶" : "置顶窗口"));
  button.className = "pin" + (pinned ? " on" : "");
  button.disabled = pinPending || petStarting;
  button.setAttribute("aria-pressed", pinned ? "true" : "false");
  button.title = pinned ? "取消窗口置顶" : "将窗口固定在其他普通窗口前面";
}
function finishPin(success) {
  if (pinTimer) clearTimeout(pinTimer);
  pinTimer = null;
  deletePath(pinResultPath);
  pinResultPath = "";
  document.title = pinPreviousTitle;
  pinPending = false;
  if (success) {
    pinned = pinDesired;
    if (pinRemember && bank.settings) {
      bank.settings.alwaysOnTop = pinned;
      dirty = true;
      if (!saveBank()) showToast("置顶已切换，但偏好保存失败；请检查目录权限。");
    }
  } else if (pinRemember) {
    alert("无法切换窗口置顶。请检查 PowerShell 和系统策略，然后重试。");
  } else {
    showToast("无法恢复窗口置顶，可检查 PowerShell 后手动重试。");
  }
  renderPin();
  if (petStarted === -1) { petStarted = 0; startPet(); }
}
function checkPin() {
  if (!pinPending) return;
  var result = readPath(pinResultPath, false);
  if (result === "1") { finishPin(true); return; }
  if (/^-?\d+$/.test(result) || new Date().getTime() - pinStarted >= 12000) { finishPin(false); return; }
  pinTimer = setTimeout(checkPin, 250);
}
function requestPin(desired, remember) {
  if (pinPending || petStarting) return;
  try {
    var shell = new ActiveXObject("WScript.Shell");
    var fso = new ActiveXObject("Scripting.FileSystemObject");
    var token = "WorkBankPin-" + new Date().getTime() + "-" + Math.floor(Math.random() * 1000000);
    pinResultPath = fso.GetSpecialFolder(2).Path + "\\" + token + ".result";
    pinPreviousTitle = document.title;
    document.title = pinPreviousTitle + " [" + token + "]";
    pinDesired = desired;
    pinRemember = remember;
    pinStarted = new Date().getTime();
    pinPending = true;
    renderPin();
    var exe = shell.ExpandEnvironmentStrings("%SystemRoot%\\System32\\WindowsPowerShell\\v1.0\\powershell.exe");
    shell.Run('"' + exe + '" -NoLogo -NoProfile -NonInteractive -WindowStyle Hidden -Command "' + pinCommand(document.title, desired, pinResultPath) + '"', 0, false);
    pinTimer = setTimeout(checkPin, 250);
  } catch (e) {
    if (pinPending) finishPin(false);
    else alert("无法切换窗口置顶。请检查 PowerShell 和系统策略，然后重试。");
  }
}

/* 桌宠与主窗口仅交换状态、位置和操作，不交换金额或薪资。 */
function petLaunchCommand(title, x, y) {
  var args = [psQuote(title), psQuote(appPath("assets")), psQuote(petAlivePath), psQuote(petStatePath),
    psQuote(petBeatPath), psQuote(petReadyPath), psQuote(petControlPath), psQuote(petNoticePath), psQuote(petEventsPath)];
  return "$ErrorActionPreference='Stop';try { Add-Type -Path " + psQuote(appPath("DesktopPet.cs")) +
    " -ReferencedAssemblies @('System.Windows.Forms','System.Drawing');[WorkBankPet]::Run(" + args.join(",") +
    "," + (petTopMost ? "$true" : "$false") + "," + x + "," + y + ") }" +
    " catch { try { [IO.File]::WriteAllText(" + psQuote(petReadyPath) + ",'error',[Text.Encoding]::ASCII) } catch {} }";
}
function recoverPetPanel(handle) {
  if (!/^\d{1,20}$/.test(handle)) return;
  try {
    var shell = new ActiveXObject("WScript.Shell");
    var exe = shell.ExpandEnvironmentStrings("%SystemRoot%\\System32\\WindowsPowerShell\\v1.0\\powershell.exe");
    var nativeCode = "using System;using System.Runtime.InteropServices;public static class WorkBankRecovery {" +
      "[DllImport(@user32.dll@)]static extern bool IsWindow(IntPtr h);" +
      "[DllImport(@user32.dll@)]static extern bool IsIconic(IntPtr h);" +
      "[DllImport(@user32.dll@)]static extern bool ShowWindowAsync(IntPtr h,int command);" +
      "public static void Restore(long value){IntPtr h=new IntPtr(value);if(IsWindow(h)&&IsIconic(h))ShowWindowAsync(h,9);}}";
    var script = "$ErrorActionPreference='Stop';try {$src=" + psQuote(nativeCode) + ".Replace('@',[string][char]34);" +
      "Add-Type -TypeDefinition $src;[WorkBankRecovery]::Restore(" + handle + ")} catch {}";
    shell.Run('"' + exe + '" -NoLogo -NoProfile -NonInteractive -WindowStyle Hidden -Command "' + script + '"', 0, false);
  } catch (e) {}
}
function petState() {
  if (fatalStorage || storageProblem) return "error";
  if (!bank.settings) return "unconfigured";
  if (!tracking) return "paused";
  if (!monitorReady) return "waiting";
  if (monitorIdle) return "idle";
  var d = new Date(), time = pad(d.getHours()) + ":" + pad(d.getMinutes());
  var day = currentDay(d.getTime());
  if (time >= bank.settings.endTime || bankOvertime(day) > 0) return "overtime";
  return day.activeSeconds >= day.dayHours * 3600 * 0.9 ? "urgent" : "active";
}
function writePetState() {
  if (!petStatePath || (!petStarting && !petRunning)) return;
  var state = petState() + "|" + (bank.settings && bank.settings.motion === false ? "0" : "1") + "|" + (tracking ? "1" : "0");
  if (state !== petLastState && writePath(petStatePath, state, false)) petLastState = state;
}
function showPetStatus(message) {
  text("petStatusText", message);
  $id("petStatus").className = message ? "pet-status error" : "pet-status hidden";
}
function cleanupPetFiles() {
  deletePath(petAlivePath);
  deletePath(petStatePath);
  deletePath(petBeatPath);
  deletePath(petReadyPath);
  deletePath(petControlPath);
  deletePath(petNoticePath);
  if (petEventsPath) {
    try {
      var fso = new ActiveXObject("Scripting.FileSystemObject");
      if (fso.FolderExists(petEventsPath)) fso.DeleteFolder(petEventsPath, true);
    } catch (e) {}
  }
}
function stopPet() {
  petStarting = false;
  petRunning = false;
  petStarted = 0;
  cleanupPetFiles();
}
function failPet(message) {
  var restoreHandle = petRunning ? petParentHandle : "";
  if (petStarting && document.title === petTargetTitle) document.title = petPreviousTitle;
  stopPet();
  recoverPetPanel(restoreHandle);
  renderPin();
  showPetStatus(message);
  showToast(message);
}
function startPet() {
  if (petStarting || petRunning) return true;
  if (pinPending) { petStarted = -1; return false; }
  try {
    var shell = new ActiveXObject("WScript.Shell");
    var fso = new ActiveXObject("Scripting.FileSystemObject");
    var temp = fso.GetSpecialFolder(2).Path;
    var token = "WorkBankPet-" + new Date().getTime() + "-" + Math.floor(Math.random() * 1000000);
    var base = temp + "\\" + token;
    petAlivePath = base + ".alive";
    petStatePath = base + ".state";
    petBeatPath = base + ".beat";
    petReadyPath = base + ".ready";
    petControlPath = base + ".control";
    petNoticePath = base + ".notice";
    petEventsPath = base + ".events";
    fso.CreateFolder(petEventsPath);
    if (!writePath(petAlivePath, "alive", false)) throw new Error("heartbeat failed");
    petPreviousTitle = document.title;
    petTargetTitle = petPreviousTitle + " [" + token + "]";
    document.title = petTargetTitle;
    petStarting = true;
    petRunning = false;
    petPanelVisible = true;
    petParentHandle = "";
    petStarted = new Date().getTime();
    petLastHeartbeat = petStarted;
    petLastState = "";
    renderPin();
    writePetState();
    var petX = petPositionX !== null ? petPositionX : -2147483648;
    var petY = petPositionY !== null ? petPositionY : -2147483648;
    var exe = shell.ExpandEnvironmentStrings("%SystemRoot%\\System32\\WindowsPowerShell\\v1.0\\powershell.exe");
    var command = petLaunchCommand(petTargetTitle, petX, petY);
    shell.Run('"' + exe + '" -NoLogo -NoProfile -NonInteractive -Sta -WindowStyle Hidden -Command "' + command + '"', 0, false);
    showPetStatus("");
    return true;
  } catch (e) {
    failPet("小鲸桌宠启动失败，工时卡片仍可正常使用。");
    return false;
  }
}
function handlePetEvent(value) {
  if (value === "hide" || value === "show") {
    petPanelVisible = value === "show";
    if (!petPanelVisible) $id("toast").className = "toast hidden";
  } else if (value === "toggle") {
    if (tracking) pauseTracking(); else startTracking();
  } else if (value === "pin|1" || value === "pin|0") {
    petTopMost = value === "pin|1";
    if (bank.settings) { bank.settings.petOnTop = petTopMost; dirty = true; }
  } else {
    var match = /^position\|(-?\d{1,6})\|(-?\d{1,6})$/.exec(value);
    if (match && Math.abs(Number(match[1])) <= 100000 && Math.abs(Number(match[2])) <= 100000) {
      petPositionX = Number(match[1]);
      petPositionY = Number(match[2]);
      if (bank.settings) { bank.settings.petX = petPositionX; bank.settings.petY = petPositionY; dirty = true; }
    }
  }
  if (dirty && !tracking && !saveBank()) showToast("桌宠设置未能保存，请检查目录权限。");
}
function readPetEvents() {
  if (!petEventsPath) return;
  try {
    var fso = new ActiveXObject("Scripting.FileSystemObject");
    if (!fso.FolderExists(petEventsPath)) return;
    var paths = [], files = new Enumerator(fso.GetFolder(petEventsPath).Files);
    for (; !files.atEnd(); files.moveNext()) {
      var path = String(files.item().Path);
      if (/\.evt$/i.test(path)) paths.push(path);
    }
    paths.sort();
    for (var i = 0; i < paths.length; i++) {
      var value = readPath(paths[i], false);
      deletePath(paths[i]);
      handlePetEvent(value);
    }
  } catch (e) {}
}
function petTick() {
  if (!petStarting && !petRunning) return;
  var now = new Date().getTime();
  if (now - petLastHeartbeat >= 5000) {
    if (!writePath(petAlivePath, "alive", false)) { failPet("桌宠连接中断，工时卡片仍可正常使用。"); return; }
    petLastHeartbeat = now;
  }
  if (petStarting) {
    var ready = readPath(petReadyPath, false);
    var readyMatch = /^ready\|(\d{1,20})$/.exec(ready);
    if (readyMatch) {
      petParentHandle = readyMatch[1];
      deletePath(petReadyPath);
      if (document.title === petTargetTitle) document.title = petPreviousTitle;
      petStarting = false;
      petRunning = true;
      petStarted = now;
      renderPin();
      showPetStatus("");
      petPanelVisible = !!fatalStorage;
      writePath(petControlPath, fatalStorage ? "show" : "hide", false);
    } else if (ready === "error" || now - petStarted > 20000) {
      failPet("小鲸桌宠未能启动，请检查 PowerShell 或组件文件。");
      return;
    }
  } else {
    var beat = Number(readPath(petBeatPath, false));
    if (now - petStarted > 8000 && (!(beat > 0) || now - beat > 12000 || beat - now > 3000)) {
      failPet("小鲸桌宠已退出或连接中断，工时卡片仍可使用。");
      return;
    }
    readPetEvents();
  }
  writePetState();
}

/* 采样进程只查询 GetLastInputInfo，临时文件仅传递时间戳。 */
function workerCommand(alive, sample) {
  var nativeCode = "using System;using System.Runtime.InteropServices;" +
    "public static class WorkBankIdle {" +
    "[StructLayout(LayoutKind.Sequential)] private struct LASTINPUTINFO { public uint cbSize; public uint dwTime; }" +
    "[DllImport(@user32.dll@)] private static extern bool GetLastInputInfo(ref LASTINPUTINFO value);" +
    "[DllImport(@kernel32.dll@)] private static extern uint GetTickCount();" +
    "public static uint Milliseconds() { LASTINPUTINFO value = new LASTINPUTINFO();" +
    "value.cbSize = (uint)Marshal.SizeOf(typeof(LASTINPUTINFO));" +
    "return GetLastInputInfo(ref value) ? unchecked(GetTickCount() - value.dwTime) : UInt32.MaxValue; }}";
  var script = "$ErrorActionPreference='Stop';$alive=" + psQuote(alive) + ";$sample=" + psQuote(sample) + ";" +
    "$src=" + psQuote(nativeCode) + ".Replace('@',[string][char]34);" +
    "try { Add-Type -TypeDefinition $src; while ([IO.File]::Exists($alive)) {" +
    "if (([DateTime]::UtcNow-[IO.File]::GetLastWriteTimeUtc($alive)).TotalSeconds -gt 30) { break };" +
    "$t=[long](([DateTime]::UtcNow.Ticks-621355968000000000)/10000);" +
    "$idle=[WorkBankIdle]::Milliseconds();" +
    "[IO.File]::WriteAllText($sample,([string]$t+'|'+[string]$idle),[Text.Encoding]::ASCII);" +
    "Start-Sleep -Milliseconds 1000 } } finally {" +
    "try { [IO.File]::Delete($sample) } catch {}; try { [IO.File]::Delete($alive) } catch {} }";
  return script;
}
function startMonitor() {
  try {
    var shell = new ActiveXObject("WScript.Shell");
    var fso = new ActiveXObject("Scripting.FileSystemObject");
    var temp = fso.GetSpecialFolder(2).Path;
    var token = "workbank-" + new Date().getTime() + "-" + Math.floor(Math.random() * 1000000);
    alivePath = temp + "\\" + token + ".alive";
    samplePath = temp + "\\" + token + ".sample";
    if (!writePath(alivePath, "alive", false)) throw new Error("heartbeat failed");
    var exe = shell.ExpandEnvironmentStrings("%SystemRoot%\\System32\\WindowsPowerShell\\v1.0\\powershell.exe");
    var script = workerCommand(alivePath, samplePath);
    shell.Run('"' + exe + '" -NoLogo -NoProfile -NonInteractive -WindowStyle Hidden -Command "' + script + '"', 0, false);
    monitorStarted = new Date().getTime();
    lastHeartbeat = monitorStarted;
    monitorReady = false;
    previousInput = null;
    return true;
  } catch (e) {
    stopMonitor();
    monitorStarted = 1;
    return false;
  }
}
function stopMonitor() {
  deletePath(alivePath);
  deletePath(samplePath);
  alivePath = "";
  samplePath = "";
  monitorReady = false;
  monitorIdle = false;
  previousInput = null;
}
function readSample(now) {
  if (!samplePath) return null;
  var raw = readPath(samplePath, false);
  var match = /^(\d{12,16})\|(\d{1,10})$/.exec(raw);
  if (!match) return null;
  var stamp = Number(match[1]), idle = Number(match[2]), age = now - stamp;
  if (age < -1000 || age > SAMPLE_MAX_AGE || idle >= 4294967295) return null;
  return { input: stamp - idle, idle: idle + Math.max(0, age) };
}
function addActivity(start, end) {
  var parts = bankSplitByDay(start, end);
  for (var i = 0; i < parts.length; i++) {
    var part = parts[i], day = bank.days[part.date];
    if (!day) {
      day = { activeSeconds: 0, hourlyRate: bank.settings.salary / bank.settings.monthHours, dayHours: bank.settings.dayHours };
      bank.days[part.date] = day;
    }
    day.activeSeconds += (part.end - part.start) / 1000;
    dirty = true;
  }
}
function currentDay(now) {
  var day = bank.days[bankDate(now)];
  if (day) return day;
  return { activeSeconds: 0, hourlyRate: bank.settings ? bank.settings.salary / bank.settings.monthHours : 0,
    dayHours: bank.settings ? bank.settings.dayHours : 8 };
}
function goalText(day) {
  if (!bank.settings) return "每一次认真投入，都值得被看见。";
  var earned = bankDayAmount(day), rate = day.hourlyRate;
  var goals = [
    { name: "一支好写的签字笔", value: 6 }, { name: "今天的地铁", value: 8 },
    { name: "一杯冰美式", value: 19 }, { name: "一份小零食", value: 25 },
    { name: "一顿加班外卖", value: 32 }, { name: "一天房租", value: bank.settings.salary / 30 }
  ];
  goals.sort(function (a, b) { return a.value - b.value; });
  var target = null;
  for (var i = 0; i < goals.length; i++) {
    if (goals[i].value > earned + 0.000001) { target = goals[i]; break; }
  }
  if (!target) return "今天投进去的，已折合 " + (earned / (bank.settings.salary / 30)).toFixed(1) + " 天房租。";
  if (target.value > day.dayHours * rate || day.activeSeconds >= day.dayHours * 3600) {
    return "今天的计额有上限；超过计划的时间，单独记在加班里。";
  }
  var minutes = Math.max(1, Math.ceil((target.value - earned) / rate * 60));
  var time = minutes >= 60 ? Math.floor(minutes / 60) + " 小时 " + (minutes % 60) + " 分钟" : minutes + " 分钟";
  return "再记录 " + time + " 活跃时间，就能攒下" + target.name + "。";
}
function endDescription(now) {
  if (!bank.settings) return "计划下班 --:--";
  var d = new Date(now), hm = bank.settings.endTime.split(":"), end = new Date(d.getFullYear(), d.getMonth(), d.getDate(), Number(hm[0]), Number(hm[1]), 0, 0).getTime();
  if (!tracking) return "计划下班 " + bank.settings.endTime;
  if (now < end) return "距计划下班 " + duration((end - now) / 1000);
  return "已过计划下班时间 " + duration((now - end) / 1000);
}
function render(now) {
  var day = currentDay(now), month = bankMonth(bank.days, bankDate(now).substring(0, 7));
  var pct = day.activeSeconds / (day.dayHours * 3600) * 100;
  var status = $id("status"), stateText = "未设置", statusClass = "status off";
  if (bank.settings) {
    if (!tracking) stateText = signedOff ? "已收工" : "未开工";
    else if (!monitorReady) stateText = "采样未就绪";
    else if (monitorIdle) stateText = "键鼠空闲";
    else {
      var d = new Date(now), time = pad(d.getHours()) + ":" + pad(d.getMinutes());
      if (time >= bank.settings.endTime || pct >= 100) { stateText = "加班中"; statusClass = "status overtime"; }
      else { stateText = "上班中"; statusClass = "status"; }
    }
  }
  status.className = statusClass;
  text("status", stateText);
  text("dateText", bankDate(now));
  text("todayAmount", money(bankDayAmount(day), 4));
  text("todayCaption", bank.settings ? "折合 " + (day.activeSeconds / 28800).toFixed(2) + " 个标准日（8小时） · 时薪 " + money(day.hourlyRate) : "先设置到手月薪和计划工时");
  text("progressText", (day.activeSeconds / 3600).toFixed(2) + " / " + day.dayHours.toFixed(2) + " 小时 · " + Math.floor(pct) + "%");
  $id("progressFill").style.width = Math.min(100, Math.max(0, pct)) + "%";
  var stage = pct >= 100 ? "overtime" : (pct >= 90 ? "hot" : (pct >= 60 ? "warm" : "cool"));
  $id("energyMeter").className = "energy " + stage + ((!tracking || !monitorReady || monitorIdle) ? " paused" : "");
  document.body.className = bank.settings && bank.settings.motion === false ? "motion-off" : "";
  text("activeText", "已记录 " + duration(day.activeSeconds));
  text("endText", endDescription(now));
  text("monthAmount", money(month.amount));
  text("monthDetail", "已记录 " + month.days + " 天 · 活跃 " + duration(month.activeSeconds));
  text("monthOvertime", duration(month.overtimeSeconds));
  text("leaveDetail", "折合 " + (month.overtimeSeconds / 28800).toFixed(1) + " 个标准日（仅供参考）");
  text("anchorText", goalText(day));
  text("btnPrivacy", masked ? "显示金额" : "隐藏金额");
  text("btnTrack", tracking ? "暂停记录" : "开始记录");
  $id("bankCard").title = stateText + " · 活跃 " + duration(day.activeSeconds) + " · 今日投入 " + money(bankDayAmount(day), 4);
  var monitor = $id("monitorText");
  monitor.className = "monitor" + (storageProblem || (tracking && !monitorReady && now - monitorStarted > 8000) ? " error" : "");
  if (storageProblem) text("monitorText", storageProblem);
  else if (tracking && !monitorReady && now - monitorStarted > 8000) {
    monitor.innerText = "无法读取系统活跃状态，未计入工时。请检查 PowerShell 和系统策略，然后暂停并重新开始记录。";
  } else if (tracking && !monitorReady) text("monitorText", "正在启动本机活跃状态采样；采样就绪前不计时。");
  else if (tracking && monitorIdle) text("monitorText", "已超过 2 分钟没有键鼠操作，暂不累计；再次操作后恢复。");
  else if (recovered) text("monitorText", "主记录无法读取，已使用本机备份；请检查并备份数据文件。");
  else text("monitorText", "仅在开启记录且程序运行时统计；2 分钟内有键鼠操作视为活跃。");
}
function hourKey(d) { return bankDate(d.getTime()) + "-" + pad(d.getHours()); }
function showToast(message) {
  if (petRunning && !petPanelVisible) {
    var notice = message.indexOf("整点") >= 0 || message.indexOf("时薪参考") === 0 ? "hour" : "attention";
    writePath(petNoticePath, notice, false);
    return;
  }
  text("toast", message);
  $id("toast").className = "toast";
  if (toastTimer) clearTimeout(toastTimer);
  toastTimer = setTimeout(function () { $id("toast").className = "toast hidden"; }, 6000);
}
function tick(skipPet) {
  var now = new Date().getTime();
  if (tracking && bank.settings) {
    if (alivePath && now - lastHeartbeat >= 5000) {
      if (!writePath(alivePath, "alive", false)) stopMonitor();
      lastHeartbeat = now;
    }
    var sample = readSample(now), elapsed = now - lastTick;
    monitorReady = !!sample;
    monitorIdle = !!sample && sample.idle >= IDLE_LIMIT;
    if (sample && previousInput !== null && elapsed > 0 && elapsed <= MAX_TICK_GAP) {
      var ranges = bankActiveRanges(lastTick, now, previousInput, sample.input, IDLE_LIMIT);
      for (var i = 0; i < ranges.length; i++) addActivity(ranges[i].start, ranges[i].end);
    }
    previousInput = sample ? sample.input : null;
    lastTick = now;
    if (dirty && now - lastSave >= 5000) { saveBank(); lastSave = now; }
    var d = new Date(now), key = hourKey(d);
    if (key !== lastHour) {
      if (d.getMinutes() === 0 && monitorReady && bank.settings.announce) {
        showToast(masked ? "又走过一个整点，活跃工时已记账。" : "时薪参考 " + money(bank.settings.salary / bank.settings.monthHours) + "；仅活跃时间计入。");
      }
      lastHour = key;
    }
  }
  render(now);
  if (skipPet !== true) petTick();
}
function startTracking() {
  if (fatalStorage) { alert(storageProblem); return; }
  if (!bank.settings) { openSettings(); return; }
  tracking = true;
  signedOff = false;
  lastTick = new Date().getTime();
  lastSave = lastTick;
  lastHour = hourKey(new Date(lastTick));
  startMonitor();
  render(lastTick);
}
function pauseTracking() {
  if (!tracking) return;
  tick(true);
  tracking = false;
  stopMonitor();
  if (dirty) saveBank();
  render(new Date().getTime());
}
function openSettings() {
  if (fatalStorage) { alert(storageProblem); return; }
  var s = bank.settings;
  $id("inSalary").value = s ? s.salary : "";
  $id("inMonthHours").value = s ? s.monthHours : "174";
  $id("inDayHours").value = s ? s.dayHours : "8";
  $id("inEndTime").value = s ? s.endTime : "18:00";
  $id("inMask").checked = !s || s.maskByDefault !== false;
  $id("inAnnounce").checked = !s || s.announce !== false;
  $id("inMotion").checked = !s || s.motion !== false;
  $id("showSalary").checked = false;
  $id("inSalary").type = "password";
  $id("settingsModal").className = "modal";
}
function saveSettings() {
  var settings = {
    salary: Number($id("inSalary").value), monthHours: Number($id("inMonthHours").value),
    dayHours: Number($id("inDayHours").value), endTime: $id("inEndTime").value.replace(/^\s+|\s+$/g, ""),
    maskByDefault: $id("inMask").checked, announce: $id("inAnnounce").checked, motion: $id("inMotion").checked,
    alwaysOnTop: pinPending ? !!(bank.settings && bank.settings.alwaysOnTop) : pinned,
    petOnTop: petTopMost,
    petX: petPositionX,
    petY: petPositionY
  };
  if (!bankValidSettings(settings)) {
    alert("请填写有效的到手月薪、月计划工时（不超过 744）、日计划工时（不超过 24）和下班时间（如 18:00）。");
    return;
  }
  if (tracking) tick();
  var previousSettings = bank.settings, previousMask = masked, previousDirty = dirty;
  var day = bank.days[bankDate(new Date().getTime())];
  var previousRate = day ? day.hourlyRate : 0, previousHours = day ? day.dayHours : 0;
  bank.settings = settings;
  if (day) { day.hourlyRate = settings.salary / settings.monthHours; day.dayHours = settings.dayHours; }
  masked = settings.maskByDefault;
  dirty = true;
  if (!saveBank()) {
    bank.settings = previousSettings;
    if (day) { day.hourlyRate = previousRate; day.dayHours = previousHours; }
    masked = previousMask;
    dirty = previousDirty;
    alert(storageProblem);
    render(new Date().getTime());
    return;
  }
  $id("settingsModal").className = "modal hidden";
  if (!previousSettings) startTracking();
  else render(new Date().getTime());
}
function signOff() {
  if (!bank.settings) { openSettings(); return; }
  if (tracking) pauseTracking();
  signedOff = true;
  var now = new Date().getTime(), day = currentDay(now), month = bankMonth(bank.days, bankDate(now).substring(0, 7));
  text("receiptDate", bankDate(now));
  text("receiptActive", duration(day.activeSeconds));
  text("receiptOvertime", duration(bankOvertime(day)));
  text("receiptAmount", money(bankDayAmount(day)));
  text("receiptMonth", money(month.amount));
  text("receiptNote", storageProblem ? "注意：本机保存失败，记录暂留内存。请先检查写入权限。" : "人已下班，未完的事明天再说。记录只保存在本机。");
  $id("receiptModal").className = "modal";
  render(now);
}
function showHistory() {
  var keys = [], html = "";
  for (var key in bank.days) if (Object.prototype.hasOwnProperty.call(bank.days, key)) keys.push(key);
  keys.sort(); keys.reverse();
  for (var i = 0; i < keys.length; i++) {
    var day = bank.days[keys[i]];
    html += "<tr><td>" + keys[i] + "</td><td>" + duration(day.activeSeconds) + "</td><td>" + duration(bankOvertime(day)) + "</td><td>" + money(bankDayAmount(day)) + "</td></tr>";
  }
  $id("historyBody").innerHTML = html || "<tr><td colspan='4' style='text-align:center'>暂无实际记录</td></tr>";
  $id("historyModal").className = "modal";
}

$id("btnPetRetry").onclick = function () { startPet(); };
$id("btnPin").onclick = function () { requestPin(!pinned, true); };
$id("btnPrivacy").onclick = function () {
  masked = !masked;
  if (masked) $id("toast").className = "toast hidden";
  render(new Date().getTime());
};
$id("btnTrack").onclick = function () { if (tracking) pauseTracking(); else startTracking(); };
$id("btnSettings").onclick = openSettings;
$id("btnSaveSettings").onclick = saveSettings;
$id("btnCancelSettings").onclick = function () { $id("settingsModal").className = "modal hidden"; };
$id("showSalary").onclick = function () { $id("inSalary").type = this.checked ? "text" : "password"; };
$id("btnSign").onclick = signOff;
$id("btnCloseReceipt").onclick = function () { $id("receiptModal").className = "modal hidden"; };
$id("btnHistory").onclick = showHistory;
$id("btnCloseHistory").onclick = function () { $id("historyModal").className = "modal hidden"; };
window.onload = function () {
  try {
    var width = Math.min(530, screen.availWidth), height = Math.min(720, screen.availHeight);
    window.resizeTo(width, height);
    window.moveTo(Math.max(0, screen.availWidth - width - 16), Math.max(0, Math.min(40, screen.availHeight - height)));
  } catch (e) {}
  loadBank();
  render(new Date().getTime());
  renderPin();
  setInterval(tick, 1000);
  if (bank.settings && bank.settings.alwaysOnTop === true) requestPin(true, false);
  if (!bank.settings && !fatalStorage) openSettings();
  startPet();
};
window.onunload = function () {
  if (tracking) pauseTracking();
  else if (dirty) saveBank();
  stopMonitor();
  stopPet();
  if (pinTimer) clearTimeout(pinTimer);
  deletePath(pinResultPath);
};
</script>
</body>
</html>
