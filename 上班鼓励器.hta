}
function bankWeekHours(settings) {
  if (settings && Object.prototype.toString.call(settings.weekHours) === "[object Array]" && settings.weekHours.length === 7)
    return settings.weekHours.slice(0);
  var hours = settings && bankValidPlanHours(settings.dayHours) && settings.dayHours > 0 ? settings.dayHours : 8;
  return [0, hours, hours, hours, hours, hours, 0];
}
function bankPlanHours(settings, date) {
  if (bankCalcMode(settings) !== "days") return settings.dayHours;
  var overrides = settings.dayOverrides || {};
  if (Object.prototype.hasOwnProperty.call(overrides, date)) return overrides[date];
  var parts = date.split("-");
  return bankWeekHours(settings)[new Date(Number(parts[0]), Number(parts[1]) - 1, Number(parts[2])).getDay()];
}
function bankSnapshotForDate(settings, date) {
  if (!settings || !bankValidDate(date)) return null;
  if (bankCalcMode(settings) !== "days") return { calculationMode: "hours", dayHours: settings.dayHours, hourlyRate: settings.salary / settings.monthHours };
  var paid = bankPaidDays(settings, date.substring(0, 7));
  if (paid === null) return null;
  var hours = bankPlanHours(settings, date), daily = settings.salary / paid;
  return { calculationMode: "days", dayHours: hours, hourlyRate: hours > 0 ? daily / hours : 0, paidDays: paid, dailyAmount: daily };
}
function bankIsRestDay(day) { return !!day && day.calculationMode === "days" && day.dayHours === 0; }
function bankProgressPercent(day) { return day && day.dayHours > 0 ? day.activeSeconds / (day.dayHours * 3600) * 100 : 0; }
function bankValidPlanFields(s) {
  if (typeof s.calculationMode !== "undefined" && s.calculationMode !== "hours" && s.calculationMode !== "days") return false;
  if (typeof s.weekHours !== "undefined") {
    if (Object.prototype.toString.call(s.weekHours) !== "[object Array]" || s.weekHours.length !== 7) return false;
    for (var i = 0; i < 7; i++) if (!bankValidPlanHours(s.weekHours[i])) return false;
  } else if (bankCalcMode(s) === "days") return false;
  var maps = [s.paidDaysByMonth, s.dayOverrides];
  for (var n = 0; n < maps.length; n++) {
    var map = maps[n];
    if (typeof map === "undefined") { if (n === 0 && bankCalcMode(s) === "days") return false; continue; }
    if (!map || Object.prototype.toString.call(map) !== "[object Object]") return false;
    var count = 0;
    for (var key in map) {
      if (!Object.prototype.hasOwnProperty.call(map, key)) continue;
      count++;
      if (count > 10000 || (n === 0 ? !bankValidMonth(key) || !bankValidPaidDays(map[key]) :
          !bankValidDate(key) || !bankValidPlanHours(map[key]))) return false;
    }
  }
  return true;
}
function bankValidSettings(s) {
  return !!s && typeof s.salary === "number" && isFinite(s.salary) && s.salary > 0 && s.salary <= 1000000000 &&
    typeof s.monthHours === "number" && isFinite(s.monthHours) && s.monthHours > 0 && s.monthHours <= 744 &&
    typeof s.dayHours === "number" && isFinite(s.dayHours) && s.dayHours > 0 && s.dayHours <= 24 &&
    typeof s.endTime === "string" && /^([01]\d|2[0-3]):[0-5]\d$/.test(s.endTime) && bankValidPlanFields(s) &&
    (typeof s.autoLaunch === "undefined" || typeof s.autoLaunch === "boolean") &&
    (typeof s.lockMode === "undefined" || s.lockMode === "off" || s.lockMode === "manual" || s.lockMode === "auto") &&
    (typeof s.maskTimeoutSeconds === "undefined" || s.maskTimeoutSeconds === 0 || s.maskTimeoutSeconds === 30 || s.maskTimeoutSeconds === 60) &&
    (typeof s.restReminderMinutes === "undefined" || s.restReminderMinutes === 0 || s.restReminderMinutes === 45 || s.restReminderMinutes === 60 || s.restReminderMinutes === 90);
