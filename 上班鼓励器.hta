<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta http-equiv="x-ua-compatible" content="ie=edge">
<title>上班鼓励器 · 工时银行</title>
<hta:application
  id="app"
  applicationname="WorkEncourager"
  border="thin"
  caption="yes"
  showintaskbar="yes"
  singleinstance="yes"
  sysmenu="yes"
  windowstate="normal"
  maximizebutton="no"
  navigable="no"
  contextmenu="no" />
<style>
  * { box-sizing: border-box; }
  html, body { margin: 0; min-height: 100%; }
  body {
    font-family: "Microsoft YaHei", sans-serif;
    color: #e7f1ff;
    background: #0a1424;
    background-image: radial-gradient(ellipse at 84% -4%, rgba(70,140,210,.22) 0%, transparent 55%),
      radial-gradient(ellipse at 10% 108%, rgba(60,110,170,.18) 0%, transparent 52%),
      repeating-linear-gradient(0deg, rgba(160,210,255,.02) 0, rgba(160,210,255,.02) 1px, transparent 1px, transparent 6px);
    cursor: default;
  }
  button, input { font-family: "Microsoft YaHei", sans-serif; }
  button { cursor: pointer; }
  button:focus, input:focus { outline: 2px solid #7fc4ff; outline-offset: 2px; }
  .hidden { display: none !important; }
  .shell { width: auto; max-width: 510px; margin: 0 auto; padding: 13px 16px 15px; }
  .top { height: 58px; position: relative; padding-left: 56px; }
  .avatar { position: absolute; left: 0; top: 4px; width: 46px; height: 46px; border-radius: 50%; border: 2px solid #5d9fd6; background: #0f2138; box-shadow: 0 0 14px rgba(99,176,255,.35); }
  .eyebrow { color: #6ea6d8; font: bold 9px Consolas, monospace; letter-spacing: 2px; }
  h1 { margin: 5px 0 0; font-size: 24px; letter-spacing: 3px; color: #dceeff; text-shadow: 0 0 14px rgba(120,190,255,.35); }
  .pin, .theme { position: absolute; top: 8px; padding: 7px 10px; border: 1px solid #38618c; background: #102540; color: #cbe4ff; font-size: 12px; border-radius: 8px; }
  .pin { right: 0; }
  .theme { right: 84px; }
  .pin:hover, .pin.on, .theme:hover { border-color: #7fc4ff; color: #eaf6ff; }
  .pin.on { background: #1d4570; }
  .pin[disabled] { color: #82a0c2; cursor: wait; }
  .theme-menu { position: absolute; z-index: 20; top: 42px; right: 84px; min-width: 132px; padding: 6px; border: 1px solid #38618c; background: #102540; border-radius: 10px; box-shadow: 0 12px 28px rgba(0,8,20,.5); }
  .theme-item { display: block; width: 100%; padding: 7px 10px; border: 0; border-radius: 6px; background: transparent; color: #cbe4ff; font-size: 12px; text-align: left; }
  .theme-item:hover, .theme-item.on { background: #1d4570; color: #eaf6ff; }
  .theme-item.on:after { content: " ✓"; }
  body.theme-cream .theme-menu { background: #fffdf6; border-color: #d9c9a8; box-shadow: 0 12px 28px rgba(90,70,40,.2); }
  body.theme-cream .theme-item { color: #4d5f6e; }
  body.theme-cream .theme-item:hover, body.theme-cream .theme-item.on { background: #e8f1f9; color: #1f4d75; }
  body.theme-glass .theme-menu { background: #254852; border-color: #7aa4a9; }
  body.theme-glass .theme-item { color: #f0ffff; }
  body.theme-glass .theme-item:hover, body.theme-glass .theme-item.on { background: #315f69; color: #fff; }
  .card { position: relative; padding: 17px 20px 13px; background: #12233c; border: 1px solid #2b4a6e; border-radius: 18px; box-shadow: 0 16px 34px rgba(0,8,20,.45); }
  .card:before { content: ""; position: absolute; top: -1px; left: 18px; right: 18px; height: 6px;
    background: repeating-radial-gradient(circle at 6px 0, rgba(170,220,255,.7) 0, rgba(170,220,255,.7) 3px, transparent 3px, transparent 12px); }
  .card-top { height: 29px; }
  .status { display: inline-block; padding: 5px 11px; color: #cfe6ff; background: #17395b; border: 1px solid #2f5f8d; border-radius: 999px; font-size: 12px; letter-spacing: 1px; }
  .status.off { color: #9fb2c7; background: #16263a; border-color: #2c435e; }
  .status.overtime { color: #ffd8b8; background: #4a2f22; border-color: #7d4d33; }
  .date { margin-left: 8px; color: #8aa6c4; font-size: 12px; }
  .privacy { float: right; padding: 5px 10px; border: 1px solid #3c6288; border-radius: 8px; background: transparent; color: #cfe3f8; font-size: 12px; }
  .privacy:hover, .btn-quiet:hover { border-color: #7fc4ff; color: #eaf6ff; }
  .pet-say { margin: 10px 0 0; padding: 8px 11px; color: #a9cdea; background: #0e1f34; border-left: 2px solid #7fc4ff; border-radius: 4px 10px 10px 4px; font-size: 12px; line-height: 1.6; }
  .label { margin-top: 12px; color: #8fb1d1; font-size: 12px; letter-spacing: 3px; }
  .amount { display: block; margin: 5px 0 2px; padding: 0; border: 0; background: transparent; text-align: left; color: #d9efff; font: bold 48px Consolas, monospace; letter-spacing: -2px; line-height: 1.1; text-shadow: 0 0 18px rgba(110,190,255,.28); }
  .amount:hover { color: #fff; }
  .caption { min-height: 20px; color: #9fbcd8; font-size: 12px; }
  .progress-head { margin-top: 13px; color: #c6dcf2; font-size: 12px; }
  .progress-head .right { float: right; color: #8fd0ff; font-family: Consolas, monospace; font-size: 13px; }
  .energy { position: relative; height: 22px; margin-top: 7px; padding-right: 29px; }
  .track { position: relative; top: 7px; height: 10px; background: #0a1626; border: 1px solid #2b4a6e; border-radius: 8px; overflow: hidden; }
  .fill { position: relative; height: 100%; width: 0; border-radius: 8px; transition: width .3s; }
  .fill:after { content: ""; position: absolute; top: 0; right: 0; bottom: 0; left: 0; background: repeating-linear-gradient(115deg, rgba(255,255,255,.28) 0, rgba(255,255,255,.28) 4px, transparent 4px, transparent 15px); animation: energyFlow 1.1s linear infinite; }
  .energy.cool .fill { background: linear-gradient(90deg, #2f6fa8, #8fd4ff); }
  .energy.warm .fill { background: linear-gradient(90deg, #3f8fd0, #b5e8ff); }
  .energy.hot .fill { background: linear-gradient(90deg, #d98a4f, #ffd08a); }
  .energy.overtime .fill { background: linear-gradient(90deg, #d64930, #ffad3e); }
  .flame-icon { position: absolute; right: 2px; top: 0; width: 18px; height: 22px; transform-origin: 50% 95%; animation: flamePulse 1s ease-in-out infinite alternate; }
  .flame-outer { fill: #4a9ad4; }
  .energy.warm .flame-outer { fill: #7fd4ff; }
  .energy.hot .flame-outer { fill: #f0b45c; }
  .energy.overtime .flame-outer { fill: #ff7037; }
  .flame-inner { fill: #eaf8ff; }
  .energy.hot .flame-inner, .energy.overtime .flame-inner { fill: #ffe2a0; }
  .energy.paused .fill, .energy.paused .flame-icon { opacity: .45; }
  .energy.paused .fill:after, .energy.paused .flame-icon, .motion-off .fill:after, .motion-off .flame-icon { animation: none; }
  .motion-off .fill { transition: none; }
  @keyframes energyFlow { from { background-position: 0 0; } to { background-position: 32px 0; } }
  @keyframes flamePulse { from { transform: scale(.92,.92); } to { transform: scale(1.06,1.08); } }
  .progress-foot { margin-top: 8px; color: #8aa6c2; font-size: 11px; }
  .progress-foot .right { float: right; }
  .rule { height: 1px; margin: 13px 0 12px; background: #24405f; }
  .stat { display: inline-block; vertical-align: top; width: 49%; }
  .stat + .stat { padding-left: 15px; border-left: 1px solid #24405f; }
  .stat-label { color: #93aec9; font-size: 12px; letter-spacing: 1px; }
  .stat-value { margin-top: 7px; color: #e4f2ff; font: 22px Consolas, monospace; }
  .month-amount { display: block; width: 100%; padding: 0; border: 0; background: transparent; text-align: left; cursor: pointer; }
  .month-amount:hover { color: #fff; }
  .stat-detail { margin-top: 5px; color: #8fa9c2; font-size: 11px; }
  .anchor { margin: 12px -20px -13px; padding: 10px 20px; color: #a9cdef; background: #0e1b30; border-top: 1px solid #24405f; border-radius: 0 0 18px 18px; font-size: 13px; line-height: 1.6; }
  .anchor-mark { color: #7fc4ff; margin-right: 8px; }
  .monitor { margin: 8px 1px 0; color: #93aec9; font-size: 11px; line-height: 1.65; }
  .monitor.error { color: #f0b080; }
  .monitor button { margin-left: 8px; padding: 2px 7px; border: 1px solid #3f6d99; color: #d6ecff; background: #102540; font-size: 11px; border-radius: 6px; }
  .pet-status { margin: 7px 1px 0; color: #8fc8f0; font-size: 11px; line-height: 1.6; }
  .pet-status.error { color: #f0b080; }
  .pet-status button { padding: 2px 7px; margin-left: 5px; border: 1px solid #3f6d99; color: #d6ecff; background: #102540; font-size: 11px; border-radius: 6px; }
  .actions { margin-top: 11px; }
  .btn { display: inline-block; padding: 9px 12px; border: 1px solid transparent; border-radius: 9px; font-size: 12px; letter-spacing: 1px; }
  .btn-primary { color: #061826; background: #bfe0ff; border-color: #bfe0ff; font-weight: bold; }
  .btn-primary:hover { background: #d9edff; }
  .btn-stamp { color: #eaf4ff; background: #355d86; border-color: #4f7ba6; }
  .btn-stamp:hover { background: #3f6c99; }
  .btn-quiet { color: #c4d9ee; background: transparent; border-color: #35547a; }
  .actions .btn { margin: 0 4px 5px 0; padding: 9px 9px; letter-spacing: 0; }
  .footnote { margin: 6px 0 0; color: #8ba3bb; font-size: 11px; line-height: 1.6; }
  .modal { position: fixed; z-index: 10; top: 0; right: 0; bottom: 0; left: 0; overflow-y: auto; background: rgba(3,9,18,.88); }
  .modal-box { width: calc(100% - 36px); max-width: 600px; margin: 24px auto; padding: 22px 26px; color: #e7f1ff; background: #12233c; border: 1px solid #2b4a6e; border-radius: 18px; box-shadow: 0 20px 65px rgba(0,0,0,.6); }
  .modal-kicker { color: #7fb6e0; font: bold 10px Consolas, monospace; letter-spacing: 3px; }
  .modal h2 { margin: 7px 0 7px; font-size: 24px; letter-spacing: 2px; }
  .modal-intro { color: #a5c0d8; font-size: 12px; line-height: 1.7; }
  .fields { margin-top: 16px; }
  .fields:after { content: ""; display: block; clear: both; }
  .field { float: left; width: 47%; vertical-align: top; margin: 0 2% 12px 0; }
  .field.goal-field { clear: both; float: none; width: 100%; margin-right: 0; }
  .field label { display: block; margin-bottom: 7px; color: #b9d2e8; font-size: 12px; }
  .field input, .field select { width: 100%; padding: 9px 10px; color: #e9f4ff; background: #0b1a2d; border: 1px solid #3a5d82; border-radius: 8px; font-size: 16px; }
  .field textarea { width: 100%; height: 62px; padding: 9px 10px; color: #e9f4ff; background: #0b1a2d; border: 1px solid #3a5d82; border-radius: 8px; font-size: 13px; font-family: "Microsoft YaHei", sans-serif; }
  .field .hint { display: block; margin-top: 5px; color: #88a2bb; font-size: 11px; }
  .week-plan { display: table; table-layout: fixed; width: 100%; margin-top: 6px; }
  .week-plan .week-cell { display: table-cell; padding-right: 4px; text-align: center; }
  .week-plan .week-cell:last-child { padding-right: 0; }
  .week-plan .week-cell label { margin-bottom: 5px; font-size: 11px; }
  .week-plan .week-cell input { padding: 7px 1px; text-align: center; font-size: 13px; }
  .plan-actions { clear: both; margin: 4px 0 8px; }
  .plan-actions .btn { margin: 0 6px 5px 0; padding: 6px 9px; letter-spacing: 0; }
  .plan-summary { line-height: 1.7; word-wrap: break-word; }
  .field input[type=range] { height: 22px; padding: 0; border: 0; background: transparent; }
  .field input[type=range]::-ms-ticks-before, .field input[type=range]::-ms-ticks-after { display: none; }
  .field input[type=range]::-ms-track { height: 4px; border-color: transparent; background: #24405f; color: transparent; }
  .field input[type=range]::-ms-fill-lower { background: #7fc4ff; }
  .field input[type=range]::-ms-fill-upper { background: #24405f; }
  .field input[type=range]::-ms-thumb { width: 13px; height: 13px; border: 1px solid #7fc4ff; border-radius: 50%; background: #d9efff; }
  #opacityValue { float: right; color: #8fd0ff; font-family: Consolas, monospace; }
  .shortcut-hint { margin: 8px 0 0; color: #88a2bb; font-size: 11px; line-height: 1.6; }
  .shortcut-hint span { white-space: nowrap; }
  .check { display: block; margin: 6px 0; color: #c6daec; font-size: 12px; }
  .check input { margin: 0 7px 0 0; vertical-align: middle; }
  .modal-actions { margin-top: 14px; }
  .modal-actions .btn { margin-right: 8px; }
  .settings-box { padding-bottom: 90px; }
  .settings-actions { position: fixed; z-index: 11; bottom: 0; left: 18px; right: 18px; max-width: 600px; margin: 0 auto; padding: 10px 26px; background: #12233c; border-top: 1px solid #2b4a6e; }
  .receipt { position: relative; margin-top: 18px; padding: 22px 24px; color: #333b4a; background: #eef4fb; border-radius: 12px; }
  .receipt-title { color: #6f8298; font: bold 10px Consolas, monospace; letter-spacing: 3px; }
  .receipt h3 { margin: 8px 0 13px; font: bold 23px SimSun, serif; }
  .receipt table { width: 100%; border-collapse: collapse; }
  .receipt td { padding: 8px 0; border-bottom: 1px solid #cfdae7; font-size: 13px; }
  .receipt td:last-child { text-align: right; font-family: Consolas, "Microsoft YaHei", monospace; }
  .seal { width: 175px; margin: 22px 0 4px auto; padding: 8px 4px; border: 3px double #2f6796; color: #2f6796; font: bold 14px SimSun, serif; letter-spacing: 2px; text-align: center; transform: rotate(-7deg); }
  .receipt-note { margin: 19px 0 0; color: #6d7b8c; font-size: 11px; line-height: 1.7; }
  .history-wrap { max-height: 360px; margin-top: 18px; overflow-y: auto; border: 1px solid #2b4a6e; border-radius: 10px; }
  .history { width: 100%; border-collapse: collapse; }
  .history th, .history td { padding: 9px 10px; border-bottom: 1px solid #24405f; text-align: right; font-size: 12px; }
  .history th { color: #91aecb; font-weight: normal; background: #16283f; }
  .history td { color: #dceaf7; font-family: Consolas, monospace; }
  .history-mode { display: block; margin-top: 2px; color: #9fbcd8; font: 10px "Microsoft YaHei", sans-serif; }
  .history th:first-child, .history td:first-child { text-align: left; }
  .history-controls { margin: 15px 0 8px; }
  .history-controls .btn { padding: 5px 10px; }
  .history-export { margin-top: 12px; text-align: right; }
  .history-export .btn { margin-left: 6px; padding: 7px 10px; }
  .history-month { display: inline-block; min-width: 110px; text-align: center; font-size: 14px; }
  .month-chart { position: relative; height: 112px; padding: 7px 2px 18px; border-bottom: 1px solid #35547a; white-space: nowrap; }
  .month-bar { display: inline-block; position: relative; width: 3.2%; height: 100%; padding: 0; border: 0; vertical-align: bottom; overflow: visible; background: transparent; }
  .month-bar:focus { outline: 1px solid #e7f1ff; }
  .month-bar-fill { position: absolute; bottom: 0; left: 15%; width: 70%; max-width: 24px; background: #4a94d0; border-radius: 4px 4px 0 0; }
  .month-bar-day { position: absolute; top: 100%; left: 0; width: 100%; color: #9fbcd8; font: 10px Consolas, monospace; }
  .manual-list { max-height: 170px; overflow-y: auto; margin: 12px 0; font-size: 12px; line-height: 1.8; }
  .manual-item { min-height: 34px; padding: 5px 0; overflow: hidden; border-bottom: 1px solid #24405f; }
  .manual-item button { float: right; padding: 4px 9px; }
  .manual-help { color: #9fbcd8; font-size: 12px; line-height: 1.6; }
  .toast { position: fixed; z-index: 20; right: 22px; bottom: 22px; max-width: 300px; padding: 14px 17px; color: #e8f3ff; background: #1b3352; border-left: 3px solid #7fc4ff; border-radius: 6px; box-shadow: 0 8px 24px rgba(0,0,0,.45); font-size: 12px; }

  /* ---------- 围裙纸主题 ---------- */
  body.theme-cream {
    color: #3b3a33;
    background: #f2ebdd;
    background-image: radial-gradient(ellipse at 84% -4%, rgba(255,255,255,.9) 0%, transparent 52%),
      radial-gradient(ellipse at 8% 108%, rgba(224,208,176,.55) 0%, transparent 55%),
      repeating-linear-gradient(0deg, rgba(120,100,70,.035) 0, rgba(120,100,70,.035) 1px, transparent 1px, transparent 6px);
  }
  body.theme-cream button:focus, body.theme-cream input:focus { outline-color: #2c6fa8; }
  body.theme-cream .avatar { border-color: #7fb0d0; background: #fffdf6; box-shadow: 0 0 12px rgba(80,130,180,.25); }
  body.theme-cream .eyebrow { color: #8a7a58; }
  body.theme-cream h1 { color: #2b2a24; text-shadow: none; }
  body.theme-cream .pin, body.theme-cream .theme { border-color: #c9bca1; background: #fffdf6; color: #4d5f6e; }
  body.theme-cream .pin:hover, body.theme-cream .pin.on, body.theme-cream .theme:hover { border-color: #2c6fa8; color: #1f4d75; }
  body.theme-cream .pin.on { background: #e8f1f9; }
  body.theme-cream .pin[disabled] { color: #a29b8b; }
  body.theme-cream .card { background: #fffdf6; border-color: #d9c9a8; box-shadow: 0 14px 28px rgba(90,70,40,.14); }
  body.theme-cream .card:before { background: repeating-radial-gradient(circle at 6px 0, rgba(190,164,116,.85) 0, rgba(190,164,116,.85) 3px, transparent 3px, transparent 12px); }
  body.theme-cream .status { color: #2f5d46; background: #eaf2e6; border-color: #b7cfae; }
  body.theme-cream .status.off { color: #857f72; background: #f0ece2; border-color: #d8d0bf; }
  body.theme-cream .status.overtime { color: #9a5330; background: #fbe9d9; border-color: #e5bfa0; }
  body.theme-cream .date { color: #8b8474; }
  body.theme-cream .privacy { border-color: #c9bda4; color: #4d5a63; }
  body.theme-cream .privacy:hover, body.theme-cream .btn-quiet:hover { border-color: #2c6fa8; color: #1f4d75; }
  body.theme-cream .pet-say { color: #586b78; background: #f6efdf; border-left-color: #2c6fa8; }
  body.theme-cream .label { color: #8a8273; }
  body.theme-cream .amount { color: #204b73; text-shadow: none; }
  body.theme-cream .amount:hover { color: #2c6fa8; }
  body.theme-cream .caption { color: #7d786b; }
  body.theme-cream .progress-head { color: #5f5a4e; }
  body.theme-cream .progress-head .right { color: #2c6fa8; }
  body.theme-cream .track { background: #e9e1cf; border-color: #d3c5a8; }
  body.theme-cream .energy.cool .fill { background: linear-gradient(90deg, #2f6fa8, #7fb9e0); }
  body.theme-cream .energy.warm .fill { background: linear-gradient(90deg, #3f8fd0, #9fd3f0); }
  body.theme-cream .energy.hot .fill { background: linear-gradient(90deg, #c98a4f, #f0be78); }
  body.theme-cream .energy.overtime .fill { background: linear-gradient(90deg, #c4613f, #e9a05a); }
  body.theme-cream .flame-outer { fill: #4a8fc4; }
  body.theme-cream .energy.warm .flame-outer { fill: #5aa8d8; }
  body.theme-cream .energy.hot .flame-outer { fill: #d69a52; }
  body.theme-cream .energy.overtime .flame-outer { fill: #c4613f; }
  body.theme-cream .flame-inner { fill: #f3faff; }
  body.theme-cream .energy.hot .flame-inner, body.theme-cream .energy.overtime .flame-inner { fill: #fff0cf; }
  body.theme-cream .progress-foot { color: #8b8476; }
  body.theme-cream .rule { background: #e2d7c0; }
  body.theme-cream .stat + .stat { border-left-color: #e2d7c0; }
  body.theme-cream .stat-label { color: #8a8273; }
  body.theme-cream .stat-value { color: #2b2a24; }
  body.theme-cream .month-amount:hover { color: #2c6fa8; }
  body.theme-cream #opacityValue { color: #2c6fa8; }
  body.theme-cream .shortcut-hint { color: #8f887a; }
  body.theme-cream .field input[type=range]::-ms-track { background: #e2d7c0; }
  body.theme-cream .field input[type=range]::-ms-fill-lower { background: #2c6fa8; }
  body.theme-cream .field input[type=range]::-ms-fill-upper { background: #e2d7c0; }
  body.theme-cream .field input[type=range]::-ms-thumb { background: #fffdf8; border-color: #2c6fa8; }
  body.theme-cream .stat-detail { color: #8f887a; }
  body.theme-cream .anchor { background: #f7f0e0; border-top-color: #e0d5bd; color: #6b5f47; border-radius: 0 0 18px 18px; }
  body.theme-cream .anchor-mark { color: #b08c4f; }
  body.theme-cream .monitor { color: #8b8476; }
  body.theme-cream .monitor.error { color: #a8622f; }
  body.theme-cream .monitor button { border-color: #b9c9d6; color: #2c5f8c; background: #f2f8fc; }
  body.theme-cream .pet-status { color: #4a7596; }
  body.theme-cream .pet-status.error { color: #a8622f; }
  body.theme-cream .pet-status button { border-color: #b9c9d6; color: #2c5f8c; background: #f2f8fc; }
  body.theme-cream .btn-primary { color: #fff; background: #2c6fa8; border-color: #2c6fa8; }
  body.theme-cream .btn-primary:hover { background: #3a82bd; }
  body.theme-cream .btn-stamp { color: #fff; background: #3f7fae; border-color: #3f7fae; }
  body.theme-cream .btn-stamp:hover { background: #4c90c0; }
  body.theme-cream .btn-quiet { color: #5a6b78; border-color: #c6bda9; }
  body.theme-cream .footnote { color: #8d8577; }
  body.theme-cream .modal { background: rgba(58,48,32,.72); }
  body.theme-cream .modal-box { color: #3b3a33; background: #fffdf6; border-color: #d8c9a8; }
  body.theme-cream .settings-actions { background: #fffdf6; border-top-color: #d8c9a8; }
  body.theme-cream .modal-kicker { color: #9a7c45; }
  body.theme-cream .modal-intro { color: #7d786b; }
  body.theme-cream .field label { color: #6f685a; }
  body.theme-cream .field input, body.theme-cream .field select { color: #2f2d27; background: #fffdf8; border-color: #d3c5a8; }
  body.theme-cream .field textarea { color: #2f2d27; background: #fffdf8; border-color: #d3c5a8; }
  body.theme-cream .field .hint { color: #8f887a; }
  body.theme-cream .check { color: #5f5a4e; }
  body.theme-cream .receipt { background: #f8f1df; color: #3a382f; }
  body.theme-cream .receipt-title { color: #8a8070; }
  body.theme-cream .receipt td { border-bottom-color: #ded2ba; }
  body.theme-cream .seal { border-color: #2f6796; color: #2f6796; }
  body.theme-cream .receipt-note { color: #7c7464; }
  body.theme-cream .history-wrap { border-color: #d8ccb2; }
  body.theme-cream .history th { color: #7d7666; background: #f1e9d8; }
  body.theme-cream .history td { color: #3b3a33; border-bottom-color: #e6dcc5; }
  body.theme-cream .history-mode { color: #777063; }
  body.theme-cream .month-chart { border-bottom-color: #d8ccb2; }
  body.theme-cream .month-bar-fill { background: #2c6fa8; }
  body.theme-cream .month-bar-day, body.theme-cream .manual-help { color: #665f53; }
  body.theme-cream .manual-item { border-bottom-color: #e6dcc5; }
  body.theme-cream .toast { color: #3b3a33; background: #fff8e8; border-left-color: #2c6fa8; box-shadow: 0 8px 24px rgba(90,70,40,.2); }

  /* 海雾玻璃：窗口由系统合成半透明，文字保持高对比度。 */
  body.theme-glass { color: #eaf9ff; background: #18303b;
    background-image: radial-gradient(ellipse at 85% 0%, rgba(130,220,225,.18), transparent 58%),
      repeating-linear-gradient(0deg, rgba(215,250,255,.025) 0, rgba(215,250,255,.025) 1px, transparent 1px, transparent 7px); }
  body.theme-glass .card { background: #264650; border-color: #85b5bb; box-shadow: 0 14px 32px rgba(0,15,21,.3); }
  body.theme-glass .card:before { background: repeating-radial-gradient(circle at 6px 0, rgba(196,246,246,.7) 0, rgba(196,246,246,.7) 3px, transparent 3px, transparent 12px); }
  body.theme-glass .pet-say, body.theme-glass .anchor { background: #1d3943; color: #d6f2f1; }
  body.theme-glass .anchor { border-top-color: #628d94; }
  body.theme-glass .status { background: #315f69; border-color: #80b5bb; color: #f1ffff; }
  body.theme-glass .status.off { background: #31494f; border-color: #739398; }
  body.theme-glass .status.overtime { background: #684c39; border-color: #bf956e; }
  body.theme-glass .track { background: #152d34; border-color: #658c90; }
  body.theme-glass .rule { background: #628d94; }
  body.theme-glass .stat + .stat { border-left-color: #628d94; }
  body.theme-glass .date, body.theme-glass .caption, body.theme-glass .progress-foot,
  body.theme-glass .stat-detail, body.theme-glass .monitor, body.theme-glass .footnote { color: #d3eae9; }
  body.theme-glass .pin, body.theme-glass .theme { background: #254852; border-color: #7aa4a9; color: #f0ffff; }
  body.theme-glass .btn-quiet { border-color: #789da2; color: #e5faf8; }
  body.theme-glass .modal-box, body.theme-glass .settings-actions { background: #203b46; border-color: #668e94; }
  body.theme-glass .field input, body.theme-glass .field select, body.theme-glass .field textarea { background: #152e37; border-color: #73999d; }
  body.theme-glass .month-bar-fill { background: #82c7cf; }
  body.theme-glass .history th { background: #284953; }
  body.theme-glass .toast { background: #284d57; border-left-color: #b9eded; }
  body.theme-glass .month-amount:hover { color: #f2ffff; }
  body.theme-glass #opacityValue { color: #b9eded; }
  body.theme-glass .shortcut-hint { color: #a9c9cd; }
  body.theme-glass .field input[type=range]::-ms-track { background: #152e37; }
  body.theme-glass .field input[type=range]::-ms-fill-lower { background: #82c7cf; }
  body.theme-glass .field input[type=range]::-ms-fill-upper { background: #152e37; }
  body.theme-glass .field input[type=range]::-ms-thumb { background: #d9f6f5; border-color: #82c7cf; }
</style>
</head>
<body>
<div class="shell">
  <div class="top">
    <img class="avatar" src="assets/whale-face.png" alt="">
    <div class="eyebrow">WORK ENCOURAGER / TIME BANK</div>
    <h1>工时银行</h1>
    <button class="theme" id="btnTheme" type="button" title="选择界面风格" aria-haspopup="true" aria-expanded="false">换肤</button>
    <button class="pin" id="btnPin" type="button" aria-pressed="false" title="将窗口固定在其他普通窗口前面">置顶窗口</button>
    <div class="theme-menu hidden" id="themeMenu" role="menu">
      <button type="button" class="theme-item" id="themePickDeep" role="menuitemradio">深海蓝</button>
      <button type="button" class="theme-item" id="themePickCream" role="menuitemradio">围裙纸</button>
      <button type="button" class="theme-item" id="themePickGlass" role="menuitemradio">海雾玻璃</button>
    </div>
  </div>

  <div class="card" id="bankCard">
    <div class="card-top">
      <span class="status off" id="status">未设置</span><span class="date" id="dateText"></span>
      <button class="privacy" id="btnPrivacy" type="button">显示金额</button>
    </div>
    <div class="pet-say" id="petSay">小鲸陪着你。设置好月薪和班表，我们就开始。</div>
    <div class="label">今 日 投 入</div>
    <button class="amount" id="todayAmount" type="button" aria-pressed="true" aria-label="今日投入已隐藏，点击显示金额">¥ ****</button>
    <div class="caption" id="todayCaption">先设置到手月薪和计划工时</div>

    <div class="progress-head"><span>今日活跃工时</span><span class="right" id="progressText">0.00 / 8.00 小时 · 0%</span></div>
    <div class="energy cool paused" id="energyMeter">
      <div class="track"><div class="fill" id="progressFill"></div></div>
      <svg class="flame-icon" viewBox="0 0 24 30" aria-hidden="true"><path class="flame-outer" d="M13 1 C14 7 18 9 19 14 C21 21 18 28 12 29 C6 28 3 24 4 18 C4 14 7 11 9 9 C9 13 11 14 12 14 C13 10 12 6 13 1 Z"/><path class="flame-inner" d="M13 15 C16 18 17 21 16 24 C15 27 10 28 8 25 C6 22 8 19 10 17 C10 20 12 20 13 15 Z"/></svg>
    </div>
    <div class="progress-foot"><span id="activeText">已记录 00:00:00</span><span class="right" id="endText">计划下班 --:--</span></div>

    <div class="rule"></div>
    <div class="stat">
      <div class="stat-label">本月累计投入</div>
      <button class="stat-value month-amount" id="monthAmount" type="button" aria-pressed="true" aria-label="本月累计投入已隐藏，点击显示金额">¥ ****</button>
      <div class="stat-detail" id="monthDetail">仅计算实际记录的日期</div>
    </div>
    <div class="stat">
      <div class="stat-label">本月加班累计</div>
      <div class="stat-value" id="monthOvertime">00:00:00</div>
      <div class="stat-detail" id="leaveDetail">折合 0.0 个标准日</div>
    </div>
    <div class="anchor"><span class="anchor-mark">/</span><span id="anchorText">每一次认真投入，都值得被看见。</span></div>
  </div>

  <div class="monitor" id="monitorText">仅在开启记录且程序运行时统计；2 分钟内有键鼠操作视为活跃。</div>
  <div class="pet-status hidden" id="petStatus"><span id="petStatusText"></span><button id="btnPetRetry" type="button">重试桌宠</button></div>
  <div class="actions">
    <button class="btn btn-primary" id="btnTrack" type="button">开始记录</button>
    <button class="btn btn-stamp" id="btnSign" type="button">今日收工 · 签章</button>
    <button class="btn btn-quiet" id="btnSettings" type="button">设置班表</button>
    <button class="btn btn-quiet" id="btnHistory" type="button">查看记录</button>
    <button class="btn btn-quiet" id="btnManual" type="button">手动补记</button>
  </div>
  <p class="footnote">活跃时长不等于在岗时长；开会、看纸质资料等无键鼠操作的时间可能不计入。<br>加班只记录时长，不增加金额；调休天数仅为折算，实际安排以单位制度为准。</p>
</div>

<div class="modal hidden" id="settingsModal">
  <div class="modal-box settings-box">
    <div class="modal-kicker">SETTINGS / 工时账本</div>
    <h2>设置月薪与班表</h2>
    <div class="modal-intro">修改设置只重算今天，此前日期保留各自口径。</div>
    <div class="fields">
      <div class="field goal-field"><label for="inOpacity">窗口透明度 <span id="opacityValue">100%</span></label><input id="inOpacity" type="range" min="60" max="100" step="1" value="100"><span class="hint">调整当前主题；60% 更透，100% 不透明；三款主题分别记住自己的透明度。</span></div>
      <div class="field"><label for="inSalary">到手月薪（元）</label><input id="inSalary" type="password" autocomplete="off"><span class="hint">扣除五险一金和个税后的金额</span></div>
      <div class="field"><label for="inCalculationMode">核算方式</label><select id="inCalculationMode"><option value="hours">月薪 ÷ 月计划工时</option><option value="days">月薪 ÷ 本月计薪天数</option></select><span class="hint">切换会重算当天；历史日期保持原口径。</span></div>
      <div class="field" id="monthHoursField"><label for="inMonthHours">月计划工时（小时）</label><input id="inMonthHours" type="text" value="174"><span class="hint">默认 174，可按实际班表调整</span></div>
      <div class="field" id="dayHoursField"><label for="inDayHours">日计划工时（小时）</label><input id="inDayHours" type="text" value="8"><span class="hint">超过这一时长才记为加班</span></div>
      <div class="field goal-field hidden" id="dayModeFields">
        <div class="fields">
          <div class="field"><label for="inPaidDays"><span id="paidMonthLabel">本月</span>计薪天数</label><input id="inPaidDays" type="text" autocomplete="off"><span class="hint">可填小数，例如 21.75；当月必填。</span></div>
          <div class="field"><label for="inNextPaidDays"><span id="nextPaidMonthLabel">下月</span>计薪天数</label><input id="inNextPaidDays" type="text" autocomplete="off"><span class="hint">可提前填写；留空则下月提示设置。</span></div>
        </div>
        <label>每周计划工时（小时）</label>
        <div class="week-plan">
          <span class="week-cell"><label for="week1">周一</label><input id="week1" type="text"></span><span class="week-cell"><label for="week2">周二</label><input id="week2" type="text"></span><span class="week-cell"><label for="week3">周三</label><input id="week3" type="text"></span><span class="week-cell"><label for="week4">周四</label><input id="week4" type="text"></span><span class="week-cell"><label for="week5">周五</label><input id="week5" type="text"></span><span class="week-cell"><label for="week6">周六</label><input id="week6" type="text"></span><span class="week-cell"><label for="week0">周日</label><input id="week0" type="text"></span>
        </div>
        <span class="hint">0 为休息日：当日投入为 0，记录的活跃时间全记加班；补班可单独调整。</span>
        <div class="fields">
          <div class="field"><label for="inOverrideDate">单日例外日期</label><input id="inOverrideDate" type="text" placeholder="YYYY-MM-DD"></div>
          <div class="field"><label for="inOverrideHours">该日计划工时</label><input id="inOverrideHours" type="text" placeholder="0–24 小时"></div>
        </div>
        <div class="plan-actions"><button class="btn btn-quiet" type="button" id="btnSetOverride">添加 / 更新例外</button><button class="btn btn-quiet" type="button" id="btnClearOverride">恢复周模板</button></div>
        <span class="hint plan-summary" id="overrideSummary">暂无单日例外。</span>
        <span class="hint">短班仍按完整日参考金额封顶；修改当天计划会重算今天，历史不变。</span>
      </div>
      <div class="field goal-field"><label for="inEndTime">计划下班时间</label><input id="inEndTime" type="text" value="18:00"><span class="hint">例如 18:00；只影响状态和倒计时</span></div>
      <div class="field goal-field"><label for="inGoals">自定义目标（可选）</label><textarea id="inGoals" rows="4" placeholder="一杯冰美式=19&#10;一份正经午饭=45&#10;一天房租=266.67"></textarea><span class="hint">每行「名称=金额」（名称≤12字），至少 3 项生效；留空用内置。</span><span class="hint" id="goalValidation" aria-live="polite"></span></div>
      <div class="field goal-field"><label for="inMiniMode">桌宠简要信息卡</label><select id="inMiniMode"><option value="always">收起卡片时常显</option><option value="hover">仅悬停桌宠时显示</option><option value="off">关闭</option></select><span class="hint">小卡上可一键切换常显/悬停；关闭时从小鲸右键菜单恢复。</span></div>
      <div class="field"><label for="inLockMode">Windows 锁屏时</label><select id="inLockMode"><option value="off">不自动暂停</option><option value="manual">暂停，解锁后手动继续</option><option value="auto">暂停，解锁后自动继续</option></select><span class="hint">需要小鲸的系统会话监测保持连接；监测不可用时停止记录。</span></div>
      <div class="field"><label for="inMaskTimeout">显示金额后自动打码</label><select id="inMaskTimeout"><option value="0">关闭</option><option value="30">30 秒</option><option value="60">60 秒</option></select></div>
      <div class="field"><label for="inRestReminder">休息提醒</label><select id="inRestReminder"><option value="0">关闭</option><option value="45">累计活跃 45 分钟</option><option value="60">累计活跃 60 分钟</option><option value="90">累计活跃 90 分钟</option></select><span class="hint">只累计程序已记录的活跃时长；暂停或空闲时不增长。</span></div>
    </div>
    <label class="check"><input id="inAutoLaunch" type="checkbox">登录 Windows 后启动程序（默认关闭；不代表自动开始记录）</label>
    <label class="check"><input id="showSalary" type="checkbox">在此处显示输入的月薪</label>
    <label class="check"><input id="inMask" type="checkbox" checked>每次打开时默认隐藏金额</label>
    <label class="check"><input id="inAnnounce" type="checkbox" checked>记录时在整点显示提醒</label>
    <label class="check"><input id="inMotion" type="checkbox" checked>启用火焰与小鲸动画</label>
    <label class="check"><input id="inAutoStart" type="checkbox">打开程序后自动开始记录（不补算关闭期间）</label>
    <div class="shortcut-hint">快捷键：<span>Esc 关闭弹窗</span> · <span>Alt+M 隐藏/显示金额</span> · <span>Alt+T 开始/暂停记录</span> · <span>Alt+S 设置</span> · <span>Alt+H 收起卡片（需桌宠运行）</span> · <span>Alt+R 稍后提醒 15 分钟</span></div>
    <div class="modal-actions settings-actions"><button class="btn btn-primary" id="btnSaveSettings" type="button">保存设置</button><button class="btn btn-quiet" id="btnCancelSettings" type="button">取消</button></div>
  </div>
</div>

<div class="modal hidden" id="receiptModal">
  <div class="modal-box">
    <div class="modal-kicker">DAILY RECORD / 今日工单</div>
    <h2>今天，辛苦了。</h2>
    <div class="modal-intro">已暂停记录。需要继续工作时，可随时再次开始。</div>
    <div class="receipt">
      <div class="receipt-title">TIME BANK / DAILY SLIP</div>
      <h3>今日投入记录</h3>
      <table>
        <tr><td>日期</td><td id="receiptDate">--</td></tr>
        <tr><td>活跃工时</td><td id="receiptActive">--</td></tr>
        <tr><td>其中加班</td><td id="receiptOvertime">--</td></tr>
        <tr><td>折合投入</td><td id="receiptAmount">--</td></tr>
        <tr><td>本月累计</td><td id="receiptMonth">--</td></tr>
      </table>
      <div class="seal">已复核 · 准予下班</div>
      <p class="receipt-note" id="receiptNote">人已下班，未完的事明天再说。记录只保存在本机。</p>
    </div>
    <div class="modal-actions"><button class="btn btn-primary" id="btnCloseReceipt" type="button">收好工单</button></div>
  </div>
</div>

<div class="modal hidden" id="historyModal">
  <div class="modal-box">
    <div class="modal-kicker">LOCAL RECORDS / 本机记录</div>
    <h2>每天都算数</h2>
    <div class="modal-intro">柱条只显示键鼠活跃工时；补记单独列示，不计入投入和加班。</div>
    <div class="history-controls"><button class="btn btn-quiet" id="btnPrevMonth" type="button">上月</button><span class="history-month" id="historyMonth"></span><button class="btn btn-quiet" id="btnNextMonth" type="button">下月</button></div>
    <div class="manual-help" id="historyScale">每日活跃工时（小时） · 悬停或聚焦柱条可查看详情</div>
    <div class="month-chart" id="monthChart" role="group" aria-label="每日活跃工时"></div>
    <div class="history-wrap"><table class="history"><thead><tr><th>日期</th><th>活跃工时</th><th>补记</th><th>加班</th><th>投入</th></tr></thead><tbody id="historyBody"></tbody></table></div>
    <div class="history-export"><button class="btn btn-quiet" id="btnBackup" type="button">备份完整 JSON</button><button class="btn btn-quiet" id="btnExportCsv" type="button">导出本机 CSV</button></div>
    <div class="modal-actions"><button class="btn btn-primary" id="btnCloseHistory" type="button">关闭</button></div>
  </div>
</div>

<div class="modal hidden" id="manualModal">
  <div class="modal-box">
    <div class="modal-kicker">MANUAL NOTES / 手动补记</div>
    <h2>补记一段时间</h2>
    <div class="modal-intro">会议、阅读等时间可单独备注；不计入活跃工时、金额或加班。</div>
    <div class="fields">
      <div class="field"><label for="manualDate">日期</label><input id="manualDate" type="text" placeholder="YYYY-MM-DD"></div>
      <div class="field"><label for="manualMinutes">时长（分钟）</label><input id="manualMinutes" type="text" placeholder="例如 30"></div>
      <div class="field goal-field"><label for="manualKind">类型</label><select id="manualKind"><option value="会议">会议</option><option value="阅读资料">阅读资料</option><option value="其他">其他</option></select></div>
    </div>
    <div class="manual-help" id="manualSummary"></div>
    <div class="manual-list" id="manualList"></div>
    <div class="modal-actions"><button class="btn btn-primary" id="btnSaveManual" type="button">保存补记</button><button class="btn btn-quiet" id="btnCloseManual" type="button">关闭</button></div>
  </div>
</div>
<div class="toast hidden" id="toast"></div>

<script id="bank-core" type="text/javascript">
/* 纯计算逻辑：时间以毫秒或秒为单位，金额不提前四舍五入。 */
function bankDayAmount(day) {
  return Math.min(day.activeSeconds / 3600, day.dayHours) * day.hourlyRate;
}
function bankOvertime(day) {
  return Math.max(0, day.activeSeconds - day.dayHours * 3600);
}
function bankMonth(days, month) {
  var result = { amount: 0, activeSeconds: 0, overtimeSeconds: 0, days: 0 };
  for (var key in days) {
    if (Object.prototype.hasOwnProperty.call(days, key) && key.substring(0, 7) === month) {
      result.amount += bankDayAmount(days[key]);
      result.activeSeconds += days[key].activeSeconds;
      result.overtimeSeconds += bankOvertime(days[key]);
      if (days[key].activeSeconds > 0 || (!days[key].manualOnly && (!days[key].manualEntries || !days[key].manualEntries.length))) result.days++;
    }
  }
  return result;
}
function bankReminderProgress(currentSeconds, addedSeconds, intervalMinutes) {
  if (!(intervalMinutes > 0) || !(addedSeconds > 0)) return { seconds: 0, notify: false };
  var interval = intervalMinutes * 60, total = Math.max(0, currentSeconds) + addedSeconds;
  return total >= interval ? { seconds: total % interval, notify: true } : { seconds: total, notify: false };
}
function bankReminderSnoozeProgress(remainingSeconds, addedSeconds) {
  return Math.max(0, Math.max(0, remainingSeconds) - Math.max(0, addedSeconds));
}
function bankActiveRanges(start, end, previousInput, latestInput, limit) {
  var candidates = [], result = [], inputs = [previousInput, latestInput];
  if (!(end > start)) return result;
  for (var i = 0; i < inputs.length; i++) {
    if (typeof inputs[i] !== "number" || !isFinite(inputs[i])) continue;
    var a = Math.max(start, inputs[i]);
    var b = Math.min(end, inputs[i] + limit);
    if (b > a) candidates.push({ start: a, end: b });
  }
  candidates.sort(function (a, b) { return a.start - b.start; });
  for (var j = 0; j < candidates.length; j++) {
    var last = result.length ? result[result.length - 1] : null;
    if (last && candidates[j].start <= last.end) last.end = Math.max(last.end, candidates[j].end);
    else result.push(candidates[j]);
  }
  return result;
}
function bankDate(ms) {
  var d = new Date(ms);
  var m = d.getMonth() + 1, day = d.getDate();
  return d.getFullYear() + "-" + (m < 10 ? "0" : "") + m + "-" + (day < 10 ? "0" : "") + day;
}
function bankSplitByDay(start, end) {
  var parts = [];
  while (start < end) {
    var d = new Date(start);
    var next = new Date(d.getFullYear(), d.getMonth(), d.getDate() + 1).getTime();
    if (!(next > start)) break;
    var until = Math.min(end, next);
    parts.push({ date: bankDate(start), start: start, end: until });
    start = until;
  }
  return parts;
}
function bankManualMinutes(day) {
  var entries = day && day.manualEntries ? day.manualEntries : [], total = 0;
  for (var i = 0; i < entries.length; i++) total += entries[i].minutes;
  return total;
}
function bankValidDate(value) {
  var match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(value);
  if (!match || Number(match[1]) < 1900) return false;
  var date = new Date(Number(match[1]), Number(match[2]) - 1, Number(match[3]));
  return bankDate(date.getTime()) === value;
}
function bankValidMonth(value) {
  return /^(?:19\d{2}|[2-9]\d{3})-(?:0[1-9]|1[0-2])$/.test(value);
}
function bankValidPaidDays(value) {
  return typeof value === "number" && isFinite(value) && value >= 0.01 && value <= 31;
}
function bankValidPlanHours(value) {
  return typeof value === "number" && isFinite(value) && value >= 0 && value <= 24 && (value === 0 || value >= 0.01);
}
function bankCalcMode(settings) {
  return settings && settings.calculationMode === "days" ? "days" : "hours";
}
function bankPaidDays(settings, month) {
  var days = settings && settings.paidDaysByMonth;
